Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Для Каждого СтрокаПроводки Из Проводки Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроводки.СчетДт) Или Не ЗначениеЗаполнено(СтрокаПроводки.СчетКт) Тогда
			Сообщить("Не указаны счета проводки, строка " + СтрокаПроводки.НомерСтроки);
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Движение = Движения.Хозрасчетный.Добавить();
		Движение.СчетДт = СтрокаПроводки.СчетДт;
		Движение.СчетКт = СтрокаПроводки.СчетКт;
		Движение.Склад = ?(ЗначениеЗаполнено(СтрокаПроводки.СкладДт), СтрокаПроводки.СкладДт, СтрокаПроводки.СкладКт);
		Движение.Номенклатура = ?(ЗначениеЗаполнено(СтрокаПроводки.НоменклатураДт), СтрокаПроводки.НоменклатураДт, СтрокаПроводки.НоменклатураКт);
		Движение.Количество = ?(СтрокаПроводки.КоличествоДт <> 0, СтрокаПроводки.КоличествоДт, СтрокаПроводки.КоличествоКт);
		Движение.Сумма = СтрокаПроводки.Сумма;
		Движение.Период = Дата;
	КонецЦикла;
	Движения.Хозрасчетный.Записывать = Истина;
КонецПроцедуры
