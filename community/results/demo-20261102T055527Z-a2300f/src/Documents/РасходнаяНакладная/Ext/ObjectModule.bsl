Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Потребности = УчетЗапасов.ТаблицаПотребностей();
	Потребности.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Для Каждого Товар Из СписокНоменклатуры Цикл
		Если Товар.Количество <= 0 Тогда
			Сообщить("Количество должно быть положительным, строка " + Товар.НомерСтроки);
			Отказ = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Товар.Подразделение) Тогда
			СтрокаПотребности = Потребности.Добавить();
			СтрокаПотребности.Подразделение = Товар.Подразделение;
			СтрокаПотребности.Номенклатура = Товар.Номенклатура;
			СтрокаПотребности.Свойство = Справочники.СвойстваНоменклатуры.ПустаяСсылка();
			СтрокаПотребности.Количество = Товар.Количество;
			СтрокаПотребности.Стоимость = 0;
			СтрокаПотребности.НомерСтроки = Товар.НомерСтроки;
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда Возврат; КонецЕсли;
	УчетЗапасов.Списать(ЭтотОбъект, Потребности, Отказ);
	Если Отказ Тогда Возврат; КонецЕсли;
	Для Каждого Потребность Из Потребности Цикл
		Товар = СписокНоменклатуры[Потребность.НомерСтроки - 1];
		ЗаписатьПродажу(Товар.Номенклатура, Товар.Номенклатура, Товар.Количество, Товар.Сумма,
			Потребность.Стоимость, Перечисления.ВидыУчета.Оперативный);
	КонецЦикла;
	Если ЗначениеЗаполнено(Склад) Тогда
		ПровестиБухгалтерию(Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьПродажу(Заказано, Продано, Количество, Выручка, Себестоимость, ВидУчета)
	Движение = Движения.Продажи.Добавить();
	Движение.Период = Дата;
	Движение.Номенклатура = Заказано;
	Движение.Продано = Продано;
	Движение.ВидУчета = ВидУчета;
	Движение.Количество = Количество;
	Движение.Выручка = Выручка;
	Движение.Себестоимость = Себестоимость;
	Движения.Продажи.Записывать = Истина;
КонецПроцедуры

Процедура ПровестиБухгалтерию(Отказ)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрБухгалтерии.Хозрасчетный");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Движения.Хозрасчетный.Записать();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Остатки.Склад КАК Склад, Остатки.Номенклатура КАК Номенклатура,
	| Остатки.КоличествоОстатокДт КАК Количество,
	| Остатки.СуммаОстатокДт КАК Стоимость
	|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент) КАК Остатки
	|ГДЕ Остатки.Счет = &Счет";
	Запрос.УстановитьПараметр("Момент", МоментВремени());
	Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
	Остатки = Запрос.Выполнить().Выгрузить();
	Запрос.Текст =
	"ВЫБРАТЬ Аналоги.Номенклатура КАК Номенклатура, Аналоги.Аналог КАК Аналог
	|ИЗ РегистрСведений.АналогиНоменклатуры КАК Аналоги";
	Связи = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ Номенклатура.Ссылка КАК Ссылка, Номенклатура.Артикул КАК Артикул
	|ИЗ Справочник.Номенклатура КАК Номенклатура";
	Артикулы = Запрос.Выполнить().Выгрузить();
	Для Каждого Товар Из СписокНоменклатуры Цикл
		Кандидаты = Новый ТаблицаЗначений;
		Кандидаты.Колонки.Добавить("Ссылка");
		Кандидаты.Колонки.Добавить("Артикул");
		Кандидаты.Колонки.Добавить("Основной");
		ЭлементКандидата = Кандидаты.Добавить();
		ЭлементКандидата.Ссылка = Товар.Номенклатура;
		ЭлементКандидата.Основной = 0;
		Индекс = 0;
		Пока Индекс < Кандидаты.Количество() Цикл
			Текущий = Кандидаты[Индекс].Ссылка;
			Для Каждого Связь Из Связи Цикл
				Следующий = Неопределено;
				Если Связь.Номенклатура = Текущий Тогда
					Следующий = Связь.Аналог;
				ИначеЕсли Связь.Аналог = Текущий Тогда
					Следующий = Связь.Номенклатура;
				КонецЕсли;
				Если Следующий <> Неопределено И Кандидаты.Найти(Следующий, "Ссылка") = Неопределено Тогда
					ЭлементКандидата = Кандидаты.Добавить();
					ЭлементКандидата.Ссылка = Следующий;
					ЭлементКандидата.Основной = 1;
					ДанныеАртикула = Артикулы.Найти(Следующий, "Ссылка");
					Если ДанныеАртикула <> Неопределено Тогда ЭлементКандидата.Артикул = ДанныеАртикула.Артикул; КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Индекс = Индекс + 1;
		КонецЦикла;
		Кандидаты.Сортировать("Основной, Артикул");
		Осталось = Товар.Количество;
		ОсталосьВыручки = Товар.Сумма;
		Для Каждого Кандидат Из Кандидаты Цикл
			Отбор = Новый Структура("Склад,Номенклатура", Склад, Кандидат.Ссылка);
			СтрокиОстатка = Остатки.НайтиСтроки(Отбор);
			Если СтрокиОстатка.Количество() = 0 Тогда Продолжить; КонецЕсли;
			ОстатокНаСкладе = СтрокиОстатка[0];
			Если ОстатокНаСкладе.Количество <= 0 Тогда Продолжить; КонецЕсли;
			ВсегоКоличество = 0;
			ВсегоСтоимость = 0;
			Для Каждого Остаток Из Остатки.НайтиСтроки(Новый Структура("Номенклатура", Кандидат.Ссылка)) Цикл
				ВсегоКоличество = ВсегоКоличество + Остаток.Количество;
				ВсегоСтоимость = ВсегоСтоимость + Остаток.Стоимость;
			КонецЦикла;
			Если ВсегоКоличество <= 0 Тогда Продолжить; КонецЕсли;
			Количество = Мин(Осталось, ОстатокНаСкладе.Количество);
			Себестоимость = ?(Количество = ВсегоКоличество, ВсегоСтоимость, Окр(ВсегоСтоимость * Количество / ВсегоКоличество, 2));
			Выручка = ?(Количество = Осталось, ОсталосьВыручки, Окр(Товар.Сумма * Количество / Товар.Количество, 2));
			ОстатокНаСкладе.Количество = ОстатокНаСкладе.Количество - Количество;
			ОстатокНаСкладе.Стоимость = ОстатокНаСкладе.Стоимость - Себестоимость;
			Осталось = Осталось - Количество;
			ОсталосьВыручки = ОсталосьВыручки - Выручка;
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период = Дата;
			Проводка.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
			Проводка.СчетКт = ПланыСчетов.Управленческий.Товары;
			Проводка.Склад = Склад;
			Проводка.Номенклатура = Кандидат.Ссылка;
			Проводка.Количество = Количество;
			Проводка.Сумма = Себестоимость;
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период = Дата;
			Проводка.СчетДт = ПланыСчетов.Управленческий.Покупатели;
			Проводка.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
			Проводка.Сумма = Выручка;
			ЗаписатьПродажу(Товар.Номенклатура, Кандидат.Ссылка, Количество, Выручка, Себестоимость, Перечисления.ВидыУчета.Бухгалтерский);
			Если Осталось <= 0 Тогда Прервать; КонецЕсли;
		КонецЦикла;
		Если Осталось > 0 Тогда
			Отказ = Истина;
			Сообщить("Недостаточно товара и его аналогов: " + Строка(Товар.Номенклатура) + ", строка " + Товар.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	Движения.Хозрасчетный.Записывать = Истина;
КонецПроцедуры
