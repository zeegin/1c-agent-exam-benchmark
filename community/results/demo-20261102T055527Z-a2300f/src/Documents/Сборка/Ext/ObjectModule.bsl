Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Потребности = УчетЗапасов.ТаблицаПотребностей();
	Потребности.Колонки.Добавить("НомерИзделия", Новый ОписаниеТипов("Число"));
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Спецификация.Изделие КАК Изделие,
	| Спецификация.Деталь КАК Деталь,
	| Спецификация.Свойство КАК Свойство,
	| Спецификация.Количество КАК Количество
	|ИЗ РегистрСведений.Спецификации.СрезПоследних(&Дата, ) КАК Спецификация
	|ГДЕ Спецификация.Количество > 0";
	Запрос.УстановитьПараметр("Дата", Дата);
	Спецификация = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаИзделия Из Изделия Цикл
		Если СтрокаИзделия.Количество <= 0 Тогда
			Отказ = Истина;
			Сообщить("Количество изделия должно быть положительным");
			Продолжить;
		КонецЕсли;
		СтрокиСпецификации = Спецификация.НайтиСтроки(Новый Структура("Изделие", СтрокаИзделия.Номенклатура));
		Если СтрокиСпецификации.Количество() = 0 Тогда
			Отказ = Истина;
			Сообщить("Нет спецификации для " + Строка(СтрокаИзделия.Номенклатура));
		КонецЕсли;
		Для Каждого СтрокаСпецификации Из СтрокиСпецификации Цикл
			Потребность = Потребности.Добавить();
			Потребность.Подразделение = ПодразделениеОтправитель;
			Потребность.Номенклатура = СтрокаСпецификации.Деталь;
			Потребность.Свойство = СтрокаСпецификации.Свойство;
			Потребность.Количество = СтрокаСпецификации.Количество * СтрокаИзделия.Количество;
			Потребность.Стоимость = 0;
			Потребность.НомерИзделия = СтрокаИзделия.НомерСтроки;
		КонецЦикла;
	КонецЦикла;
	Для Каждого СтрокаДетали Из ДополнительныеДетали Цикл
		Потребность = Потребности.Добавить();
		Потребность.Подразделение = ПодразделениеОтправитель;
		Потребность.Номенклатура = СтрокаДетали.Номенклатура;
		Потребность.Свойство = СтрокаДетали.Свойство;
		Потребность.Количество = СтрокаДетали.Количество;
		Потребность.Стоимость = 0;
		Потребность.НомерИзделия = 0;
	КонецЦикла;
	Если Отказ Тогда Возврат; КонецЕсли;
	УчетЗапасов.Списать(ЭтотОбъект, Потребности, Отказ);
	Если Отказ Тогда Возврат; КонецЕсли;
	ВсегоИзделий = 0;
	Для Каждого СтрокаИзделия Из Изделия Цикл
		ВсегоИзделий = ВсегоИзделий + СтрокаИзделия.Количество;
	КонецЦикла;
	Если ВсегоИзделий = 0 Тогда
		Отказ = Истина;
		Сообщить("Не указаны собираемые изделия");
		Возврат;
	КонецЕсли;
	ДопСтоимость = 0;
	Для Каждого Потребность Из Потребности Цикл
		Если Потребность.НомерИзделия = 0 Тогда ДопСтоимость = ДопСтоимость + Потребность.Стоимость; КонецЕсли;
	КонецЦикла;
	ОстатокДопСтоимости = ДопСтоимость;
	ОстатокИзделий = ВсегоИзделий;
	Для Каждого СтрокаИзделия Из Изделия Цикл
		Стоимость = 0;
		Для Каждого Потребность Из Потребности Цикл
			Если Потребность.НомерИзделия = СтрокаИзделия.НомерСтроки Тогда
				Стоимость = Стоимость + Потребность.Стоимость;
			КонецЕсли;
		КонецЦикла;
		Доля = ?(ОстатокИзделий = СтрокаИзделия.Количество, ОстатокДопСтоимости,
			Окр(ДопСтоимость * СтрокаИзделия.Количество / ВсегоИзделий, 2));
		ОстатокДопСтоимости = ОстатокДопСтоимости - Доля;
		ОстатокИзделий = ОстатокИзделий - СтрокаИзделия.Количество;
		УчетЗапасов.Приход(ЭтотОбъект, ПодразделениеПолучатель, СтрокаИзделия.Номенклатура,
			Справочники.СвойстваНоменклатуры.ПустаяСсылка(), СтрокаИзделия.Количество, Стоимость + Доля);
	КонецЦикла;
КонецПроцедуры
