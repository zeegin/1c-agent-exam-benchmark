Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Движения.Начисления.Записать();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ График.Дата КАК Дата, График.Подразделение КАК Подразделение, График.Значение КАК Часы
	|ИЗ РегистрСведений.ГрафикиРаботы КАК График";
	График = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ Начисления.Сотрудник КАК Сотрудник, Начисления.Подразделение КАК Подразделение,
	| Начисления.ВидРасчета КАК ВидРасчета, Начисления.ПериодРегистрации КАК ПериодРегистрации,
	| Начисления.ДатаНачала КАК ДатаНачала, Начисления.ДатаОкончания КАК ДатаОкончания,
	| Начисления.Результат КАК Результат, Начисления.Отработано КАК Отработано,
	| Начисления.Дни КАК Дни, Начисления.Корректировка КАК Корректировка
	|ИЗ РегистрРасчета.Начисления КАК Начисления";
	История = Запрос.Выполнить().Выгрузить();
	История.Колонки.Добавить("ТекущийДокумент", Новый ОписаниеТипов("Булево"));
	Запрос.Текст = "ВЫБРАТЬ Шкала.Стаж КАК Стаж, Шкала.Процент КАК Процент
	|ИЗ РегистрСведений.ШкалаПремий КАК Шкала УПОРЯДОЧИТЬ ПО Стаж УБЫВ";
	Шкала = Запрос.Выполнить().Выгрузить();
	СтрокиДляРасчета = ОсновныеНачисления.Выгрузить();
	СтрокиДляРасчета.Сортировать("ДатаНачала");
	Для Каждого СтрокаНачисления Из СтрокиДляРасчета Цикл
		Если Не ЗначениеЗаполнено(СтрокаНачисления.Сотрудник)
			Или Не ЗначениеЗаполнено(СтрокаНачисления.Подразделение)
			Или Не ЗначениеЗаполнено(СтрокаНачисления.ДатаНачала)
			Или СтрокаНачисления.ДатаОкончания < СтрокаНачисления.ДатаНачала Тогда
			Сообщить("Неверные данные начисления, строка " + СтрокаНачисления.НомерСтроки);
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Вид = СтрокаНачисления.ВидРасчета;
		Если Вид <> ПланыВидовРасчета.ОсновныеНачисления.Командировка
			И НачалоМесяца(СтрокаНачисления.ДатаНачала) <> НачалоМесяца(СтрокаНачисления.ДатаОкончания) Тогда
			Сообщить("Тариф и премия вводятся в пределах месяца");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Начало = СтрокаНачисления.ДатаНачала;
		Пока Начало <= СтрокаНачисления.ДатаОкончания Цикл
			Конец = Мин(КонецМесяца(Начало), КонецДня(СтрокаНачисления.ДатаОкончания));
			Период = НачалоМесяца(Начало);
			Работа = ВремяПоГрафику(График, История, СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение,
				Начало, Конец, Вид <> ПланыВидовРасчета.ОсновныеНачисления.Командировка);
			Результат = 0;
			Процент = 0;
			Если Вид = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
				ЗапросСтавки = Новый Запрос;
				ЗапросСтавки.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Сведения.Оклад КАК Ставка
				|ИЗ РегистрСведений.СведенияОСотрудниках.СрезПоследних(&Период, Сотрудник = &Сотрудник И Подразделение = &Подразделение) КАК Сведения";
				ЗапросСтавки.УстановитьПараметр("Период", Период);
				ЗапросСтавки.УстановитьПараметр("Сотрудник", СтрокаНачисления.Сотрудник);
				ЗапросСтавки.УстановитьПараметр("Подразделение", СтрокаНачисления.Подразделение);
				Выборка = ЗапросСтавки.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда Результат = Окр(Выборка.Ставка * Работа.Часы, 2); КонецЕсли;
			ИначеЕсли Вид = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
				ДатаСтажа = СтрокаНачисления.Сотрудник.ДатаНачалаСтажа;
				ЛетСтажа = 0;
				Если ЗначениеЗаполнено(ДатаСтажа) Тогда
					ЛетСтажа = Год(Период) - Год(ДатаСтажа);
					Если ДобавитьМесяц(ДатаСтажа, ЛетСтажа * 12) > Период Тогда ЛетСтажа = ЛетСтажа - 1; КонецЕсли;
				КонецЕсли;
				Для Каждого ШагШкалы Из Шкала Цикл
					Если ЛетСтажа >= ШагШкалы.Стаж Тогда Процент = ШагШкалы.Процент; Прервать; КонецЕсли;
				КонецЦикла;
				База = 0;
				Предыдущий = ДобавитьМесяц(Период, -1);
				Для Каждого Запись Из История Цикл
					Если НачалоМесяца(Запись.ДатаНачала) = Предыдущий И Запись.Подразделение = СтрокаНачисления.Подразделение
						И Запись.Сотрудник <> СтрокаНачисления.Сотрудник И Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
						База = База + Запись.Результат;
					КонецЕсли;
				КонецЦикла;
				Норма = ВремяПоГрафику(График, История, СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение, НачалоМесяца(Начало), КонецМесяца(Начало), Ложь);
				Если Норма.Дни > 0 Тогда Результат = Окр(База * Процент / 100 * Работа.Дни / Норма.Дни, 2); КонецЕсли;
			ИначеЕсли Вид = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
				СуммаБазы = 0;
				ДниБазы = 0;
				Для Каждого Запись Из История Цикл
					Если Запись.Сотрудник = СтрокаНачисления.Сотрудник И НачалоМесяца(Запись.ДатаНачала) >= ДобавитьМесяц(Период, -3)
						И НачалоМесяца(Запись.ДатаНачала) < Период Тогда
						СуммаБазы = СуммаБазы + Запись.Результат;
						Если Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда ДниБазы = ДниБазы + Запись.Дни; КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если ДниБазы > 0 Тогда Результат = Окр(СуммаБазы / ДниБазы * Работа.Дни, 2); КонецЕсли;
			Иначе
				Отказ = Истина;
				Сообщить("Неизвестный вид расчета");
			КонецЕсли;
			Если Вид = ПланыВидовРасчета.ОсновныеНачисления.Командировка И Период < НачалоМесяца(Дата) Тогда
				Для Каждого Прежнее Из История Цикл
					Если Прежнее.Сотрудник <> СтрокаНачисления.Сотрудник
						Или Прежнее.Подразделение <> СтрокаНачисления.Подразделение
						Или Прежнее.Корректировка Или Прежнее.ТекущийДокумент
						Или (Прежнее.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф
							И Прежнее.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия)
						Или Прежнее.ДатаНачала > Конец Или Прежнее.ДатаОкончания < Начало Тогда Продолжить; КонецЕсли;
					НачалоПересечения = Макс(Начало, Прежнее.ДатаНачала);
					КонецПересечения = Мин(Конец, Прежнее.ДатаОкончания);
					Вытеснено = ВремяДоКомандировки(График, История, Прежнее.Сотрудник, Прежнее.Подразделение, НачалоПересечения, КонецПересечения);
					Числитель = ?(Прежнее.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф, Вытеснено.Часы, Вытеснено.Дни);
					Знаменатель = ?(Прежнее.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф, Прежнее.Отработано, Прежнее.Дни);
					Если Знаменатель <= 0 Или Числитель <= 0 Тогда Продолжить; КонецЕсли;
					Сторно = Движения.Начисления.Добавить();
					Сторно.ПериодРегистрации = НачалоМесяца(Дата);
					Сторно.ПериодДействияНачало = НачалоПересечения;
					Сторно.ПериодДействияКонец = КонецДня(КонецПересечения);
					Сторно.ВидРасчета = Прежнее.ВидРасчета;
					Сторно.Сотрудник = Прежнее.Сотрудник;
					Сторно.Подразделение = Прежнее.Подразделение;
					Сторно.ДатаНачала = НачалоПересечения;
					Сторно.ДатаОкончания = КонецПересечения;
					Сторно.Результат = -Окр(Прежнее.Результат * Числитель / Знаменатель, 2);
					Сторно.Дни = -Вытеснено.Дни;
					Сторно.Отработано = -Вытеснено.Часы;
					Сторно.Корректировка = Истина;
					Сторно.Сторно = Истина;
				КонецЦикла;
			КонецЕсли;
			Движение = Движения.Начисления.Добавить();
			Движение.ПериодРегистрации = Период;
			Движение.ВидРасчета = Вид;
			Движение.ПериодДействияНачало = Начало;
			Движение.ПериодДействияКонец = Конец;
			Если Вид = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
				Движение.БазовыйПериодНачало = ДобавитьМесяц(Период, -1);
				Движение.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(Период, -1));
			ИначеЕсли Вид = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
				Движение.БазовыйПериодНачало = ДобавитьМесяц(Период, -3);
				Движение.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(Период, -1));
			КонецЕсли;
			Движение.Сотрудник = СтрокаНачисления.Сотрудник;
			Движение.Подразделение = СтрокаНачисления.Подразделение;
			Движение.ДатаНачала = Начало;
			Движение.ДатаОкончания = Конец;
			Движение.Результат = Результат;
			Движение.Процент = Процент;
			Движение.Отработано = Работа.Часы;
			Движение.Дни = Работа.Дни;
			ДобавленнаяИстория = История.Добавить();
			ДобавленнаяИстория.Сотрудник = СтрокаНачисления.Сотрудник;
			ДобавленнаяИстория.Подразделение = СтрокаНачисления.Подразделение;
			ДобавленнаяИстория.ВидРасчета = Вид;
			ДобавленнаяИстория.ПериодРегистрации = Период;
			ДобавленнаяИстория.ДатаНачала = Начало;
			ДобавленнаяИстория.ДатаОкончания = Конец;
			ДобавленнаяИстория.Результат = Результат;
			ДобавленнаяИстория.Отработано = Работа.Часы;
			ДобавленнаяИстория.Дни = Работа.Дни;
			ДобавленнаяИстория.Корректировка = Ложь;
			ДобавленнаяИстория.ТекущийДокумент = Истина;
			Начало = НачалоМесяца(ДобавитьМесяц(Период, 1));
		КонецЦикла;
	КонецЦикла;
	Движения.Начисления.Записывать = Истина;
КонецПроцедуры

Функция ВремяПоГрафику(График, История, Сотрудник, Подразделение, Начало, Конец, ИсключатьКомандировки)
	Результат = Новый Структура("Часы,Дни", 0, 0);
	Для Каждого ДеньГрафика Из График Цикл
		Если ДеньГрафика.Подразделение <> Подразделение Или ДеньГрафика.Дата < Начало Или ДеньГрафика.Дата > Конец
			Или ДеньГрафика.Часы <= 0 Тогда Продолжить; КонецЕсли;
		ВКомандировке = Ложь;
		Если ИсключатьКомандировки Тогда
			Для Каждого Запись Из История Цикл
				Если Запись.Сотрудник = Сотрудник И Запись.Подразделение = Подразделение
					И Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка
					И ДеньГрафика.Дата >= Запись.ДатаНачала И ДеньГрафика.Дата <= Запись.ДатаОкончания Тогда
					ВКомандировке = Истина; Прервать;
				КонецЕсли;
			КонецЦикла;
			Для Каждого СтрокаКомандировки Из ОсновныеНачисления Цикл
				Если СтрокаКомандировки.Сотрудник = Сотрудник И СтрокаКомандировки.Подразделение = Подразделение
					И СтрокаКомандировки.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка
					И ДеньГрафика.Дата >= СтрокаКомандировки.ДатаНачала И ДеньГрафика.Дата <= СтрокаКомандировки.ДатаОкончания Тогда
					ВКомандировке = Истина; Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Не ВКомандировке Тогда
			Результат.Часы = Результат.Часы + ДеньГрафика.Часы;
			Результат.Дни = Результат.Дни + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВремяДоКомандировки(График, История, Сотрудник, Подразделение, Начало, Конец)
	Результат = Новый Структура("Часы,Дни", 0, 0);
	Для Каждого ДеньГрафика Из График Цикл
		Если ДеньГрафика.Подразделение <> Подразделение Или ДеньГрафика.Дата < Начало
			Или ДеньГрафика.Дата > Конец Или ДеньГрафика.Часы <= 0 Тогда Продолжить; КонецЕсли;
		УжеВКомандировке = Ложь;
		Для Каждого Запись Из История Цикл
			Если Запись.Сотрудник = Сотрудник И Запись.Подразделение = Подразделение
				И Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка
				И ДеньГрафика.Дата >= Запись.ДатаНачала И ДеньГрафика.Дата <= Запись.ДатаОкончания Тогда
				УжеВКомандировке = Истина; Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не УжеВКомандировке Тогда
			Результат.Часы = Результат.Часы + ДеньГрафика.Часы;
			Результат.Дни = Результат.Дни + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
