Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		Если СтрокаТовара.Количество <= 0 Тогда
			Сообщить("Количество должно быть положительным, строка " + СтрокаТовара.НомерСтроки);
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Подразделение) Тогда
			УчетЗапасов.Приход(ЭтотОбъект, Подразделение, СтрокаТовара.Номенклатура,
				СтрокаТовара.Свойство, СтрокаТовара.Количество, СтрокаТовара.Сумма);
		КонецЕсли;
		Если ЗначениеЗаполнено(Склад) Тогда
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период = Дата;
			Проводка.СчетДт = ПланыСчетов.Управленческий.Товары;
			Проводка.СчетКт = ПланыСчетов.Управленческий.Поставщики;
			Проводка.Склад = Склад;
			Проводка.Номенклатура = СтрокаТовара.Номенклатура;
			Проводка.Количество = СтрокаТовара.Количество;
			Проводка.Сумма = СтрокаТовара.Сумма;
			Движения.Хозрасчетный.Записывать = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
