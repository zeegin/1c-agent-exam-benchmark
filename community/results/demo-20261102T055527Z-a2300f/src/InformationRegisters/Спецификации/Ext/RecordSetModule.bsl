Процедура ПередЗаписью(Отказ, Замещение)
	Если Количество() = 0 Тогда Возврат; КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Для Каждого СтрокаСпецификации Из ЭтотОбъект Цикл
		Элемент = Блокировка.Добавить("РегистрСведений.Спецификации");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Изделие", СтрокаСпецификации.Изделие);
	КонецЦикла;
	Блокировка.Заблокировать();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Спецификации.Период КАК Период
	|ИЗ РегистрСведений.Спецификации КАК Спецификации
	|ГДЕ Спецификации.Изделие = &Изделие И Спецификации.Период >= &Начало
	| И Спецификации.Период < &Конец И Спецификации.Период <> &Период";
	Для Каждого СтрокаСпецификации Из ЭтотОбъект Цикл
		НачалоНеделиЗаписи = НачалоНедели(СтрокаСпецификации.Период);
		Для Каждого ДругаяСтрока Из ЭтотОбъект Цикл
			Если ДругаяСтрока.Изделие = СтрокаСпецификации.Изделие
				И НачалоНедели(ДругаяСтрока.Период) = НачалоНеделиЗаписи
				И ДругаяСтрока.Период <> СтрокаСпецификации.Период Тогда
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		Запрос.УстановитьПараметр("Изделие", СтрокаСпецификации.Изделие);
		Запрос.УстановитьПараметр("Начало", НачалоНеделиЗаписи);
		Запрос.УстановитьПараметр("Конец", НачалоНеделиЗаписи + 7 * 24 * 60 * 60);
		Запрос.УстановитьПараметр("Период", СтрокаСпецификации.Период);
		Если Не Запрос.Выполнить().Пустой() Тогда Отказ = Истина; КонецЕсли;
		Если Отказ Тогда
			Сообщить("Спецификация изделия может изменяться только один раз в календарную неделю: " + Строка(СтрокаСпецификации.Изделие));
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
