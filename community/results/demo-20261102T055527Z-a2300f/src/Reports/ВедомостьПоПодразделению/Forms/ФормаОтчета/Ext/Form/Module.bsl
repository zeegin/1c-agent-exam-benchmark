&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода = КонецМесяца(НачалоПериода);
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Данные = Отчеты.ВедомостьПоПодразделению.СформироватьДанные(НачалоДня(НачалоПериода), КонецДня(КонецПериода), Подразделение);
	ЗначениеВРеквизитФормы(Данные, "Результат");
КонецПроцедуры
