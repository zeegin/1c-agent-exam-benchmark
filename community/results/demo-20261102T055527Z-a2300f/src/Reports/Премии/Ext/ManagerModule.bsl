Функция СформироватьДанные(НачалоПериода, КонецПериода) Экспорт
	Если НачалоМесяца(НачалоПериода) <> НачалоМесяца(КонецПериода) Тогда
		ВызватьИсключение "Отчет формируется за один календарный месяц";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Начисления.Сотрудник КАК Сотрудник,
	| Начисления.Сотрудник.ДатаНачалаСтажа КАК ДатаНачалаСтажа,
	| Начисления.Процент КАК Процент, СУММА(Начисления.Результат) КАК Сумма
	|ИЗ РегистрРасчета.Начисления КАК Начисления
	|ГДЕ Начисления.ДатаНачала >= &Период И Начисления.ДатаНачала < ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, 1) И Начисления.ВидРасчета = &Вид
	|СГРУППИРОВАТЬ ПО Начисления.Сотрудник, Начисления.Сотрудник.ДатаНачалаСтажа, Начисления.Процент";
	Запрос.УстановитьПараметр("Период", НачалоМесяца(НачалоПериода));
	Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Премия);
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("Стаж");
	Для Каждого СтрокаРезультата Из Результат Цикл
		СтрокаРезультата.Стаж = 0;
		Если ЗначениеЗаполнено(СтрокаРезультата.ДатаНачалаСтажа) Тогда
			Стаж = Год(НачалоПериода) - Год(СтрокаРезультата.ДатаНачалаСтажа);
			Если ДобавитьМесяц(СтрокаРезультата.ДатаНачалаСтажа, Стаж * 12) > НачалоПериода Тогда Стаж = Стаж - 1; КонецЕсли;
			СтрокаРезультата.Стаж = Стаж;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
