Функция СформироватьДанные(НачалоПериода, КонецПериода) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Продажи.Номенклатура КАК Номенклатура, Продажи.Продано КАК Продано,
	| СУММА(Продажи.КоличествоОборот) КАК Количество,
	| СУММА(Продажи.СебестоимостьОборот) КАК Себестоимость,
	| СУММА(Продажи.ВыручкаОборот) КАК Выручка,
	| СУММА(Продажи.ВыручкаОборот - Продажи.СебестоимостьОборот) КАК Прибыль
	|ИЗ РегистрНакопления.Продажи.Обороты(&Начало, &Конец, , ВидУчета = &ВидУчета) КАК Продажи
	|СГРУППИРОВАТЬ ПО Продажи.Номенклатура, Продажи.Продано";
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Запрос.УстановитьПараметр("Конец", КонецПериода);
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.Бухгалтерский);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
