#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
	ОбновитьДополнительныеПоляНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьДополнительныеПоляНаСервере()
	СохранитьДополнительныеПоля();
	ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Для Каждого ОписаниеПоля Из СписокДопПолей Цикл
		СтрокаЗначения = Неопределено;
		Для Каждого СтрокаСведения Из ТекущийОбъект.ДополнительныеСведения Цикл
			Если СтрокаСведения.ВидСведения = ОписаниеПоля.ВидСведения Тогда
				СтрокаЗначения = СтрокаСведения;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаЗначения = Неопределено Тогда
			СтрокаЗначения = ТекущийОбъект.ДополнительныеСведения.Добавить();
			СтрокаЗначения.ВидСведения = ОписаниеПоля.ВидСведения;
		КонецЕсли;
		СтрокаЗначения.Значение = ЭтотОбъект[ОписаниеПоля.ИмяПоля];
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьДополнительныеПоля()
	Для Каждого ОписаниеПоля Из СписокДопПолей Цикл
		СтрокаЗначения = Неопределено;
		Для Каждого СтрокаСведения Из Объект.ДополнительныеСведения Цикл
			Если СтрокаСведения.ВидСведения = ОписаниеПоля.ВидСведения Тогда
				СтрокаЗначения = СтрокаСведения; Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаЗначения = Неопределено Тогда
			СтрокаЗначения = Объект.ДополнительныеСведения.Добавить();
			СтрокаЗначения.ВидСведения = ОписаниеПоля.ВидСведения;
		КонецЕсли;
		СтрокаЗначения.Значение = ЭтотОбъект[ОписаниеПоля.ИмяПоля];
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()
	Удаляемые = Новый Массив;
	Для Каждого ОписаниеПоля Из СписокДопПолей Цикл
		Если Элементы.Найти(ОписаниеПоля.ИмяПоля) <> Неопределено Тогда
			Элементы.Удалить(Элементы[ОписаниеПоля.ИмяПоля]);
		КонецЕсли;
		Удаляемые.Добавить(ОписаниеПоля.ИмяПоля);
	КонецЦикла;
	Если Удаляемые.Количество() > 0 Тогда ИзменитьРеквизиты(, Удаляемые); КонецЕсли;
	СписокДопПолей.Очистить();
	Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
	МенеджерОбъект = Объект.Менеджер.ПолучитьОбъект();
	Добавляемые = Новый Массив;
	Номер = 0;
	Для Каждого СтрокаСписка Из МенеджерОбъект.ДополнительныеСведения Цикл
		Если Не ЗначениеЗаполнено(СтрокаСписка.ВидСведения) Тогда Продолжить; КонецЕсли;
		Номер = Номер + 1;
		Имя = "ДопСведение" + Формат(Номер, "ЧГ=0");
		Описание = СписокДопПолей.Добавить();
		Описание.ИмяПоля = Имя;
		Описание.ВидСведения = СтрокаСписка.ВидСведения;
		Добавляемые.Добавить(Новый РеквизитФормы(Имя, СтрокаСписка.ВидСведения.ТипЗначения));
	КонецЦикла;
	Если Добавляемые.Количество() = 0 Тогда Возврат; КонецЕсли;
	ИзменитьРеквизиты(Добавляемые);
	Для Каждого ОписаниеПоля Из СписокДопПолей Цикл
		Поле = Элементы.Добавить(ОписаниеПоля.ИмяПоля, Тип("ПолеФормы"), Элементы.ДопПоля);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = ОписаниеПоля.ИмяПоля;
		Поле.Заголовок = Строка(ОписаниеПоля.ВидСведения);
		Для Каждого СтрокаСведения Из Объект.ДополнительныеСведения Цикл
			Если СтрокаСведения.ВидСведения = ОписаниеПоля.ВидСведения Тогда
				ЭтотОбъект[ОписаниеПоля.ИмяПоля] = СтрокаСведения.Значение; Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
