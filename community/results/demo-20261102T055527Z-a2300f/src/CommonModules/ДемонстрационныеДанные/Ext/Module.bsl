Процедура Заполнить() Экспорт
	Подразделение = Справочники.Подразделения.НайтиПоНаименованию("Учебный цех");
	Если Подразделение.Пустая() Тогда
		Объект = Справочники.Подразделения.СоздатьЭлемент();
		Объект.Наименование = "Учебный цех"; Объект.Записать(); Подразделение = Объект.Ссылка;
	КонецЕсли;
	Склад = Справочники.Склады.НайтиПоНаименованию("Учебный склад");
	Если Склад.Пустая() Тогда
		Объект = Справочники.Склады.СоздатьЭлемент();
		Объект.Наименование = "Учебный склад"; Объект.Записать(); Склад = Объект.Ссылка;
	КонецЕсли;
	Деталь = СоздатьНоменклатуру("Учебная деталь", "DEMO-01");
	Изделие = СоздатьНоменклатуру("Учебный блок", "DEMO-02");
	Свойство = Справочники.СвойстваНоменклатуры.НайтиПоНаименованию("Учебное свойство");
	Если Свойство.Пустая() Тогда
		Объект = Справочники.СвойстваНоменклатуры.СоздатьЭлемент();
		Объект.Наименование = "Учебное свойство"; Объект.Записать(); Свойство = Объект.Ссылка;
	КонецЕсли;
	Запись = РегистрыСведений.ПолитикиПодразделений.СоздатьМенеджерЗаписи();
	Запись.Период = Дата(2020, 1, 1); Запись.Подразделение = Подразделение;
	Запись.Способ = Перечисления.УчетнаяПолитика.ФИФО; Запись.Записать();
	Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
	Запись.Период = Дата(2020, 1, 1); Запись.Изделие = Изделие; Запись.Деталь = Деталь;
	Запись.Свойство = Свойство; Запись.Количество = 2; Запись.Записать();
	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2020, 1, 5, 12, 0, 0); Приход.Подразделение = Подразделение; Приход.Склад = Склад;
	Строка = Приход.СписокНоменклатуры.Добавить();
	Строка.Номенклатура = Деталь; Строка.Свойство = Свойство; Строка.Количество = 20; Строка.Цена = 100; Строка.Сумма = 2000;
	Приход.Записать(РежимЗаписиДокумента.Проведение);
	Сборка = Документы.Сборка.СоздатьДокумент();
	Сборка.Дата = Дата(2020, 1, 6, 12, 0, 0); Сборка.ПодразделениеОтправитель = Подразделение;
	Сборка.ПодразделениеПолучатель = Подразделение;
	Строка = Сборка.Изделия.Добавить(); Строка.Номенклатура = Изделие; Строка.Количество = 2;
	Сборка.Записать(РежимЗаписиДокумента.Проведение);
	ПродажаБлока = Документы.РасходнаяНакладная.СоздатьДокумент();
	ПродажаБлока.Дата = Дата(2020, 1, 7, 10, 0, 0);
	Строка = ПродажаБлока.СписокНоменклатуры.Добавить();
	Строка.Подразделение = Подразделение; Строка.Номенклатура = Изделие;
	Строка.Количество = 1; Строка.Цена = 350; Строка.Сумма = 350;
	ПродажаБлока.Записать(РежимЗаписиДокумента.Проведение);
	Операция = Документы.Операция.СоздатьДокумент();
	Операция.Дата = Дата(2020, 1, 7, 11, 0, 0);
	Проводка = Операция.Проводки.Добавить();
	Проводка.СчетДт = ПланыСчетов.Управленческий.Касса;
	Проводка.СчетКт = ПланыСчетов.Управленческий.Поставщики;
	Проводка.Сумма = 10;
	Операция.Записать(РежимЗаписиДокумента.Проведение);
	Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
	Продажа.Дата = Дата(2020, 1, 7, 12, 0, 0); Продажа.Склад = Склад;
	Строка = Продажа.СписокНоменклатуры.Добавить(); Строка.Номенклатура = Деталь;
	Строка.Количество = 1; Строка.Цена = 150; Строка.Сумма = 150;
	Продажа.Записать(РежимЗаписиДокумента.Проведение);
	Сотрудник = Справочники.ФизическиеЛица.НайтиПоНаименованию("Учебный сотрудник");
	Если Сотрудник.Пустая() Тогда
		Объект = Справочники.ФизическиеЛица.СоздатьЭлемент(); Объект.Наименование = "Учебный сотрудник";
		Объект.ДатаНачалаСтажа = Дата(2018, 1, 1); Объект.Записать(); Сотрудник = Объект.Ссылка;
	КонецЕсли;
	ВидСведения = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Учебный регион");
	Если ВидСведения.Пустая() Тогда
		Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
		Вид.Наименование = "Учебный регион";
		Вид.ТипЗначения = Новый ОписаниеТипов("Строка");
		Вид.Записать();
		ВидСведения = Вид.Ссылка;
	КонецЕсли;
	Запись = РегистрыСведений.ЗначенияСвойствНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Свойство = Свойство; Запись.Характеристика = ВидСведения; Запись.Значение = "Учебный"; Запись.Записать();
	ОбъектСотрудника = Сотрудник.ПолучитьОбъект();
	Если ОбъектСотрудника.ДополнительныеСведения.Найти(ВидСведения, "ВидСведения") = Неопределено Тогда
		СтрокаСведения = ОбъектСотрудника.ДополнительныеСведения.Добавить();
		СтрокаСведения.ВидСведения = ВидСведения;
		ОбъектСотрудника.Записать();
	КонецЕсли;
	Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Учебный контрагент");
	Если Контрагент.Пустая() Тогда
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
		Объект.Наименование = "Учебный контрагент"; Объект.Менеджер = Сотрудник;
		СтрокаСведения = Объект.ДополнительныеСведения.Добавить();
		СтрокаСведения.ВидСведения = ВидСведения; СтрокаСведения.Значение = "Москва";
		Объект.Записать();
	КонецЕсли;
	Для День = 1 По 31 Цикл
		Запись = РегистрыСведений.ГрафикиРаботы.СоздатьМенеджерЗаписи();
		Запись.Дата = Дата(2020, 1, День); Запись.Подразделение = Подразделение;
		Запись.Значение = 8; Запись.Записать();
	КонецЦикла;
	Запись = РегистрыСведений.СведенияОСотрудниках.СоздатьМенеджерЗаписи();
	Запись.Период = Дата(2020, 1, 1); Запись.Сотрудник = Сотрудник; Запись.Подразделение = Подразделение;
	Запись.Оклад = 100; Запись.Записать();
	Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
	Запись.Стаж = 0; Запись.Процент = 5; Запись.Записать();
	Зарплата = Документы.НачислениеЗарплаты.СоздатьДокумент(); Зарплата.Дата = Дата(2020, 1, 31, 12, 0, 0);
	Строка = Зарплата.ОсновныеНачисления.Добавить(); Строка.Сотрудник = Сотрудник; Строка.Подразделение = Подразделение;
	Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	Строка.ДатаНачала = Дата(2020, 1, 1); Строка.ДатаОкончания = Дата(2020, 1, 31);
	Зарплата.Записать(РежимЗаписиДокумента.Проведение);
	Руководитель = Справочники.ФизическиеЛица.НайтиПоНаименованию("Учебный руководитель");
	Если Руководитель.Пустая() Тогда
		Объект = Справочники.ФизическиеЛица.СоздатьЭлемент();
		Объект.Наименование = "Учебный руководитель"; Объект.ДатаНачалаСтажа = Дата(2018, 1, 1);
		Объект.Записать(); Руководитель = Объект.Ссылка;
	КонецЕсли;
	Запись = РегистрыСведений.ГрафикиРаботы.СоздатьМенеджерЗаписи();
	Запись.Дата = Дата(2020, 2, 10); Запись.Подразделение = Подразделение; Запись.Значение = 8; Запись.Записать();
	Премия = Документы.НачислениеЗарплаты.СоздатьДокумент(); Премия.Дата = Дата(2020, 2, 29, 12, 0, 0);
	Строка = Премия.ОсновныеНачисления.Добавить(); Строка.Сотрудник = Руководитель; Строка.Подразделение = Подразделение;
	Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия;
	Строка.ДатаНачала = Дата(2020, 2, 1); Строка.ДатаОкончания = Дата(2020, 2, 29);
	Премия.Записать(РежимЗаписиДокумента.Проведение);
	Запись = РегистрыСведений.ГрафикиРаботы.СоздатьМенеджерЗаписи();
	Запись.Дата = Дата(2020, 3, 10); Запись.Подразделение = Подразделение; Запись.Значение = 8; Запись.Записать();
	Командировка = Документы.НачислениеЗарплаты.СоздатьДокумент(); Командировка.Дата = Дата(2020, 3, 31, 12, 0, 0);
	Строка = Командировка.ОсновныеНачисления.Добавить(); Строка.Сотрудник = Сотрудник; Строка.Подразделение = Подразделение;
	Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
	Строка.ДатаНачала = Дата(2020, 3, 10); Строка.ДатаОкончания = Дата(2020, 3, 10);
	Командировка.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Функция СоздатьНоменклатуру(Наименование, Артикул)
	Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Наименование);
	Если Ссылка.Пустая() Тогда
		Элемент = Справочники.Номенклатура.СоздатьЭлемент();
		Элемент.Наименование = Наименование;
		Элемент.Артикул = Артикул;
		Элемент.Записать();
		Ссылка = Элемент.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции
