// Потребности: Подразделение, Номенклатура, Свойство, Количество, Стоимость.
Процедура Списать(ДокументОбъект, Потребности, Отказ) Экспорт
	Если Потребности.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Блокируем только сочетания аналитики, которые участвуют в списании.
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ПартииНоменклатуры");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = Потребности;
	Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
	Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	Элемент.ИспользоватьИзИсточникаДанных("Свойство", "Свойство");
	Блокировка.Заблокировать();
	ДокументОбъект.Движения.ПартииНоменклатуры.Записать();
	ДокументОбъект.Движения.ОстаткиНоменклатуры.Записать();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ Потребности.Подразделение КАК Подразделение,
	| Потребности.Номенклатура КАК Номенклатура, Потребности.Свойство КАК Свойство
	|ПОМЕСТИТЬ ВТПотребности
	|ИЗ &Потребности КАК Потребности
	|;
	|ВЫБРАТЬ
	| Партии.Подразделение КАК Подразделение,
	| Партии.Номенклатура КАК Номенклатура,
	| Партии.Свойство КАК Свойство,
	| Партии.Партия КАК Партия,
	| Партии.ДатаПартии КАК ДатаПартии,
	| Партии.КоличествоОстаток КАК Количество,
	| Партии.СтоимостьОстаток КАК Стоимость
	|ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(&Момент, ) КАК Партии
	|ГДЕ Партии.КоличествоОстаток > 0
	| И (Партии.Подразделение, Партии.Номенклатура, Партии.Свойство) В
	| (ВЫБРАТЬ Потребности.Подразделение, Потребности.Номенклатура, Потребности.Свойство ИЗ ВТПотребности КАК Потребности)";
	Запрос.УстановитьПараметр("Момент", ДокументОбъект.МоментВремени());
	Запрос.УстановитьПараметр("Потребности", Потребности);
	Партии = Запрос.Выполнить().Выгрузить();
	ЗапросПолитик = Новый Запрос;
	ЗапросПолитик.Текст = "ВЫБРАТЬ Политики.Подразделение КАК Подразделение, Политики.Способ КАК Способ
	|ИЗ РегистрСведений.ПолитикиПодразделений.СрезПоследних(&Дата, ) КАК Политики";
	ЗапросПолитик.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	Политики = ЗапросПолитик.Выполнить().Выгрузить();
	Для Каждого Потребность Из Потребности Цикл
		Если Потребность.Количество <= 0 Тогда
			Отказ = Истина;
			Сообщить("Количество должно быть положительным: " + Строка(Потребность.Номенклатура));
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Потребность.Подразделение, Потребность.Номенклатура, Потребность.Свойство);
		Найденные = Партии.НайтиСтроки(Отбор);
		Всего = 0;
		ВсегоСтоимость = 0;
		Для Каждого Партия Из Найденные Цикл
			Всего = Всего + Партия.Количество;
			ВсегоСтоимость = ВсегоСтоимость + Партия.Стоимость;
		КонецЦикла;
		Если Всего < Потребность.Количество Тогда
			Отказ = Истина;
			Сообщить("Недостаточно остатков: " + Строка(Потребность.Номенклатура) + ", подразделение " + Строка(Потребность.Подразделение));
			Продолжить;
		КонецЕсли;
		СтрокиПолитики = Политики.НайтиСтроки(Новый Структура("Подразделение", Потребность.Подразделение));
		Способ = Перечисления.УчетнаяПолитика.Средняя;
		Если СтрокиПолитики.Количество() > 0 Тогда
			Способ = СтрокиПолитики[0].Способ;
		КонецЕсли;
		Если Способ = Перечисления.УчетнаяПолитика.ЛИФО Тогда
			Партии.Сортировать("ДатаПартии Убыв, Партия Убыв");
		Иначе
			Партии.Сортировать("ДатаПартии Возр, Партия Возр");
		КонецЕсли;
		Найденные = Партии.НайтиСтроки(Отбор);
		Осталось = Потребность.Количество;
		ОсталосьСтоимость = ?(Потребность.Количество = Всего, ВсегоСтоимость, Окр(ВсегоСтоимость * Потребность.Количество / Всего, 2));
		Для Индекс = 0 По Найденные.Количество() - 1 Цикл
			Партия = Найденные[Индекс];
			Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
			Если Способ = Перечисления.УчетнаяПолитика.Средняя Тогда
				Если Индекс = Найденные.Количество() - 1 Тогда
					Количество = Осталось;
					Стоимость = ОсталосьСтоимость;
				Иначе
					Количество = Мин(Осталось, Окр(Потребность.Количество * Партия.Количество / Всего, 2));
					Стоимость = Мин(ОсталосьСтоимость, Окр(Партия.Стоимость * Потребность.Количество / Всего, 2));
				КонецЕсли;
			Иначе
				Количество = Мин(Осталось, Партия.Количество);
				Стоимость = ?(Количество = Партия.Количество, Партия.Стоимость, Окр(Партия.Стоимость * Количество / Партия.Количество, 2));
			КонецЕсли;
			Если Количество <= 0 Тогда Продолжить; КонецЕсли;
			Движение = ДокументОбъект.Движения.ПартииНоменклатуры.ДобавитьРасход();
			Движение.Период = ДокументОбъект.Дата;
			Движение.Подразделение = Партия.Подразделение;
			Движение.Номенклатура = Партия.Номенклатура;
			Движение.Свойство = Партия.Свойство;
			Движение.Партия = Партия.Партия;
			Движение.ДатаПартии = Партия.ДатаПартии;
			Движение.Количество = Количество;
			Движение.Стоимость = Стоимость;
			Партия.Количество = Партия.Количество - Количество;
			Партия.Стоимость = Партия.Стоимость - Стоимость;
			Осталось = Осталось - Количество;
			ОсталосьСтоимость = ОсталосьСтоимость - Стоимость;
			Потребность.Стоимость = Потребность.Стоимость + Стоимость;
			Если Осталось <= 0 Тогда Прервать; КонецЕсли;
		КонецЦикла;
		Движение = ДокументОбъект.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
		Движение.Период = ДокументОбъект.Дата;
		Движение.Подразделение = Потребность.Подразделение;
		Движение.Номенклатура = Потребность.Номенклатура;
		Движение.Свойство = Потребность.Свойство;
		Движение.Количество = Потребность.Количество;
		Движение.Стоимость = Потребность.Стоимость;
	КонецЦикла;
	ДокументОбъект.Движения.ПартииНоменклатуры.Записывать = Истина;
	ДокументОбъект.Движения.ОстаткиНоменклатуры.Записывать = Истина;
КонецПроцедуры

Функция ТаблицаПотребностей() Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	Возврат Результат;
КонецФункции

Процедура Приход(ДокументОбъект, Подразделение, Номенклатура, Свойство, Количество, Стоимость) Экспорт
	Движение = ДокументОбъект.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
	Движение.Период = ДокументОбъект.Дата;
	Движение.Подразделение = Подразделение;
	Движение.Номенклатура = Номенклатура;
	Движение.Свойство = Свойство;
	Движение.Количество = Количество;
	Движение.Стоимость = Стоимость;
	Движение = ДокументОбъект.Движения.ПартииНоменклатуры.ДобавитьПриход();
	Движение.Период = ДокументОбъект.Дата;
	Движение.Подразделение = Подразделение;
	Движение.Номенклатура = Номенклатура;
	Движение.Свойство = Свойство;
	Движение.Партия = ДокументОбъект.Ссылка;
	Движение.ДатаПартии = ДокументОбъект.Дата;
	Движение.Количество = Количество;
	Движение.Стоимость = Стоимость;
	ДокументОбъект.Движения.ОстаткиНоменклатуры.Записывать = Истина;
	ДокументОбъект.Движения.ПартииНоменклатуры.Записывать = Истина;
КонецПроцедуры
