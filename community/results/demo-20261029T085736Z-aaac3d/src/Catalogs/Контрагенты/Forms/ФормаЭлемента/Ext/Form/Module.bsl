&НаСервере
Функция ИмяПоля(Вид)
 Возврат "Доп_" + СтрЗаменить(Строка(Вид.УникальныйИдентификатор()), "-", "");
КонецФункции

&НаСервере
Процедура СохранитьПоля()
 Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
  Если Не ЗначениеЗаполнено(Стр.ВидСведения) Тогда Продолжить; КонецЕсли;
  Имя = ИмяПоля(Стр.ВидСведения);
  Если Элементы.Найти(Имя) <> Неопределено Тогда Стр.Значение = ЭтаФорма[Имя]; КонецЕсли;
 КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьПоля()
 СохранитьПоля(); УдалитьРеквизиты = Новый Массив;
 Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
  Если Не ЗначениеЗаполнено(Стр.ВидСведения) Тогда Продолжить; КонецЕсли;
  Имя = ИмяПоля(Стр.ВидСведения); Поле = Элементы.Найти(Имя);
  Если Поле <> Неопределено Тогда Элементы.Удалить(Поле); УдалитьРеквизиты.Добавить(Имя); КонецЕсли;
 КонецЦикла;
 Если УдалитьРеквизиты.Количество() > 0 Тогда ИзменитьРеквизиты(, УдалитьРеквизиты); КонецЕсли;
 Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
 МенеджерОбъект = Объект.Менеджер.ПолучитьОбъект();
 ДобавитьРеквизиты = Новый Массив; Виды = Новый Массив;
 Для Каждого СтрМенеджера Из МенеджерОбъект.ДополнительныеСведения Цикл
  Вид = СтрМенеджера.ВидСведения;
  Если Не ЗначениеЗаполнено(Вид) Или Виды.Найти(Вид) <> Неопределено Тогда Продолжить; КонецЕсли;
  Виды.Добавить(Вид); Имя = ИмяПоля(Вид);
  ДобавитьРеквизиты.Добавить(Новый РеквизитФормы(Имя, Вид.ТипЗначения, , Вид.Наименование));
 КонецЦикла;
 Если ДобавитьРеквизиты.Количество() = 0 Тогда Возврат; КонецЕсли;
 ИзменитьРеквизиты(ДобавитьРеквизиты);
 Для Каждого Вид Из Виды Цикл
  Имя = ИмяПоля(Вид); Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элементы.Менеджер.Родитель);
  Поле.Вид = ВидПоляФормы.ПолеВвода; Поле.ПутьКДанным = Имя; Поле.Заголовок = Вид.Наименование;
  Найдено = Неопределено;
  Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
   Если Стр.ВидСведения = Вид Тогда Найдено = Стр; Прервать; КонецЕсли;
  КонецЦикла;
  Если Найдено = Неопределено Тогда Найдено = Объект.ДополнительныеСведения.Добавить(); Найдено.ВидСведения = Вид; КонецЕсли;
  ЭтаФорма[Имя] = Найдено.Значение;
 КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
 ПостроитьПоля();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
 ПостроитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
 ПостроитьПоля();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
 СохранитьПоля();
 // Основной объект уже сформирован платформой к моменту события.
 ТекущийОбъект.ДополнительныеСведения.Очистить();
 Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
  Новая = ТекущийОбъект.ДополнительныеСведения.Добавить(); Новая.ВидСведения = Стр.ВидСведения; Новая.Значение = Стр.Значение;
 КонецЦикла;
КонецПроцедуры
