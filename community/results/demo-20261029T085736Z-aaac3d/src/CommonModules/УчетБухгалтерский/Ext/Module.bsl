Процедура Заблокировать() Экспорт
 Блокировка = Новый БлокировкаДанных;
 Элемент = Блокировка.Добавить("РегистрБухгалтерии.Хозрасчетный");
 Элемент.Режим = РежимБлокировкиДанных.Исключительный;
 Элемент = Блокировка.Добавить("РегистрСведений.Аналоги"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
 Элемент = Блокировка.Добавить("Справочник.Номенклатура"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
 Блокировка.Заблокировать();
КонецПроцедуры

Процедура Подготовить(Док, УжеЗаблокировано = Ложь) Экспорт
 Если Не УжеЗаблокировано Тогда Заблокировать(); КонецЕсли;
 Док.Движения.Хозрасчетный.Записывать = Истина;
 Док.Движения.Хозрасчетный.Очистить();
 Док.Движения.Хозрасчетный.Записать();
КонецПроцедуры

Процедура Приход(Док, Строка, Сумма) Экспорт
 Движение = Док.Движения.Хозрасчетный.Добавить();
 Движение.Период = Док.Дата; Движение.СчетДт = ПланыСчетов.Управленческий.Товары;
 Движение.СчетКт = ПланыСчетов.Управленческий.Поставщики;
 Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.Номенклатура;
 Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Док.Склад;
 Движение.КоличествоДт = Строка.Количество; Движение.Сумма = Сумма;
КонецПроцедуры

Функция Остатки(Док, Товары) Экспорт
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ
 | ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
 | ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады) КАК Склад,
 | Остатки.КоличествоОстатокДт КАК Количество,
 | ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК Стоимость
 |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, &ВидыСубконто, Субконто1 В (&Товары)) КАК Остатки";
 Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склад);
 Запрос.УстановитьПараметр("Момент", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая));
 Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары); Запрос.УстановитьПараметр("ВидыСубконто", Виды);
 Запрос.УстановитьПараметр("Товары", Товары);
 Остатки = Запрос.Выполнить().Выгрузить();
 // Денежный ресурс учитывается по номенклатуре без аналитики склада.
 Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
 Запрос.Текст = "ВЫБРАТЬ ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
 | Остатки.СуммаОстатокДт КАК Стоимость
 |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, &ВидыСубконто, Субконто1 В (&Товары)) КАК Остатки";
 Запрос.УстановитьПараметр("ВидыСубконто", Виды);
 Для Каждого Сумма Из Запрос.Выполнить().Выгрузить() Цикл
  Строки = Остатки.НайтиСтроки(Новый Структура("Номенклатура", Сумма.Номенклатура));
  Если Строки.Количество() > 0 Тогда Строки[0].Стоимость = Сумма.Стоимость; КонецЕсли;
 КонецЦикла;
 Возврат Остатки;
КонецФункции

Функция СвязиАналогов() Экспорт
 Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, Аналог ИЗ РегистрСведений.Аналоги");
 Результат = Новый Соответствие;
 Для Каждого Связь Из Запрос.Выполнить().Выгрузить() Цикл
  Если Результат.Получить(Связь.Номенклатура) = Неопределено Тогда Результат.Вставить(Связь.Номенклатура, Новый Массив); КонецЕсли;
  Если Результат.Получить(Связь.Аналог) = Неопределено Тогда Результат.Вставить(Связь.Аналог, Новый Массив); КонецЕсли;
  Результат.Получить(Связь.Номенклатура).Добавить(Связь.Аналог);
  Результат.Получить(Связь.Аналог).Добавить(Связь.Номенклатура);
 КонецЦикла;
 Возврат Результат;
КонецФункции

Функция Артикулы(Товары) Экспорт
 Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Артикул ИЗ Справочник.Номенклатура ГДЕ Ссылка В (&Товары)"); Запрос.УстановитьПараметр("Товары", Товары);
 Результат = Новый Соответствие;
 Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл Результат.Вставить(Стр.Ссылка, Стр.Артикул); КонецЦикла;
 Возврат Результат;
КонецФункции

Функция ГруппаАналогов(Товар, Связи)
 Найденные = Новый Массив; Найденные.Добавить(Товар); Индекс = 0;
 Пока Индекс < Найденные.Количество() Цикл
  Текущий = Найденные[Индекс]; Индекс = Индекс + 1;
  Соседи = Связи.Получить(Текущий); Если Соседи = Неопределено Тогда Продолжить; КонецЕсли;
  Для Каждого Другой Из Соседи Цикл
   Если Найденные.Найти(Другой) = Неопределено Тогда Найденные.Добавить(Другой); КонецЕсли;
  КонецЦикла;
 КонецЦикла;
 Возврат Найденные;
КонецФункции

Функция ТоварыДляПродажи(Строки, Связи) Экспорт
 Результат = Новый Массив;
 Для Каждого Строка Из Строки Цикл
  Для Каждого Товар Из ГруппаАналогов(Строка.Номенклатура, Связи) Цикл
   Если Результат.Найти(Товар) = Неопределено Тогда Результат.Добавить(Товар); КонецЕсли;
  КонецЦикла;
 КонецЦикла;
 Возврат Результат;
КонецФункции

Функция Кандидаты(Товар, Связи, Артикулы)
 Найденные = ГруппаАналогов(Товар, Связи);
 Результат = Новый ТаблицаЗначений; Результат.Колонки.Добавить("Номенклатура"); Результат.Колонки.Добавить("Артикул");
 Для Каждого Другой Из Найденные Цикл
  Если Другой <> Товар Тогда Стр = Результат.Добавить(); Стр.Номенклатура = Другой; Стр.Артикул = Артикулы.Получить(Другой); КонецЕсли;
 КонецЦикла;
 Результат.Сортировать("Артикул, Номенклатура");
 Стр = Результат.Вставить(0); Стр.Номенклатура = Товар;
 Возврат Результат;
КонецФункции

Процедура Продать(Док, Строка, Остатки, Связи, Артикулы, Отказ) Экспорт
 Если Строка.Количество <= 0 Тогда Отказ = Истина; Сообщить("Количество должно быть положительным"); Возврат; КонецЕсли;
 КандидатыПродажи = Кандидаты(Строка.Номенклатура, Связи, Артикулы);
 Доступно = 0;
 Для Каждого Кандидат Из КандидатыПродажи Цикл
  Для Каждого О Из Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Кандидат.Номенклатура, Док.Склад)) Цикл Доступно = Доступно + О.Количество; КонецЦикла;
 КонецЦикла;
 Если Доступно < Строка.Количество Тогда Отказ = Истина; Сообщить("Недостаточно товара и аналогов: " + Строка.Номенклатура); Возврат; КонецЕсли;
 Осталось = Строка.Количество; ВыручкаОстаток = Строка.Сумма;
 Если ВыручкаОстаток = 0 Тогда ВыручкаОстаток = Строка.Цена * Строка.Количество; КонецЕсли;
 Для Каждого Кандидат Из КандидатыПродажи Цикл
  Если Осталось <= 0 Тогда Прервать; КонецЕсли;
  ВсеОстатки = Остатки.НайтиСтроки(Новый Структура("Номенклатура", Кандидат.Номенклатура));
  ВсегоКоличество = 0; ВсегоСтоимость = 0; ОстатокНаСкладе = Неопределено;
  Для Каждого О Из ВсеОстатки Цикл
   ВсегоКоличество = ВсегоКоличество + О.Количество; ВсегоСтоимость = ВсегоСтоимость + О.Стоимость;
   Если О.Склад = Док.Склад Тогда ОстатокНаСкладе = О; КонецЕсли;
  КонецЦикла;
  Если ОстатокНаСкладе = Неопределено Или ОстатокНаСкладе.Количество <= 0 Или ВсегоКоличество <= 0 Тогда Продолжить; КонецЕсли;
  Количество = Мин(Осталось, ОстатокНаСкладе.Количество);
  Если Количество = ВсегоКоличество Тогда Себестоимость = ВсегоСтоимость;
  Иначе Себестоимость = Окр(ВсегоСтоимость * Количество / ВсегоКоличество, 2); КонецЕсли;
  Если Количество = Осталось Тогда Выручка = ВыручкаОстаток;
  Иначе Выручка = Окр(ВыручкаОстаток * Количество / Осталось, 2); КонецЕсли;
  Движение = Док.Движения.Хозрасчетный.Добавить(); Движение.Период = Док.Дата;
  Движение.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Движение.СчетКт = ПланыСчетов.Управленческий.Товары;
  Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Кандидат.Номенклатура;
  Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Док.Склад;
  Движение.КоличествоКт = Количество; Движение.Сумма = Себестоимость;
  Движение = Док.Движения.Хозрасчетный.Добавить(); Движение.Период = Док.Дата;
  Движение.СчетДт = ПланыСчетов.Управленческий.Покупатели; Движение.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки; Движение.Сумма = Выручка;
  Движение = Док.Движения.ПродажиБухгалтерские.Добавить(); Движение.Период = Док.Дата;
  Движение.Номенклатура = Строка.Номенклатура; Движение.Продано = Кандидат.Номенклатура;
  Движение.Количество = Количество; Движение.Стоимость = Себестоимость; Движение.Выручка = Выручка;
  ОстатокНаСкладе.Количество = ОстатокНаСкладе.Количество - Количество; ОстатокНаСкладе.Стоимость = ОстатокНаСкладе.Стоимость - Себестоимость;
  Осталось = Осталось - Количество; ВыручкаОстаток = ВыручкаОстаток - Выручка;
 КонецЦикла;
КонецПроцедуры

Функция ЗатронутыеДвижения(Док) Экспорт
 Результат = Новый Структура("Товары,Склады,Начало", Новый Массив, Новый Массив, Док.Дата);
 Набор = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Док.Ссылка); Набор.Прочитать();
 Для Каждого Стр Из Набор Цикл
  Если Стр.СчетДт = ПланыСчетов.Управленческий.Товары Тогда
   Товар = Стр.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура]; Склад = Стр.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склад];
   ДобавитьЗатронутыйТовар(Результат, Товар, Склад, Стр.Период);
  КонецЕсли;
  Если Стр.СчетКт = ПланыСчетов.Управленческий.Товары Тогда
   Товар = Стр.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура]; Склад = Стр.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склад];
   ДобавитьЗатронутыйТовар(Результат, Товар, Склад, Стр.Период);
  КонецЕсли;
 КонецЦикла;
 Возврат Результат;
КонецФункции

Процедура ДобавитьЗатронутыйТовар(Результат, Товар, Склад, Период) Экспорт
 Если ЗначениеЗаполнено(Товар) И Результат.Товары.Найти(Товар) = Неопределено Тогда Результат.Товары.Добавить(Товар); КонецЕсли;
 Если ЗначениеЗаполнено(Склад) И Результат.Склады.Найти(Склад) = Неопределено Тогда Результат.Склады.Добавить(Склад); КонецЕсли;
 Результат.Начало = Мин(Результат.Начало, Период);
КонецПроцедуры

Процедура ПроверитьОстаткиПослеЗаписи(Док, Товары, Отказ, Склады = Неопределено, НачалоКонтроля = Неопределено) Экспорт
 Если Отказ Или Товары.Количество() = 0 Тогда Возврат; КонецЕсли;
 Если Склады = Неопределено Тогда Склады = Новый Массив; Склады.Добавить(Док.Склад); КонецЕсли;
 Если Склады.Количество() = 0 Тогда Возврат; КонецЕсли;
 Док.Движения.Хозрасчетный.Записать();
 Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склад);
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Субконто1 КАК Номенклатура, Остатки.Субконто2 КАК Склад
 |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет = &Счет, &Виды, Субконто1 В (&Товары) И Субконто2 В (&Склады)) КАК Остатки
 |ГДЕ Остатки.КоличествоОстатокДт < 0 ИЛИ Остатки.КоличествоОстатокКт > 0";
 Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары); Запрос.УстановитьПараметр("Виды", Виды);
 Запрос.УстановитьПараметр("Товары", Товары); Запрос.УстановитьПараметр("Склады", Склады);
 Выборка = Запрос.Выполнить().Выбрать();
 Если Выборка.Следующий() Тогда Отказ = Истина; Сообщить("После проведения недостаточно товара на складе: " + Строка(Выборка.Номенклатура)); Возврат; КонецЕсли;
 // Контроль каждой последующей точки не позволяет скрыть промежуточную нехватку будущим приходом.
 Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Субконто1 КАК Номенклатура, Остатки.Субконто2 КАК Склад
 |ИЗ РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&Начало, , Регистратор, , Счет = &Счет, &Виды, Субконто1 В (&Товары) И Субконто2 В (&Склады)) КАК Остатки
 |ГДЕ Остатки.КоличествоКонечныйОстатокДт < 0 ИЛИ Остатки.КоличествоКонечныйОстатокКт > 0";
 Запрос.УстановитьПараметр("Начало", ?(НачалоКонтроля = Неопределено, Док.Дата, НачалоКонтроля)); Выборка = Запрос.Выполнить().Выбрать();
 Если Выборка.Следующий() Тогда Отказ = Истина; Сообщить("Проведение создаст нехватку в последующих движениях: " + Строка(Выборка.Номенклатура)); Возврат; КонецЕсли;
 // Суммовая аналитика ведется по номенклатуре, без склада.
 ВидыСуммы = Новый Массив; ВидыСуммы.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
 Запрос.УстановитьПараметр("ВидыСуммы", ВидыСуммы);
 Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Субконто1 КАК Номенклатура
 |ИЗ РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&Начало, , Регистратор, , Счет = &Счет, &ВидыСуммы, Субконто1 В (&Товары)) КАК Остатки
 |ГДЕ Остатки.СуммаКонечныйОстатокДт < 0 ИЛИ Остатки.СуммаКонечныйОстатокКт > 0";
 Выборка = Запрос.Выполнить().Выбрать();
 Если Выборка.Следующий() Тогда Отказ = Истина; Сообщить("Проведение создаст отрицательную стоимость товара: " + Строка(Выборка.Номенклатура)); КонецЕсли;
КонецПроцедуры
