// Оперативные движения выполняются в транзакции проведения документа.
Процедура Заблокировать() Экспорт
 Блокировка = Новый БлокировкаДанных;
 Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
 Элемент.Режим = РежимБлокировкиДанных.Исключительный;
 Элемент = Блокировка.Добавить("РегистрНакопления.ПартииНоменклатуры");
 Элемент.Режим = РежимБлокировкиДанных.Исключительный;
 Элемент = Блокировка.Добавить("РегистрСведений.УчетныеПолитикиПодразделений"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
 Элемент = Блокировка.Добавить("РегистрСведений.Спецификации"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
 Блокировка.Заблокировать();
КонецПроцедуры

Процедура Подготовить(ДокументОбъект, УжеЗаблокировано = Ложь) Экспорт
 Если Не УжеЗаблокировано Тогда Заблокировать(); КонецЕсли;
 ДокументОбъект.Движения.ОстаткиНоменклатуры.Записывать = Истина;
 ДокументОбъект.Движения.ПартииНоменклатуры.Записывать = Истина;
 ДокументОбъект.Движения.ОстаткиНоменклатуры.Очистить();
 ДокументОбъект.Движения.ПартииНоменклатуры.Очистить();
 ДокументОбъект.Движения.ОстаткиНоменклатуры.Записать();
 ДокументОбъект.Движения.ПартииНоменклатуры.Записать();
КонецПроцедуры

Процедура Приход(Док, Подразделение, Товар, Свойство, Количество, Стоимость) Экспорт
 Движение = Док.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
 Движение.Период = Док.Дата; Движение.Подразделение = Подразделение;
 Движение.Номенклатура = Товар; Движение.Свойство = Свойство;
 Движение.Количество = Количество; Движение.Стоимость = Стоимость;
 Движение = Док.Движения.ПартииНоменклатуры.ДобавитьПриход();
 Движение.Период = Док.Дата; Движение.Подразделение = Подразделение;
 Движение.Номенклатура = Товар; Движение.Свойство = Свойство;
 Движение.Партия = Док.Ссылка; Движение.Количество = Количество; Движение.Стоимость = Стоимость;
КонецПроцедуры

Функция ОстаткиДляРасхода(Док, Подразделения, Номенклатура) Экспорт
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ Партии.Подразделение, Партии.Номенклатура, Партии.Свойство,
 | Партии.Партия, Партии.КоличествоОстаток КАК Количество, Партии.СтоимостьОстаток КАК Стоимость,
 | ЕСТЬNULL(Политики.Метод, ЗНАЧЕНИЕ(Перечисление.УчетнаяПолитика.ПустаяСсылка)) КАК Метод
 |ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(&Момент, Подразделение В (&Подразделения) И Номенклатура В (&Номенклатура)) КАК Партии
 | ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеПолитикиПодразделений.СрезПоследних(&Дата, Подразделение В (&Подразделения)) КАК Политики
 | ПО Партии.Подразделение = Политики.Подразделение
 |УПОРЯДОЧИТЬ ПО Партии.Партия.Дата, Партии.Партия";
 Запрос.УстановитьПараметр("Момент", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая));
 Запрос.УстановитьПараметр("Дата", Док.Дата);
 Запрос.УстановитьПараметр("Подразделения", Подразделения); Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
 Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Списать(Док, Партии, Подразделение, Товар, Свойство, Количество, ПоСредней, Отказ) Экспорт
 Если Количество <= 0 Тогда Отказ = Истина; Сообщить("Количество должно быть положительным"); Возврат 0; КонецЕсли;
 Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
 Строки = Партии.НайтиСтроки(Отбор); Доступно = 0; ОбщаяСтоимость = 0;
 Для Каждого Стр Из Строки Цикл Доступно = Доступно + Стр.Количество; ОбщаяСтоимость = ОбщаяСтоимость + Стр.Стоимость; КонецЦикла;
 Если Доступно < Количество Тогда
  Отказ = Истина; Сообщить("Недостаточно остатка: " + Строка(Товар) + ", " + Строка(Подразделение)); Возврат 0;
 КонецЕсли;
 Метод = Строки[0].Метод;
 Если ПоСредней Тогда Метод = Перечисления.УчетнаяПолитика.ПоСредней; КонецЕсли;
 Если Не ЗначениеЗаполнено(Метод) Тогда Отказ = Истина; Сообщить("Не задана учетная политика подразделения: " + Строка(Подразделение)); Возврат 0; КонецЕсли;
 Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
  Обратные = Новый Массив;
  Индекс = Строки.Количество() - 1;
  Пока Индекс >= 0 Цикл Обратные.Добавить(Строки[Индекс]); Индекс = Индекс - 1; КонецЦикла;
  Строки = Обратные;
 КонецЕсли;
 Осталось = Количество; СтоимостьРасхода = 0; ОстатокБазы = Доступно; Распределение = Новый Массив;
 Для Каждого Стр Из Строки Цикл
  Если Осталось <= 0 Тогда Прервать; КонецЕсли;
  Если Стр.Количество <= 0 Тогда Продолжить; КонецЕсли;
  Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
   Если ОстатокБазы = Стр.Количество Тогда Взять = Осталось;
   Иначе Взять = Окр(Осталось * Стр.Количество / ОстатокБазы, 3); КонецЕсли;
   Взять = Мин(Взять, Стр.Количество);
  Иначе Взять = Мин(Осталось, Стр.Количество); КонецЕсли;
  ОстатокБазы = ОстатокБазы - Стр.Количество;
  Если Взять = 0 Тогда Продолжить; КонецЕсли;
  Если Взять = Стр.Количество Тогда Сумма = Стр.Стоимость;
  Иначе Сумма = Окр(Стр.Стоимость * Взять / Стр.Количество, 2); КонецЕсли;
  Распределение.Добавить(Новый Структура("Строка,Количество,Сумма,Полностью", Стр, Взять, Сумма, Взять = Стр.Количество));
  Осталось = Осталось - Взять; СтоимостьРасхода = СтоимостьРасхода + Сумма;
 КонецЦикла;
 ПереносСтоимости = 0; ПартияПолучатель = Неопределено;
 Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
  ЦелеваяСтоимость = ?(Количество = Доступно, ОбщаяСтоимость, Окр(ОбщаяСтоимость * Количество / Доступно, 2));
  Разница = ЦелеваяСтоимость - СтоимостьРасхода;
  // Копейки распределяются между неполностью списанными партиями; полностью списанные партии закрываются точно.
  Для Каждого Часть Из Распределение Цикл
   Если Разница = 0 Тогда Прервать; КонецЕсли;
   Если Часть.Полностью Тогда Продолжить; КонецЕсли;
   Если Разница > 0 Тогда Коррекция = Мин(Разница, Часть.Строка.Стоимость - Часть.Сумма);
   Иначе Коррекция = -Мин(-Разница, Часть.Сумма); КонецЕсли;
   Часть.Сумма = Часть.Сумма + Коррекция; Разница = Разница - Коррекция; СтоимостьРасхода = СтоимостьРасхода + Коррекция;
  КонецЦикла;
  // Если округление количества не затронуло партию, можно списать из неё часть стоимости без количества.
  Если Разница > 0 Тогда
   Для Каждого Стр Из Строки Цикл
    Если Разница = 0 Тогда Прервать; КонецЕсли;
    УжеВыбрана = Ложь;
    Для Каждого Часть Из Распределение Цикл Если Часть.Строка = Стр Тогда УжеВыбрана = Истина; Прервать; КонецЕсли; КонецЦикла;
    Если УжеВыбрана Или Стр.Количество <= 0 Тогда Продолжить; КонецЕсли;
    Коррекция = Мин(Разница, Стр.Стоимость);
    Если Коррекция > 0 Тогда
     Распределение.Добавить(Новый Структура("Строка,Количество,Сумма,Полностью", Стр, 0, Коррекция, Ложь));
     Разница = Разница - Коррекция; СтоимостьРасхода = СтоимостьРасхода + Коррекция;
    КонецЕсли;
   КонецЦикла;
  КонецЕсли;
  Если Разница < 0 Тогда
   // При округлении могла целиком списаться дорогая малая партия; перенесём лишнюю стоимость на оставшуюся.
   Для Каждого Стр Из Строки Цикл
    ОстатокКоличества = Стр.Количество;
    Для Каждого Часть Из Распределение Цикл Если Часть.Строка = Стр Тогда ОстатокКоличества = ОстатокКоличества - Часть.Количество; КонецЕсли; КонецЦикла;
    Если ОстатокКоличества > 0 Тогда ПартияПолучатель = Стр; Прервать; КонецЕсли;
   КонецЦикла;
   Если ПартияПолучатель <> Неопределено Тогда ПереносСтоимости = -Разница; СтоимостьРасхода = СтоимостьРасхода - ПереносСтоимости; Разница = 0; КонецЕсли;
  КонецЕсли;
  Если Разница <> 0 Тогда Отказ = Истина; Сообщить("Невозможно распределить округление средней стоимости между партиями"); Возврат 0; КонецЕсли;
 КонецЕсли;
 Для Каждого Часть Из Распределение Цикл
  Стр = Часть.Строка;
  Движение = Док.Движения.ПартииНоменклатуры.ДобавитьРасход();
  Движение.Период = Док.Дата; Движение.Подразделение = Подразделение;
  Движение.Номенклатура = Товар; Движение.Свойство = Свойство; Движение.Партия = Стр.Партия;
  Движение.Количество = Часть.Количество; Движение.Стоимость = Часть.Сумма;
  Стр.Количество = Стр.Количество - Часть.Количество; Стр.Стоимость = Стр.Стоимость - Часть.Сумма;
 КонецЦикла;
 Если Метод = Перечисления.УчетнаяПолитика.ПоСредней И ПереносСтоимости > 0 Тогда
  Движение = Док.Движения.ПартииНоменклатуры.ДобавитьПриход(); Движение.Период = Док.Дата; Движение.Подразделение = Подразделение;
  Движение.Номенклатура = Товар; Движение.Свойство = Свойство; Движение.Партия = ПартияПолучатель.Партия; Движение.Количество = 0; Движение.Стоимость = ПереносСтоимости;
  ПартияПолучатель.Стоимость = ПартияПолучатель.Стоимость + ПереносСтоимости;
 КонецЕсли;
 Движение = Док.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
 Движение.Период = Док.Дата; Движение.Подразделение = Подразделение;
 Движение.Номенклатура = Товар; Движение.Свойство = Свойство;
 Движение.Количество = Количество; Движение.Стоимость = СтоимостьРасхода;
 Возврат СтоимостьРасхода;
КонецФункции

Функция ЗатронутыеДвижения(Док) Экспорт
 Результат = Новый Структура("Подразделения,Номенклатура,Начало", Новый Массив, Новый Массив, Док.Дата);
 Запрос = Новый Запрос("ВЫБРАТЬ Период, Подразделение, Номенклатура ИЗ РегистрНакопления.ПартииНоменклатуры ГДЕ Регистратор = &Регистратор");
 Запрос.УстановитьПараметр("Регистратор", Док.Ссылка);
 Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
  Если Результат.Подразделения.Найти(Стр.Подразделение) = Неопределено Тогда Результат.Подразделения.Добавить(Стр.Подразделение); КонецЕсли;
  Если Результат.Номенклатура.Найти(Стр.Номенклатура) = Неопределено Тогда Результат.Номенклатура.Добавить(Стр.Номенклатура); КонецЕсли;
  Результат.Начало = Мин(Результат.Начало, Стр.Период);
 КонецЦикла;
 Возврат Результат;
КонецФункции

Процедура ПроверитьОстаткиПослеЗаписи(Док, Подразделения, Номенклатура, Отказ, НачалоКонтроля = Неопределено) Экспорт
 Если Отказ Или Номенклатура.Количество() = 0 Тогда Возврат; КонецЕсли;
 Док.Движения.ОстаткиНоменклатуры.Записать(); Док.Движения.ПартииНоменклатуры.Записать();
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Подразделение, Остатки.Номенклатура, Остатки.Свойство, Остатки.Партия
 |ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(, Подразделение В (&Подразделения) И Номенклатура В (&Номенклатура)) КАК Остатки
 |ГДЕ Остатки.КоличествоОстаток < 0 ИЛИ Остатки.СтоимостьОстаток < 0";
 Запрос.УстановитьПараметр("Подразделения", Подразделения); Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
 Выборка = Запрос.Выполнить().Выбрать();
 Если Выборка.Следующий() Тогда
  Отказ = Истина; Сообщить("После проведения обнаружен отрицательный остаток партии: " + Строка(Выборка.Номенклатура) + ", " + Строка(Выборка.Подразделение));
  Возврат;
 КонецЕсли;
 Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Подразделение, Остатки.Номенклатура, Остатки.Свойство, Остатки.Партия
 |ИЗ РегистрНакопления.ПартииНоменклатуры.ОстаткиИОбороты(&Начало, , Регистратор, , Подразделение В (&Подразделения) И Номенклатура В (&Номенклатура)) КАК Остатки
 |ГДЕ Остатки.КоличествоКонечныйОстаток < 0 ИЛИ Остатки.СтоимостьКонечныйОстаток < 0";
 Запрос.УстановитьПараметр("Начало", ?(НачалоКонтроля = Неопределено, Док.Дата, НачалоКонтроля)); Выборка = Запрос.Выполнить().Выбрать();
 Если Выборка.Следующий() Тогда Отказ = Истина; Сообщить("Проведение создаст нехватку в последующих движениях: " + Строка(Выборка.Номенклатура)); КонецЕсли;
КонецПроцедуры

