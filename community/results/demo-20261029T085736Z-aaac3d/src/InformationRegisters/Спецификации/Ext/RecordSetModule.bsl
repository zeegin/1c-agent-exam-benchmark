Процедура ПередЗаписью(Отказ, Замещение)
 Если Количество() = 0 Тогда Возврат; КонецЕсли;
 Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.Спецификации");
 Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
 Начало = НачалоНедели(ЭтотОбъект[0].Период); Конец = КонецНедели(ЭтотОбъект[0].Период);
 Для Каждого Стр Из ЭтотОбъект Цикл
  Начало = Мин(Начало, НачалоНедели(Стр.Период)); Конец = Макс(Конец, КонецНедели(Стр.Период));
 КонецЦикла;
 Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ СистемныйБлок, Период ИЗ РегистрСведений.Спецификации ГДЕ Период МЕЖДУ &Начало И &Конец");
 Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Конец);
 Существующие = Запрос.Выполнить().Выгрузить();
 Для Каждого Стр Из ЭтотОбъект Цикл
  Для Каждого Запись Из Существующие.НайтиСтроки(Новый Структура("СистемныйБлок", Стр.СистемныйБлок)) Цикл
   Если НачалоНедели(Запись.Период) = НачалоНедели(Стр.Период) И НачалоДня(Запись.Период) <> НачалоДня(Стр.Период) Тогда
    Отказ = Истина; Сообщить("Состав блока можно изменять не чаще одного раза в неделю: " + Строка(Стр.СистемныйБлок)); Возврат;
   КонецЕсли;
  КонецЦикла;
  Для Каждого Другая Из ЭтотОбъект Цикл
   Если Другая.СистемныйБлок = Стр.СистемныйБлок И НачалоНедели(Другая.Период) = НачалоНедели(Стр.Период) И НачалоДня(Другая.Период) <> НачалоДня(Стр.Период) Тогда
    Отказ = Истина; Сообщить("В одной неделе допускается одна редакция спецификации"); Возврат;
   КонецЕсли;
  КонецЦикла;
 КонецЦикла;
КонецПроцедуры
