Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение) Экспорт
 Если Не ЗначениеЗаполнено(Подразделение) Или Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Или ДатаНачала > ДатаОкончания Тогда
  ВызватьИсключение "Укажите подразделение и корректный период графика";
 КонецЕсли;
 Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
 Набор.Отбор.Подразделение.Установить(Подразделение); Набор.Прочитать();
 СтрокиДней = Новый Соответствие;
 Для Каждого Стр Из Набор Цикл СтрокиДней.Вставить(НачалоДня(Стр.Дата), Стр); КонецЦикла;
 День = НачалоДня(ДатаНачала);
 Пока День <= КонецДня(ДатаОкончания) Цикл
  Стр = СтрокиДней.Получить(День);
  Если Стр = Неопределено Тогда Стр = Набор.Добавить(); Стр.Подразделение = Подразделение; Стр.Дата = День; КонецЕсли;
  Стр.Значение = ?(СтрНайти(ВыходныеДни, Строка(ДеньНедели(День))) > 0, 0, 8);
  День = День + 86400;
 КонецЦикла;
 Набор.Записать();
КонецПроцедуры
