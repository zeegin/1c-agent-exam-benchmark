Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Если СписокНоменклатуры.Количество() = 0 Тогда Отказ = Истина; Сообщить("Добавьте товары"); Возврат; КонецЕсли;
 УчетЗапасов.Заблокировать(); УчетБухгалтерский.Заблокировать();
 СтарыеЗапасы = УчетЗапасов.ЗатронутыеДвижения(ЭтотОбъект);
 СтарыеПроводки = УчетБухгалтерский.ЗатронутыеДвижения(ЭтотОбъект);
 УчетЗапасов.Подготовить(ЭтотОбъект, Истина);
 УчетБухгалтерский.Подготовить(ЭтотОбъект, Истина);
 Если ЗначениеЗаполнено(Склад) И СтарыеПроводки.Склады.Найти(Склад) = Неопределено Тогда СтарыеПроводки.Склады.Добавить(Склад); КонецЕсли;
 Для Каждого Строка Из СписокНоменклатуры Цикл
  Если Не ЗначениеЗаполнено(Строка.Номенклатура) Или Строка.Количество <= 0 Или Строка.Цена < 0 Или Строка.Сумма < 0 Тогда Отказ = Истина; Сообщить("Укажите товар, положительное количество и неотрицательную стоимость"); Продолжить; КонецЕсли;
  Если Не ЗначениеЗаполнено(Строка.Подразделение) И Не ЗначениеЗаполнено(Склад) Тогда Отказ = Истина; Сообщить("Укажите подразделение или склад"); Продолжить; КонецЕсли;
  СуммаСтроки = Строка.Сумма;
  Если СуммаСтроки = 0 Тогда СуммаСтроки = Строка.Количество * Строка.Цена; КонецЕсли;
  Если ЗначениеЗаполнено(Строка.Подразделение) Тогда
   Если СтарыеЗапасы.Подразделения.Найти(Строка.Подразделение) = Неопределено Тогда СтарыеЗапасы.Подразделения.Добавить(Строка.Подразделение); КонецЕсли;
   Если СтарыеЗапасы.Номенклатура.Найти(Строка.Номенклатура) = Неопределено Тогда СтарыеЗапасы.Номенклатура.Добавить(Строка.Номенклатура); КонецЕсли;
   УчетЗапасов.Приход(ЭтотОбъект, Строка.Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, СуммаСтроки);
  КонецЕсли;
  Если ЗначениеЗаполнено(Склад) Тогда
   Если СтарыеПроводки.Товары.Найти(Строка.Номенклатура) = Неопределено Тогда СтарыеПроводки.Товары.Добавить(Строка.Номенклатура); КонецЕсли;
   УчетБухгалтерский.Приход(ЭтотОбъект, Строка, СуммаСтроки);
  КонецЕсли;
 КонецЦикла;
 УчетЗапасов.ПроверитьОстаткиПослеЗаписи(ЭтотОбъект, СтарыеЗапасы.Подразделения, СтарыеЗапасы.Номенклатура, Отказ, СтарыеЗапасы.Начало);
 УчетБухгалтерский.ПроверитьОстаткиПослеЗаписи(ЭтотОбъект, СтарыеПроводки.Товары, Отказ, СтарыеПроводки.Склады, СтарыеПроводки.Начало);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
 УчетЗапасов.Заблокировать(); УчетБухгалтерский.Заблокировать();
 СтарыеЗапасы = УчетЗапасов.ЗатронутыеДвижения(ЭтотОбъект); СтарыеПроводки = УчетБухгалтерский.ЗатронутыеДвижения(ЭтотОбъект);
 УчетЗапасов.Подготовить(ЭтотОбъект, Истина); УчетБухгалтерский.Подготовить(ЭтотОбъект, Истина);
 УчетЗапасов.ПроверитьОстаткиПослеЗаписи(ЭтотОбъект, СтарыеЗапасы.Подразделения, СтарыеЗапасы.Номенклатура, Отказ, СтарыеЗапасы.Начало);
 УчетБухгалтерский.ПроверитьОстаткиПослеЗаписи(ЭтотОбъект, СтарыеПроводки.Товары, Отказ, СтарыеПроводки.Склады, СтарыеПроводки.Начало);
КонецПроцедуры
