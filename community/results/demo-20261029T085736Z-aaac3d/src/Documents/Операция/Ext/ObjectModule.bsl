Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 УчетБухгалтерский.Заблокировать(); СтарыеПроводки = УчетБухгалтерский.ЗатронутыеДвижения(ЭтотОбъект);
 УчетБухгалтерский.Подготовить(ЭтотОбъект, Истина);
 Движения.ПродажиБухгалтерские.Записывать = Истина; Движения.ПродажиБухгалтерские.Очистить();
 ЕдинственныйЗаказ = Неопределено; ЕдинственныйПроданный = Неопределено; НесколькоТоваров = Ложь;
 Для Каждого Стр Из Проводки Цикл
  Если Стр.СчетДт <> ПланыСчетов.Управленческий.ПрибылиУбытки Или Стр.СчетКт <> ПланыСчетов.Управленческий.Товары Тогда Продолжить; КонецЕсли;
  Проданный = ?(ЗначениеЗаполнено(Стр.НоменклатураКт), Стр.НоменклатураКт, Стр.ПроданныйТовар);
  Заказ = ?(ЗначениеЗаполнено(Стр.ЗаказанныйТовар), Стр.ЗаказанныйТовар, Проданный);
  Если ЕдинственныйЗаказ = Неопределено Тогда ЕдинственныйЗаказ = Заказ; ЕдинственныйПроданный = Проданный;
  ИначеЕсли ЕдинственныйЗаказ <> Заказ Или ЕдинственныйПроданный <> Проданный Тогда НесколькоТоваров = Истина; КонецЕсли;
 КонецЦикла;
 Для Каждого Стр Из Проводки Цикл
  Если Не ЗначениеЗаполнено(Стр.СчетДт) Или Не ЗначениеЗаполнено(Стр.СчетКт) Тогда Отказ = Истина; Сообщить("Укажите оба счёта проводки"); Продолжить; КонецЕсли;
  Если Стр.СчетДт = ПланыСчетов.Управленческий.Товары И (Не ЗначениеЗаполнено(Стр.НоменклатураДт) Или Не ЗначениеЗаполнено(Стр.СкладДт)) Тогда Отказ = Истина; Сообщить("Укажите товар и склад по дебету"); Продолжить; КонецЕсли;
  Если Стр.СчетКт = ПланыСчетов.Управленческий.Товары И (Не ЗначениеЗаполнено(Стр.НоменклатураКт) Или Не ЗначениеЗаполнено(Стр.СкладКт)) Тогда Отказ = Истина; Сообщить("Укажите товар и склад по кредиту"); Продолжить; КонецЕсли;
  Движение = Движения.Хозрасчетный.Добавить(); Движение.Период = Дата;
  Движение.СчетДт = Стр.СчетДт; Движение.СчетКт = Стр.СчетКт;
  Если Стр.СчетДт = ПланыСчетов.Управленческий.Товары Тогда
   УчетБухгалтерский.ДобавитьЗатронутыйТовар(СтарыеПроводки, Стр.НоменклатураДт, Стр.СкладДт, Дата);
   Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураДт;
   Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Стр.СкладДт;
  КонецЕсли;
  Если Стр.СчетКт = ПланыСчетов.Управленческий.Товары Тогда
   УчетБухгалтерский.ДобавитьЗатронутыйТовар(СтарыеПроводки, Стр.НоменклатураКт, Стр.СкладКт, Дата);
   Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураКт;
   Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Стр.СкладКт;
  КонецЕсли;
  Движение.КоличествоДт = Стр.КоличествоДт; Движение.КоличествоКт = Стр.КоличествоКт; Движение.Сумма = Стр.Сумма;
  Если Стр.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки И Стр.СчетКт = ПланыСчетов.Управленческий.Товары Тогда
   Проданный = ?(ЗначениеЗаполнено(Стр.НоменклатураКт), Стр.НоменклатураКт, Стр.ПроданныйТовар);
   Заказ = ?(ЗначениеЗаполнено(Стр.ЗаказанныйТовар), Стр.ЗаказанныйТовар, Проданный);
   Если ЗначениеЗаполнено(Проданный) Тогда
    Продажа = Движения.ПродажиБухгалтерские.Добавить(); Продажа.Период = Дата; Продажа.Номенклатура = Заказ; Продажа.Продано = Проданный;
    Продажа.Количество = Стр.КоличествоКт; Продажа.Стоимость = Стр.Сумма;
   КонецЕсли;
  ИначеЕсли Стр.СчетДт = ПланыСчетов.Управленческий.Покупатели И Стр.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки Тогда
   Проданный = Стр.ПроданныйТовар; Заказ = Стр.ЗаказанныйТовар;
   Если Не ЗначениеЗаполнено(Проданный) И Не НесколькоТоваров Тогда Проданный = ЕдинственныйПроданный; КонецЕсли;
   Если Не ЗначениеЗаполнено(Заказ) Тогда Заказ = ?(НесколькоТоваров, Проданный, ЕдинственныйЗаказ); КонецЕсли;
   Если ЗначениеЗаполнено(Проданный) И ЗначениеЗаполнено(Заказ) Тогда
    Продажа = Движения.ПродажиБухгалтерские.Добавить(); Продажа.Период = Дата; Продажа.Номенклатура = Заказ; Продажа.Продано = Проданный; Продажа.Выручка = Стр.Сумма;
   КонецЕсли;
  КонецЕсли;
 КонецЦикла;
 УчетБухгалтерский.ПроверитьОстаткиПослеЗаписи(ЭтотОбъект, СтарыеПроводки.Товары, Отказ, СтарыеПроводки.Склады, СтарыеПроводки.Начало);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
 УчетБухгалтерский.Заблокировать(); СтарыеПроводки = УчетБухгалтерский.ЗатронутыеДвижения(ЭтотОбъект);
 УчетБухгалтерский.Подготовить(ЭтотОбъект, Истина);
 УчетБухгалтерский.ПроверитьОстаткиПослеЗаписи(ЭтотОбъект, СтарыеПроводки.Товары, Отказ, СтарыеПроводки.Склады, СтарыеПроводки.Начало);
КонецПроцедуры
