Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Если ОсновныеНачисления.Количество() = 0 Тогда Отказ = Истина; Сообщить("Добавьте начисления"); Возврат; КонецЕсли;
 Блокировка = Новый БлокировкаДанных;
 Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
 Элемент.Режим = РежимБлокировкиДанных.Исключительный;
 Элемент = Блокировка.Добавить("РегистрРасчета.БазаНачислений"); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
 Элемент = Блокировка.Добавить("РегистрСведений.ГрафикиРаботы"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
 Элемент = Блокировка.Добавить("РегистрСведений.СведенияОСотрудниках"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
 Элемент = Блокировка.Добавить("РегистрСведений.ШкалаПремий"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
 Элемент = Блокировка.Добавить("Справочник.ФизическиеЛица"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый; Блокировка.Заблокировать();
 Движения.Начисления.Записывать = Истина; Движения.Начисления.Очистить(); Движения.Начисления.Записать();
 Движения.БазаНачислений.Записывать = Истина; Движения.БазаНачислений.Очистить(); Движения.БазаНачислений.Записать();
 Сотрудники = Новый Массив;
 Для Каждого Стр Из ОсновныеНачисления Цикл Если Сотрудники.Найти(Стр.Сотрудник) = Неопределено Тогда Сотрудники.Добавить(Стр.Сотрудник); КонецЕсли; КонецЦикла;
 Запрос = Новый Запрос("ВЫБРАТЬ Сотрудник, Подразделение, Период, Оклад ИЗ РегистрСведений.СведенияОСотрудниках ГДЕ Сотрудник В (&Сотрудники) УПОРЯДОЧИТЬ ПО Период УБЫВ");
 Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
 Ставки = Запрос.Выполнить().Выгрузить();
 Запрос.Текст = "ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж УБЫВ";
 Шкала = Запрос.Выполнить().Выгрузить();
 Запрос.Текст = "ВЫБРАТЬ Ссылка, ДатаНачалаСтажа ИЗ Справочник.ФизическиеЛица ГДЕ Ссылка В (&Сотрудники)";
 Стажи = Запрос.Выполнить().Выгрузить();
 Ключи = Новый ТаблицаЗначений;
 Для Каждого Имя Из СтрРазделить("Сотрудник,Подразделение,ВидРасчета,Начало,Конец,НачалоИсходное,Индекс", ",") Цикл Ключи.Колонки.Добавить(Имя); КонецЦикла;
 Для Каждого Стр Из ОсновныеНачисления Цикл
  Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение) Или Не ЗначениеЗаполнено(Стр.ВидРасчета)
   Или Не ЗначениеЗаполнено(Стр.ДатаНачала) Или Не ЗначениеЗаполнено(Стр.ДатаОкончания) Или Стр.ДатаНачала > Стр.ДатаОкончания Тогда
   Отказ = Истина; Сообщить("Проверьте сотрудника, подразделение, вид расчета и период"); Продолжить;
  КонецЕсли;
  Командировка = Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
  Если Не Командировка И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
   Отказ = Истина; Сообщить("Неподдерживаемый вид начисления"); Продолжить;
  КонецЕсли;
  Если Не Командировка И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
   Отказ = Истина; Сообщить("Тариф и премия вводятся в пределах месяца"); Продолжить;
  КонецЕсли;
  Начало = НачалоДня(Стр.ДатаНачала); Конец = КонецДня(Стр.ДатаОкончания);
  Пока Начало <= Конец Цикл
   КонецЧасти = Мин(КонецМесяца(Начало), Конец);
   Поиск = Новый Структура("Сотрудник,Подразделение,ВидРасчета,Начало,Конец,НачалоИсходное", Стр.Сотрудник, Стр.Подразделение, Стр.ВидРасчета, Начало, КонецЧасти, НачалоМесяца(Стр.ДатаНачала));
   Совпадения = Ключи.НайтиСтроки(Поиск);
   Если Совпадения.Количество() > 0 Тогда
    Движения.Начисления[Совпадения[0].Индекс].Кратность = Движения.Начисления[Совпадения[0].Индекс].Кратность + 1;
    Начало = НачалоДня(КонецЧасти + 1); Продолжить;
   КонецЕсли;
   Ключ = Ключи.Добавить(); ЗаполнитьЗначенияСвойств(Ключ, Поиск); Ключ.Индекс = Движения.Начисления.Количество();
   Движение = Движения.Начисления.Добавить();
   Движение.Кратность = 1;
   Движение.Сотрудник = Стр.Сотрудник; Движение.Подразделение = Стр.Подразделение; Движение.ВидРасчета = Стр.ВидРасчета;
   Движение.ПериодРегистрации = ?(Командировка, Макс(НачалоМесяца(Дата), НачалоМесяца(Начало)), НачалоМесяца(Начало));
   Движение.ПериодДействияНачало = Начало; Движение.ПериодДействияКонец = КонецЧасти;
   СтавкаНайдена = Ложь;
   Для Каждого Ставка Из Ставки.НайтиСтроки(Новый Структура("Сотрудник,Подразделение", Стр.Сотрудник, Стр.Подразделение)) Цикл
    Если Ставка.Период <= НачалоМесяца(Начало) Тогда Движение.Ставка = Ставка.Оклад; СтавкаНайдена = Истина; Прервать; КонецЕсли;
   КонецЦикла;
   Если Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф И Не СтавкаНайдена Тогда Отказ = Истина; Сообщить("На начало месяца не задана тарифная ставка сотрудника"); КонецЕсли;
   Если Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф И СтавкаНайдена И Движение.Ставка < 0 Тогда Отказ = Истина; Сообщить("Тарифная ставка не может быть отрицательной"); КонецЕсли;
   СтрокиСтажа = Стажи.НайтиСтроки(Новый Структура("Ссылка", Стр.Сотрудник));
   ДатаСтажа = ?(СтрокиСтажа.Количество() = 0, Дата(1,1,1), СтрокиСтажа[0].ДатаНачалаСтажа);
   Если ЗначениеЗаполнено(ДатаСтажа) Тогда
    Лет = Год(Начало) - Год(ДатаСтажа);
    Если ДобавитьМесяц(ДатаСтажа, Лет * 12) > НачалоМесяца(Начало) Тогда Лет = Лет - 1; КонецЕсли;
    Движение.Стаж = Макс(0, Лет);
   КонецЕсли;
   Для Каждого Порог Из Шкала Цикл
    Если Порог.Стаж <= Движение.Стаж Тогда Движение.Процент = Порог.Процент; Прервать; КонецЕсли;
   КонецЦикла;
   Если Командировка Тогда
    Движение.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Стр.ДатаНачала), -3);
    Движение.БазовыйПериодКонец = КонецДня(НачалоМесяца(Стр.ДатаНачала) - 1);
   ИначеЕсли Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
    Движение.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
    Движение.БазовыйПериодКонец = КонецДня(НачалоМесяца(Начало) - 1);
   КонецЕсли;
   Начало = НачалоДня(КонецЧасти + 1);
  КонецЦикла;
 КонецЦикла;
 Если Отказ Тогда Возврат; КонецЕсли;
 Движения.Начисления.Записать();
 КлючиСторно = Новый ТаблицаЗначений;
 Для Каждого Имя Из СтрРазделить("Сотрудник,Подразделение,ВидРасчета,Начало,Конец,Ставка,Процент,Стаж,БазаПремии,НормаМесяца,БазаНачало,БазаКонец,ИсходноеНачало,ИсходноеКонец,Индекс", ",") Цикл КлючиСторно.Колонки.Добавить(Имя); КонецЦикла;
 Для Каждого Сторно Из Движения.Начисления.ПолучитьДополнение() Цикл
  Поиск = Новый Структура("Сотрудник,Подразделение,ВидРасчета,Начало,Конец,Ставка,Процент,Стаж,БазаНачало,БазаКонец", Сторно.Сотрудник, Сторно.Подразделение, Сторно.ВидРасчета, Сторно.ПериодДействияНачалоСторно, Сторно.ПериодДействияКонецСторно, Сторно.Ставка, Сторно.Процент, Сторно.Стаж, Сторно.БазовыйПериодНачало, Сторно.БазовыйПериодКонец);
  Поиск.Вставить("БазаПремии", Сторно.БазаПремии); Поиск.Вставить("НормаМесяца", Сторно.НормаМесяца);
  Поиск.Вставить("ИсходноеНачало", Сторно.ПериодДействияНачало); Поиск.Вставить("ИсходноеКонец", Сторно.ПериодДействияКонец);
  Совпадения = КлючиСторно.НайтиСтроки(Поиск);
  Если Совпадения.Количество() > 0 Тогда
   Движения.Начисления[Совпадения[0].Индекс].Кратность = Движения.Начисления[Совпадения[0].Индекс].Кратность + Макс(1, Сторно.Кратность); Продолжить;
  КонецЕсли;
  Ключ = КлючиСторно.Добавить(); ЗаполнитьЗначенияСвойств(Ключ, Поиск); Ключ.Индекс = Движения.Начисления.Количество();
  Движение = Движения.Начисления.Добавить(); ЗаполнитьЗначенияСвойств(Движение, Сторно);
  Движение.Кратность = Макс(1, Сторно.Кратность);
  Движение.Сторно = Истина; Движение.ПериодРегистрации = Сторно.ПериодРегистрацииСторно;
  Движение.ПериодДействияНачало = Сторно.ПериодДействияНачалоСторно; Движение.ПериодДействияКонец = Сторно.ПериодДействияКонецСторно;
 КонецЦикла;
 Движения.Начисления.Записать();
 ЗаписатьБазу();
 Рассчитать();
КонецПроцедуры

Процедура Рассчитать()
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ Начисления.НомерСтроки КАК НомерСтроки,
 | Начисления.Сотрудник КАК Сотрудник, Начисления.Подразделение КАК Подразделение,
 | Начисления.Сторно КАК Сторно, Начисления.ПериодДействияНачало КАК НачалоДействия, Начисления.ПериодДействияКонец КАК КонецДействия,
 | ВЫБОР КОГДА Начисления.Сторно ТОГДА ЕСТЬNULL(ГрафикБазы.ЗначениеФактическийПериодДействия, 0) ИНАЧЕ ЕСТЬNULL(График.ЗначениеФактическийПериодДействия, 0) КОНЕЦ КАК Часы,
 | ВЫБОР КОГДА Начисления.Сторно ТОГДА ЕСТЬNULL(ГрафикБазы.ЗначениеПериодДействия, 0) ИНАЧЕ ЕСТЬNULL(График.ЗначениеПериодДействия, 0) КОНЕЦ КАК ЧасыПлан,
 | ЕСТЬNULL(График.ЗначениеПериодРегистрации, 0) КАК НормаМесяца,
 | ВЫБОР КОГДА Начисления.Сторно ТОГДА ЕСТЬNULL(ГрафикБазы.ДниФактическийПериодДействия, 0) ИНАЧЕ ЕСТЬNULL(График.ДниФактическийПериодДействия, 0) КОНЕЦ КАК Дни
 |ИЗ РегистрРасчета.Начисления КАК Начисления
 | ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор = &Регистратор) КАК График
 | ПО Начисления.НомерСтроки = График.НомерСтроки И Начисления.Регистратор = График.Регистратор
 | ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.БазаНачислений.ДанныеГрафика(Регистратор = &Регистратор) КАК ГрафикБазы
 | ПО Начисления.НомерСтроки = ГрафикБазы.НомерСтроки И Начисления.Регистратор = ГрафикБазы.Регистратор
 |ГДЕ Начисления.Регистратор = &Регистратор";
 Запрос.УстановитьПараметр("Регистратор", Ссылка);
 ДанныеГрафика = Запрос.Выполнить().Выгрузить();
 // Для нескольких сторно на один интервал платформа может вернуть фактический график одной строкой.
 Для Каждого График Из ДанныеГрафика Цикл
  Если Не График.Сторно Или График.Часы <> 0 Тогда Продолжить; КонецЕсли;
  Поиск = Новый Структура("Сотрудник,Подразделение,НачалоДействия,КонецДействия,Сторно", График.Сотрудник, График.Подразделение, График.НачалоДействия, График.КонецДействия, Истина);
  Для Каждого Сосед Из ДанныеГрафика.НайтиСтроки(Поиск) Цикл
   Если Сосед.Часы <> 0 Тогда График.Часы = Сосед.Часы; График.Дни = Сосед.Дни; Прервать; КонецЕсли;
  КонецЦикла;
 КонецЦикла;
 Для Каждого График Из ДанныеГрафика Цикл
  Запись = Движения.Начисления[График.НомерСтроки - 1]; Знак = ?(Запись.Сторно, -1, 1);
  Если Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
   Запись.Результат = Окр(Запись.Ставка * График.Часы * Знак * Запись.Кратность, 2); Запись.Дни = График.Дни * Знак * Запись.Кратность;
  КонецЕсли;
 КонецЦикла;
 Движения.Начисления.Записать(, Истина);
 ЗаписатьБазу();
 // База подразделения за предыдущий месяц за вычетом начислений самого руководителя.
 Запрос.Текст = "ВЫБРАТЬ Начисления.НомерСтроки КАК НомерСтроки,
 | ЕСТЬNULL(БазаПодразделения.РезультатБаза, 0) - ЕСТЬNULL(БазаРуководителя.РезультатБаза, 0) КАК База
 |ИЗ РегистрРасчета.БазаНачислений КАК Начисления
 | ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.БазаНачислений.БазаБазаНачислений(&Подразделения, &Подразделения,, Регистратор = &Регистратор И ВидРасчета = &Премия) КАК БазаПодразделения
 | ПО Начисления.Регистратор = БазаПодразделения.Регистратор И Начисления.НомерСтроки = БазаПодразделения.НомерСтроки
 | ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.БазаНачислений.БазаБазаНачислений(&ВсеИзмерения, &ВсеИзмерения,, Регистратор = &Регистратор И ВидРасчета = &Премия) КАК БазаРуководителя
 | ПО Начисления.Регистратор = БазаРуководителя.Регистратор И Начисления.НомерСтроки = БазаРуководителя.НомерСтроки
 |ГДЕ Начисления.Регистратор = &Регистратор И Начисления.ВидРасчета = &Премия";
 Подразделения = Новый Массив; Подразделения.Добавить("Подразделение");
 ВсеИзмерения = Новый Массив; ВсеИзмерения.Добавить("Подразделение"); ВсеИзмерения.Добавить("Сотрудник");
 Запрос.УстановитьПараметр("Подразделения", Подразделения); Запрос.УстановитьПараметр("ВсеИзмерения", ВсеИзмерения);
 Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.Премия);
 БазыПремии = Запрос.Выполнить().Выгрузить();
 Для Каждого График Из ДанныеГрафика Цикл
  Запись = Движения.Начисления[График.НомерСтроки - 1]; Знак = ?(Запись.Сторно, -1, 1);
  Если Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
   СтрокиБазы = БазыПремии.НайтиСтроки(Новый Структура("НомерСтроки", График.НомерСтроки));
   База = ?(СтрокиБазы.Количество() = 0, 0, СтрокиБазы[0].База);
   Если Не Запись.Сторно Тогда Запись.НормаМесяца = График.НормаМесяца; Запись.БазаПремии = База; КонецЕсли;
   Запись.Результат = ?(Запись.НормаМесяца = 0, 0, Окр(Запись.БазаПремии * Запись.Процент / 100 * График.Часы / Запись.НормаМесяца * Знак * Запись.Кратность, 2));
  КонецЕсли;
 КонецЦикла;
 Движения.Начисления.Записать(, Истина);
 ЗаписатьБазу();
 Запрос.Текст = "ВЫБРАТЬ Начисления.НомерСтроки КАК НомерСтроки,
 | ЕСТЬNULL(График.ДниФактическийПериодДействия, 0) КАК Дни,
 | ЕСТЬNULL(База.РезультатБаза, 0) КАК База, ЕСТЬNULL(База.ДниБаза, 0) КАК ДниБазы
 |ИЗ РегистрРасчета.Начисления КАК Начисления
 | ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор = &Регистратор И ВидРасчета = &Командировка) КАК График
 | ПО Начисления.НомерСтроки = График.НомерСтроки И Начисления.Регистратор = График.Регистратор
 | ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.БазаНачислений.БазаБазаНачислений(&Измерения, &Измерения,, Регистратор = &Регистратор И ВидРасчета = &Командировка) КАК База
 | ПО Начисления.НомерСтроки = База.НомерСтроки И Начисления.Регистратор = База.Регистратор
 |ГДЕ Начисления.Регистратор = &Регистратор И Начисления.ВидРасчета = &Командировка
 |УПОРЯДОЧИТЬ ПО Начисления.ПериодДействияНачало, Начисления.НомерСтроки";
