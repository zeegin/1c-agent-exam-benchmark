Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Если Не ЗначениеЗаполнено(ПодразделениеИсточник) Или Не ЗначениеЗаполнено(ПодразделениеПолучатель) Тогда Отказ = Истина; Сообщить("Укажите подразделения отправки и получения"); Возврат; КонецЕсли;
 Если Изделия.Количество() = 0 Тогда Отказ = Истина; Сообщить("Добавьте собираемые изделия"); Возврат; КонецЕсли;
 УчетЗапасов.Заблокировать();
 СтарыеЗапасы = УчетЗапасов.ЗатронутыеДвижения(ЭтотОбъект);
 УчетЗапасов.Подготовить(ЭтотОбъект, Истина);
 Блоки = Новый Массив;
 Для Каждого Изделие Из Изделия Цикл Если Блоки.Найти(Изделие.Номенклатура) = Неопределено Тогда Блоки.Добавить(Изделие.Номенклатура); КонецЕсли; КонецЦикла;
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ Спецификации.СистемныйБлок, Спецификации.Деталь,
 | Спецификации.Свойство, Спецификации.Количество
 |ИЗ РегистрСведений.Спецификации КАК Спецификации
 | ВНУТРЕННЕЕ СОЕДИНЕНИЕ
 | (ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период
 |  ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Дата И СистемныйБлок В (&Блоки) СГРУППИРОВАТЬ ПО СистемныйБлок) КАК Актуальные
 | ПО Спецификации.СистемныйБлок = Актуальные.СистемныйБлок И Спецификации.Период = Актуальные.Период";
 Запрос.УстановитьПараметр("Дата", Дата);
 Запрос.УстановитьПараметр("Блоки", Блоки);
 Спецификации = Запрос.Выполнить().Выгрузить();
 Детали = Новый Массив; Подразделения = Новый Массив; Подразделения.Добавить(ПодразделениеИсточник);
 Для Каждого Стр Из Спецификации Цикл Если Детали.Найти(Стр.Деталь) = Неопределено Тогда Детали.Добавить(Стр.Деталь); КонецЕсли; КонецЦикла;
 Для Каждого Стр Из ДополнительныеДетали Цикл Если Детали.Найти(Стр.Номенклатура) = Неопределено Тогда Детали.Добавить(Стр.Номенклатура); КонецЕсли; КонецЦикла;
 Партии = УчетЗапасов.ОстаткиДляРасхода(ЭтотОбъект, Подразделения, Детали);
 СтоимостьДополнений = 0; ВсегоИзделий = 0;
 РасчетИзделий = Новый ТаблицаЗначений; РасчетИзделий.Колонки.Добавить("Номенклатура");
 РасчетИзделий.Колонки.Добавить("Количество"); РасчетИзделий.Колонки.Добавить("ПрямаяСтоимость");
 Для Каждого Изделие Из Изделия Цикл
  Если Не ЗначениеЗаполнено(Изделие.Номенклатура) Или Изделие.Количество <= 0 Тогда Отказ = Истина; Сообщить("Укажите изделие и положительное количество"); Продолжить; КонецЕсли;
  ВсегоИзделий = ВсегоИзделий + Изделие.Количество;
  СтрокиСпецификации = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Изделие.Номенклатура));
  Если СтрокиСпецификации.Количество() = 0 Тогда Отказ = Истина; Сообщить("Не задана спецификация: " + Строка(Изделие.Номенклатура)); КонецЕсли;
  Расчет = РасчетИзделий.Добавить(); Расчет.Номенклатура = Изделие.Номенклатура; Расчет.Количество = Изделие.Количество; Расчет.ПрямаяСтоимость = 0;
  Для Каждого Стр Из СтрокиСпецификации Цикл
   Расчет.ПрямаяСтоимость = Расчет.ПрямаяСтоимость + УчетЗапасов.Списать(ЭтотОбъект, Партии, ПодразделениеИсточник, Стр.Деталь, Стр.Свойство, Стр.Количество * Изделие.Количество, Истина, Отказ);
  КонецЦикла;
 КонецЦикла;
 Для Каждого Стр Из ДополнительныеДетали Цикл
  СтоимостьДополнений = СтоимостьДополнений + УчетЗапасов.Списать(ЭтотОбъект, Партии, ПодразделениеИсточник, Стр.Номенклатура, Стр.Свойство, Стр.Количество, Истина, Отказ);
 КонецЦикла;
 Если Отказ Или ВсегоИзделий = 0 Тогда Возврат; КонецЕсли;
 ОстатокДополнений = СтоимостьДополнений; ОстатокКоличество = ВсегоИзделий;
 Для Каждого Расчет Из РасчетИзделий Цикл
  Если ОстатокКоличество = Расчет.Количество Тогда ДоляДополнений = ОстатокДополнений;
  Иначе ДоляДополнений = Окр(ОстатокДополнений * Расчет.Количество / ОстатокКоличество, 2); КонецЕсли;
  УчетЗапасов.Приход(ЭтотОбъект, ПодразделениеПолучатель, Расчет.Номенклатура, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), Расчет.Количество, Расчет.ПрямаяСтоимость + ДоляДополнений);
  ОстатокДополнений = ОстатокДополнений - ДоляДополнений; ОстатокКоличество = ОстатокКоличество - Расчет.Количество;
 КонецЦикла;
 Для Каждого Подразделение Из Подразделения Цикл Если СтарыеЗапасы.Подразделения.Найти(Подразделение) = Неопределено Тогда СтарыеЗапасы.Подразделения.Добавить(Подразделение); КонецЕсли; КонецЦикла;
 Если СтарыеЗапасы.Подразделения.Найти(ПодразделениеПолучатель) = Неопределено Тогда СтарыеЗапасы.Подразделения.Добавить(ПодразделениеПолучатель); КонецЕсли;
 Для Каждого Товар Из Детали Цикл Если СтарыеЗапасы.Номенклатура.Найти(Товар) = Неопределено Тогда СтарыеЗапасы.Номенклатура.Добавить(Товар); КонецЕсли; КонецЦикла;
 Для Каждого Товар Из Блоки Цикл Если СтарыеЗапасы.Номенклатура.Найти(Товар) = Неопределено Тогда СтарыеЗапасы.Номенклатура.Добавить(Товар); КонецЕсли; КонецЦикла;
 УчетЗапасов.ПроверитьОстаткиПослеЗаписи(ЭтотОбъект, СтарыеЗапасы.Подразделения, СтарыеЗапасы.Номенклатура, Отказ, СтарыеЗапасы.Начало);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
 УчетЗапасов.Заблокировать(); СтарыеЗапасы = УчетЗапасов.ЗатронутыеДвижения(ЭтотОбъект); УчетЗапасов.Подготовить(ЭтотОбъект, Истина);
 УчетЗапасов.ПроверитьОстаткиПослеЗаписи(ЭтотОбъект, СтарыеЗапасы.Подразделения, СтарыеЗапасы.Номенклатура, Отказ, СтарыеЗапасы.Начало);
КонецПроцедуры
