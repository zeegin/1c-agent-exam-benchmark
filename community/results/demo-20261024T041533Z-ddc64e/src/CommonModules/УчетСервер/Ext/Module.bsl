Функция ЗапросТаблица(Текст, Параметры = Неопределено) Экспорт
 З = Новый Запрос(Текст);
 Если Параметры <> Неопределено Тогда
  Для Каждого П Из Параметры Цикл З.УстановитьПараметр(П.Ключ, П.Значение); КонецЦикла;
 КонецЕсли;
 Возврат З.Выполнить().Выгрузить();
КонецФункции

Процедура Блокировать(Имя) Экспорт
 Б = Новый БлокировкаДанных;
 Б.Добавить(Имя).Режим = РежимБлокировкиДанных.Исключительный;
 Б.Заблокировать();
КонецПроцедуры

Функция СуммаСтроки(Стр) Экспорт
 Если Стр.Сумма <> 0 Тогда Возврат Стр.Сумма; КонецЕсли;
 Возврат Окр(Стр.Цена * Стр.Количество, 2);
КонецФункции

Функция ОстаткиЗапасов(Момент) Экспорт
 Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия, КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость ИЗ РегистрНакопления.Запасы.Остатки(&Момент, ) УПОРЯДОЧИТЬ ПО Партия.Дата, Партия", Новый Структура("Момент", Момент));
КонецФункции

Функция Политики(Дата) Экспорт
 Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, )", Новый Структура("Дата", Дата));
КонецФункции

Функция Списать(Набор, Остатки, Дата, Подразделение, Товар, Свойство, Количество, Метод, Отказ) Экспорт
 Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
 Строки = Остатки.НайтиСтроки(Отбор);
 Доступно = 0; Стоимость = 0;
 Для Каждого Стр Из Строки Цикл Доступно = Доступно + Стр.Количество; Стоимость = Стоимость + Стр.Стоимость; КонецЦикла;
 Если Количество <= 0 Или Доступно < Количество Тогда
  Отказ = Истина; Сообщить("Недостаточно запасов: " + Строка(Товар) + ", требуется " + Количество + ", доступно " + Доступно); Возврат 0;
 КонецЕсли;
 Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
  СписаннаяСтоимость=?(Количество=Доступно,Стоимость,Окр(Стоимость*Количество/Доступно,2));
  ОстКоличество=Доступно-Количество; ОстСтоимость=Стоимость-СписаннаяСтоимость; ОстСписать=Количество;
  Для Каждого Стр Из Строки Цикл
   К=Мин(ОстСписать,Стр.Количество); ОстСписать=ОстСписать-К;
   НовоеКоличество=Стр.Количество-К;
   НоваяСтоимость=?(ОстКоличество=0,0,?(НовоеКоличество=ОстКоличество,ОстСтоимость,Окр(ОстСтоимость*НовоеКоличество/ОстКоличество,2)));
   С=Стр.Стоимость-НоваяСтоимость;
   Если К<>0 Или С<>0 Тогда
    Д=Набор.Добавить();Д.Период=Дата;Д.ВидДвижения=ВидДвиженияНакопления.Расход;
    ЗаполнитьЗначенияСвойств(Д,Стр,"Подразделение,Номенклатура,Свойство,Партия");Д.Количество=К;Д.Стоимость=С;
   КонецЕсли;
   Стр.Количество=НовоеКоличество;Стр.Стоимость=НоваяСтоимость;ОстКоличество=ОстКоличество-НовоеКоличество;ОстСтоимость=ОстСтоимость-НоваяСтоимость;
  КонецЦикла;
  Возврат СписаннаяСтоимость;
 КонецЕсли;
 Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
  Обратные = Новый Массив;
  Индекс = Строки.Количество()-1;
  Пока Индекс >= 0 Цикл Обратные.Добавить(Строки[Индекс]); Индекс = Индекс-1; КонецЦикла;
  Строки = Обратные;
 КонецЕсли;
 Осталось = Количество; Итого = 0;
 Для Каждого Стр Из Строки Цикл
  Если Осталось = 0 Тогда Прервать; КонецЕсли;
  Если Стр.Количество <= 0 Тогда Продолжить; КонецЕсли;
  Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
   К = ?(Количество = Доступно, Стр.Количество, Количество * Стр.Количество / Доступно);
   С = ?(К = Стр.Количество, Стр.Стоимость, Окр(Стр.Стоимость * К / Стр.Количество, 2));
  Иначе
   К = Мин(Осталось, Стр.Количество);
   С = ?(К = Стр.Количество, Стр.Стоимость, Окр(Стр.Стоимость * К / Стр.Количество, 2));
  КонецЕсли;
  Д = Набор.Добавить(); Д.Период = Дата; Д.ВидДвижения = ВидДвиженияНакопления.Расход;
  ЗаполнитьЗначенияСвойств(Д, Стр, "Подразделение,Номенклатура,Свойство,Партия"); Д.Количество = К; Д.Стоимость = С;
  Стр.Количество = Стр.Количество-К; Стр.Стоимость = Стр.Стоимость-С;
  Осталось = Осталось-К; Итого = Итого+С;
 КонецЦикла;
 Возврат Итого;
КонецФункции

Процедура Продажа(Набор, Дата, Номенклатура, Продано, Количество, Себестоимость, Выручка, Раздел) Экспорт
 Д = Набор.Добавить(); Д.Период=Дата; Д.Номенклатура=Номенклатура; Д.Продано=Продано;
 Д.Количество=Количество; Д.Себестоимость=Себестоимость; Д.Выручка=Выручка; Д.Раздел=Раздел;
КонецПроцедуры

Процедура Проводка(Набор, Дата, Дт, Кт, Товар, Склад, Количество, Сумма) Экспорт
 Д=Набор.Добавить(); Д.Период=Дата; Д.СчетДт=Дт; Д.СчетКт=Кт; Д.Сумма=Сумма;
 Если Дт=ПланыСчетов.Управленческий.Товары Тогда Д.НоменклатураДт=Товар; Д.СкладДт=Склад; Д.КоличествоДт=Количество; КонецЕсли;
 Если Кт=ПланыСчетов.Управленческий.Товары Тогда Д.НоменклатураКт=Товар; Д.СкладКт=Склад; Д.КоличествоКт=Количество; КонецЕсли;
КонецПроцедуры

Функция АналогиТовара(Товар, Связи, ВсеТовары) Экспорт
 Список=Новый Массив; Список.Добавить(Товар); Индекс=0;
 Пока Индекс<Список.Количество() Цикл
  Текущий=Список[Индекс];
  Для Каждого С Из Связи Цикл
   Если С.Товар=Текущий И Список.Найти(С.Аналог)=Неопределено Тогда Список.Добавить(С.Аналог); КонецЕсли;
   Если С.Аналог=Текущий И Список.Найти(С.Товар)=Неопределено Тогда Список.Добавить(С.Товар); КонецЕсли;
  КонецЦикла; Индекс=Индекс+1;
 КонецЦикла;
 Результат=Новый Массив; Результат.Добавить(Товар);
 Для Каждого С Из ВсеТовары Цикл
  Если С.Ссылка<>Товар И Список.Найти(С.Ссылка)<>Неопределено Тогда Результат.Добавить(С.Ссылка); КонецЕсли;
 КонецЦикла; Возврат Результат;
КонецФункции

Процедура НастроитьРасчеты() Экспорт
 Тариф=ПланыВидовРасчета.ОсновныеНачисления.Тариф;
 Премия=ПланыВидовРасчета.ОсновныеНачисления.Премия;
 Командировка=ПланыВидовРасчета.ОсновныеНачисления.Командировка;
 Для Каждого Вид Из Новый Массив Цикл КонецЦикла;
 О=Тариф.ПолучитьОбъект();
 Если О.ВытесняющиеВидыРасчета.Найти(Командировка,"ВидРасчета")=Неопределено Тогда
  О.ВытесняющиеВидыРасчета.Добавить().ВидРасчета=Командировка; О.Записать();
 КонецЕсли;
 О=Премия.ПолучитьОбъект(); Изменен=Ложь;
 Если О.ВытесняющиеВидыРасчета.Найти(Командировка,"ВидРасчета")=Неопределено Тогда О.ВытесняющиеВидыРасчета.Добавить().ВидРасчета=Командировка; Изменен=Истина; КонецЕсли;
 Если О.БазовыеВидыРасчета.Найти(Тариф,"ВидРасчета")=Неопределено Тогда О.БазовыеВидыРасчета.Добавить().ВидРасчета=Тариф; Изменен=Истина; КонецЕсли;
 Если Изменен Тогда О.Записать(); КонецЕсли;
 О=Командировка.ПолучитьОбъект(); Изменен=Ложь;
 Виды=Новый Массив; Виды.Добавить(Тариф); Виды.Добавить(Премия); Виды.Добавить(Командировка);
 Для Каждого Вид Из Виды Цикл
  Если О.БазовыеВидыРасчета.Найти(Вид,"ВидРасчета")=Неопределено Тогда О.БазовыеВидыРасчета.Добавить().ВидРасчета=Вид; Изменен=Истина; КонецЕсли;
 КонецЦикла;
 Если Изменен Тогда О.Записать(); КонецЕсли;
КонецПроцедуры

Функция БазаРасчета(Регистратор, ИменаИзмерений) Экспорт
 Измерения=СтрРазделить(ИменаИзмерений,",");
 Возврат ЗапросТаблица("ВЫБРАТЬ НомерСтроки, РезультатБаза, ДниБаза ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения,&Измерения,,Регистратор=&Регистратор)",Новый Структура("Измерения,Регистратор",Измерения,Регистратор));
КонецФункции

Процедура РассчитатьНабор(Набор) Экспорт
 Если Набор.Количество()=0 Тогда Возврат; КонецЕсли;
 Регистратор=Набор.Отбор.Регистратор.Значение;
 Графики=ЗапросТаблица("ВЫБРАТЬ НомерСтроки, ЕСТЬNULL(ЗначениеФактическийПериодДействия,0) КАК Часы, ЕСТЬNULL(ДниФактическийПериодДействия,0) КАК Дни, ЕСТЬNULL(ДниПериодДействия,0) КАК Норма ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор=&Регистратор)",Новый Структура("Регистратор",Регистратор));
 Ставки=ЗапросТаблица("ВЫБРАТЬ Период, Сотрудник, Ставка ИЗ РегистрСведений.Ставки УПОРЯДОЧИТЬ ПО Период");
 Шкала=ЗапросТаблица("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж");
 Сотрудники=ЗапросТаблица("ВЫБРАТЬ Ссылка, НачалоСтажа ИЗ Справочник.ФизическиеЛица");
 Для Каждого Стр Из Набор Цикл
  Если Стр.ВидРасчета<>ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда Продолжить; КонецЕсли;
  Г=Графики.Найти(Стр.НомерСтроки,"НомерСтроки"); Если Г=Неопределено Тогда Продолжить; КонецЕсли;
  Ставка=0;
  Для Каждого С Из Ставки Цикл
   Если С.Сотрудник=Стр.Сотрудник И С.Период<=НачалоМесяца(Стр.ПериодДействияНачало) Тогда Ставка=С.Ставка; КонецЕсли;
  КонецЦикла;
  Стр.Результат=Окр(Ставка*Г.Часы,2)*?(Стр.Сторно,-1,1); Стр.Дни=Г.Дни*?(Стр.Сторно,-1,1);
 КонецЦикла;
 Набор.Записать(Истина);
 БазаПодразделения=БазаРасчета(Регистратор,"Подразделение");
 БазаСотрудника=БазаРасчета(Регистратор,"Сотрудник,Подразделение");
 БазаКомандировки=БазаРасчета(Регистратор,"Сотрудник");
 Для Каждого Стр Из Набор Цикл
  Г=Графики.Найти(Стр.НомерСтроки,"НомерСтроки"); Если Г=Неопределено Тогда Продолжить; КонецЕсли;
  Если Стр.ВидРасчета=ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
   Б=БазаПодразделения.Найти(Стр.НомерСтроки,"НомерСтроки"); Своя=БазаСотрудника.Найти(Стр.НомерСтроки,"НомерСтроки");
   СуммаБазы=0; Если Б<>Неопределено Тогда СуммаБазы=Б.РезультатБаза; КонецЕсли;
   Если Своя<>Неопределено Тогда СуммаБазы=СуммаБазы-Своя.РезультатБаза; КонецЕсли;
   Сотрудник=Сотрудники.Найти(Стр.Сотрудник,"Ссылка"); Стаж=0;
   Если Сотрудник<>Неопределено И ЗначениеЗаполнено(Сотрудник.НачалоСтажа) Тогда
    Стаж=Год(Стр.ПериодДействияНачало)-Год(Сотрудник.НачалоСтажа);
    Если ДобавитьМесяц(Сотрудник.НачалоСтажа,Стаж*12)>Стр.ПериодДействияНачало Тогда Стаж=Стаж-1; КонецЕсли;
   КонецЕсли;
   Процент=0; Для Каждого С Из Шкала Цикл Если С.Стаж<=Стаж Тогда Процент=С.Процент; КонецЕсли; КонецЦикла;
   Стр.Стаж=Стаж; Стр.Процент=Процент;
   Стр.Результат=?(Г.Норма=0,0,Окр(СуммаБазы*Процент/100*Г.Дни/Г.Норма,2))*?(Стр.Сторно,-1,1); Стр.Дни=0;
  ИначеЕсли Стр.ВидРасчета=ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
   Б=БазаКомандировки.Найти(Стр.НомерСтроки,"НомерСтроки"); Стр.Результат=0;
   Если Б<>Неопределено И Б.ДниБаза<>0 Тогда Стр.Результат=Окр(Б.РезультатБаза/Б.ДниБаза*Г.Дни,2); КонецЕсли;
   Стр.Дни=Г.Дни;
  КонецЕсли;
 КонецЦикла;
 Набор.Записать(Истина);
КонецПроцедуры


Функция ДемоЭлемент(Менеджер, Имя) Экспорт
 С=Менеджер.НайтиПоНаименованию(Имя,Истина);
 Если С.Пустая() Тогда О=Менеджер.СоздатьЭлемент(); О.Наименование=Имя; О.Записать(); С=О.Ссылка; КонецЕсли;
 Возврат С;
КонецФункции

Процедура ДемонстрационныеДанные() Экспорт
 Цех=ДемоЭлемент(Справочники.Подразделения,"Демо основной цех");
 Склад=ДемоЭлемент(Справочники.Склады,"Демо склад");
 Деталь=ДемоЭлемент(Справочники.Номенклатура,"Демо видеокарта");
