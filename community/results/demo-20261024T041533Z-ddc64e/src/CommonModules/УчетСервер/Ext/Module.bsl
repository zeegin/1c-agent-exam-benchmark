 Блок=ДемоЭлемент(Справочники.Номенклатура,"Демо системный блок");
 О=Деталь.ПолучитьОбъект();О.Артикул="001";О.Записать();О=Аналог.ПолучитьОбъект();О.Артикул="002";О.Записать();
 Свойство=ДемоЭлемент(Справочники.Свойства,"Демо ASUS");
 О=Свойство.ПолучитьОбъект();О.Номенклатура=Деталь;О.Записать();
 Х=ДемоЭлемент(ПланыВидовХарактеристик.СвойстваОбъектов,"Производитель");
 О=Х.ПолучитьОбъект();О.ТипЗначения=Новый ОписаниеТипов("Строка");О.Записать();
 З=РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();З.Свойство=Свойство;З.Характеристика=Х;З.Значение="ASUS";З.Записать();
 З=РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();З.Период=Дата(2024,1,1);З.Подразделение=Цех;З.Метод=Перечисления.УчетнаяПолитика.ФИФО;З.Записать();
 З=РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();З.Период=Дата(2024,1,1);З.Блок=Блок;З.Номенклатура=Деталь;З.Свойство=Свойство;З.Количество=2;З.Записать();
 З=РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();З.Товар=Деталь;З.Аналог=Аналог;З.Записать();
 Приход=Документы.ПриходнаяНакладная.СоздатьДокумент();Приход.Дата=Дата(2024,1,2,10,0,0);Приход.Склад=Склад;Приход.Подразделение=Цех;
 Стр=Приход.СписокНоменклатуры.Добавить();Стр.Номенклатура=Деталь;Стр.Свойство=Свойство;Стр.Количество=20;Стр.Цена=100;Стр.Сумма=2000;
 Стр=Приход.СписокНоменклатуры.Добавить();Стр.Номенклатура=Аналог;Стр.Количество=10;Стр.Цена=100;Стр.Сумма=1000;
 Приход.Записать(РежимЗаписиДокумента.Проведение);
 Сборка=Документы.Сборка.СоздатьДокумент();Сборка.Дата=Дата(2024,1,3,10,0,0);Сборка.Источник=Цех;Сборка.Получатель=Цех;
 Стр=Сборка.Блоки.Добавить();Стр.Номенклатура=Блок;Стр.Количество=2;Сборка.Записать(РежимЗаписиДокумента.Проведение);
 Продажа=Документы.РасходнаяНакладная.СоздатьДокумент();Продажа.Дата=Дата(2024,1,4,10,0,0);Продажа.Склад=Склад;Продажа.Подразделение=Цех;
 Стр=Продажа.СписокНоменклатуры.Добавить();Стр.Номенклатура=Деталь;Стр.Свойство=Свойство;Стр.Количество=3;Стр.Цена=150;Продажа.Записать(РежимЗаписиДокумента.Проведение);
 Продажа=Документы.РасходнаяНакладная.СоздатьДокумент();Продажа.Дата=Дата(2024,1,5,10,0,0);Продажа.Подразделение=Цех;
