&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
 Элементы.Менеджер.УстановитьДействие("ПриИзменении","МенеджерПриИзменении");
 ОбновитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
 ОбновитьПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьДополнительныеПоля(Получатель)
 Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
  ИмяПоля="Сведение"+СтрЗаменить(Строка(Стр.ВидСведений.УникальныйИдентификатор()),"-","");
  Если Элементы.Найти(ИмяПоля)<>Неопределено Тогда Стр.Значение=ЭтотОбъект[ИмяПоля]; КонецЕсли;
 КонецЦикла;
 Если Получатель<>Неопределено Тогда
  Получатель.ДополнительныеСведения.Очистить();
  Для Каждого Стр Из Объект.ДополнительныеСведения Цикл ЗаполнитьЗначенияСвойств(Получатель.ДополнительныеСведения.Добавить(),Стр); КонецЦикла;
 КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоля()
 СохранитьДополнительныеПоля(Неопределено);
 Удаляемые=Новый Массив;
 Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
  ИмяПоля="Сведение"+СтрЗаменить(Строка(Стр.ВидСведений.УникальныйИдентификатор()),"-","");
  Поле=Элементы.Найти(ИмяПоля);
  Если Поле<>Неопределено Тогда Элементы.Удалить(Поле);Удаляемые.Добавить(ИмяПоля);КонецЕсли;
 КонецЦикла;
 Если Удаляемые.Количество()>0 Тогда ИзменитьРеквизиты(Новый Массив,Удаляемые);КонецЕсли;
 Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат;КонецЕсли;
 Список=Объект.Менеджер.ДополнительныеСведения.Выгрузить();
 Для Каждого Стр Из Список Цикл
  Если Не ЗначениеЗаполнено(Стр.ВидСведений) Тогда Продолжить;КонецЕсли;
  ИмяПоля="Сведение"+СтрЗаменить(Строка(Стр.ВидСведений.УникальныйИдентификатор()),"-","");
  Если Элементы.Найти(ИмяПоля)<>Неопределено Тогда Продолжить;КонецЕсли;
  Новые=Новый Массив;Новые.Добавить(Новый РеквизитФормы(ИмяПоля,Стр.ВидСведений.ТипЗначения));ИзменитьРеквизиты(Новые);
  Поле=Элементы.Добавить(ИмяПоля,Тип("ПолеФормы"));Поле.Вид=ВидПоляФормы.ПолеВвода;Поле.ПутьКДанным=ИмяПоля;Поле.Заголовок=Строка(Стр.ВидСведений);
  Найденные=Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений",Стр.ВидСведений));
  Если Найденные.Количество()=0 Тогда СтрокаЗначения=Объект.ДополнительныеСведения.Добавить();СтрокаЗначения.ВидСведений=Стр.ВидСведений;Иначе СтрокаЗначения=Найденные[0];КонецЕсли;
  ЭтотОбъект[ИмяПоля]=СтрокаЗначения.Значение;
 КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
 СохранитьДополнительныеПоля(ТекущийОбъект);
КонецПроцедуры

