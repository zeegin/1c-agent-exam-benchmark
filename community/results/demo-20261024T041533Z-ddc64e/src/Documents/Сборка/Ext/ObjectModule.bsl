Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Движения.Запасы.Записывать=Истина; УчетСервер.Блокировать("РегистрНакопления.Запасы"); Движения.Запасы.Записать();
 Запасы=УчетСервер.ОстаткиЗапасов(Новый Граница(МоментВремени(),ВидГраницы.Исключая));
 Спецификации=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Блок, Номенклатура, Свойство, Количество ИЗ РегистрСведений.Спецификации.СрезПоследних(&Дата, )",Новый Структура("Дата",Дата));
 ОбщаяСтоимость=0; ОбщееКоличество=0; СтоимостиБлоков=Новый Массив;
 Для Каждого Стр Из Блоки Цикл
  Если Стр.Количество<=0 Тогда Отказ=Истина; Возврат; КонецЕсли;
  Состав=Спецификации.НайтиСтроки(Новый Структура("Блок",Стр.Номенклатура));
  Если Состав.Количество()=0 Тогда Отказ=Истина; Сообщить("Нет спецификации: "+Строка(Стр.Номенклатура)); Возврат; КонецЕсли;
  СтоимостьБлока=0;
  Для Каждого Деталь Из Состав Цикл
   СтоимостьБлока=СтоимостьБлока+УчетСервер.Списать(Движения.Запасы,Запасы,Дата,Источник,Деталь.Номенклатура,Деталь.Свойство,Деталь.Количество*Стр.Количество,Перечисления.УчетнаяПолитика.Средняя,Отказ);
  КонецЦикла;
  СтоимостиБлоков.Добавить(СтоимостьБлока);ОбщаяСтоимость=ОбщаяСтоимость+СтоимостьБлока;
  ОбщееКоличество=ОбщееКоличество+Стр.Количество;
 КонецЦикла;
 СтоимостьСпецификаций=ОбщаяСтоимость;
 Для Каждого Деталь Из Дополнительно Цикл
  ОбщаяСтоимость=ОбщаяСтоимость+УчетСервер.Списать(Движения.Запасы,Запасы,Дата,Источник,Деталь.Номенклатура,Деталь.Свойство,Деталь.Количество,Перечисления.УчетнаяПолитика.Средняя,Отказ);
 КонецЦикла;
 Если Отказ Или ОбщееКоличество=0 Тогда Отказ=Истина; Возврат; КонецЕсли;
 ДопСтоимость=ОбщаяСтоимость-СтоимостьСпецификаций;ОстСтоимость=ДопСтоимость; ОстКоличество=ОбщееКоличество;ИндексБлока=0;
 Для Каждого Стр Из Блоки Цикл
  ДопС=?(Стр.Количество=ОстКоличество,ОстСтоимость,Окр(ДопСтоимость*Стр.Количество/ОбщееКоличество,2));С=СтоимостиБлоков[ИндексБлока]+ДопС;ИндексБлока=ИндексБлока+1;
  Д=Движения.Запасы.Добавить(); Д.Период=Дата; Д.ВидДвижения=ВидДвиженияНакопления.Приход; Д.Подразделение=Получатель; Д.Номенклатура=Стр.Номенклатура; Д.Партия=Ссылка; Д.Количество=Стр.Количество; Д.Стоимость=С;
  ОстСтоимость=ОстСтоимость-ДопС; ОстКоличество=ОстКоличество-Стр.Количество;
 КонецЦикла;
КонецПроцедуры
