Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Движения.Запасы.Записывать=Истина; Движения.Учет.Записывать=Истина; Движения.Продажи.Записывать=Истина;
 УчетСервер.Блокировать("РегистрНакопления.Запасы"); УчетСервер.Блокировать("РегистрБухгалтерии.Учет");
 Движения.Запасы.Записать(); Движения.Учет.Записать(); Движения.Продажи.Записать();
 Момент=Новый Граница(МоментВремени(),ВидГраницы.Исключая);
 Запасы=УчетСервер.ОстаткиЗапасов(Момент); Политики=УчетСервер.Политики(Дата);
 Если ЗначениеЗаполнено(Склад) Тогда
  Остатки=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Стоимость ИЗ РегистрБухгалтерии.Учет.Остатки(&Момент, Счет = &Счет, Склад = &Склад)",Новый Структура("Момент,Счет,Склад",Момент,ПланыСчетов.Управленческий.Товары,Склад));
  Средние=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Номенклатура, СУММА(КоличествоОстаток) КАК Количество, СУММА(СуммаОстаток) КАК Стоимость ИЗ РегистрБухгалтерии.Учет.Остатки(&Момент, Счет = &Счет, ) СГРУППИРОВАТЬ ПО Номенклатура",Новый Структура("Момент,Счет",Момент,ПланыСчетов.Управленческий.Товары));
  Связи=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
  Товары=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Ссылка, Артикул ИЗ Справочник.Номенклатура УПОРЯДОЧИТЬ ПО Артикул, Ссылка");
 КонецЕсли;
 Для Каждого Стр Из СписокНоменклатуры Цикл
  Если Стр.Количество<=0 Тогда Отказ=Истина; Возврат; КонецЕсли;
  Выручка=УчетСервер.СуммаСтроки(Стр);
  Подр=?(ЗначениеЗаполнено(Стр.Подразделение),Стр.Подразделение,Подразделение);
  Если ЗначениеЗаполнено(Подр) Тогда
   П=Политики.Найти(Подр,"Подразделение"); Метод=Перечисления.УчетнаяПолитика.Средняя;
   Если П<>Неопределено Тогда Метод=П.Метод; КонецЕсли;
   Стоимость=УчетСервер.Списать(Движения.Запасы,Запасы,Дата,Подр,Стр.Номенклатура,Стр.Свойство,Стр.Количество,Метод,Отказ);
   Если Отказ Тогда Возврат; КонецЕсли;
   УчетСервер.Продажа(Движения.Продажи,Дата,Стр.Номенклатура,Стр.Номенклатура,Стр.Количество,Стоимость,Выручка,"ОУ");
  КонецЕсли;
  Если ЗначениеЗаполнено(Склад) Тогда
   Кандидаты=УчетСервер.АналогиТовара(Стр.Номенклатура,Связи,Товары); Осталось=Стр.Количество; ОстВыручка=Выручка;
   Для Каждого Товар Из Кандидаты Цикл
    О=Остатки.Найти(Товар,"Номенклатура"); Ср=Средние.Найти(Товар,"Номенклатура");
    Если О=Неопределено Или Ср=Неопределено Тогда Продолжить; КонецЕсли;
    К=Мин(Осталось,О.Количество); Если К<=0 Тогда Продолжить; КонецЕсли;
    С=?(К=Ср.Количество,Ср.Стоимость,Окр(К*Ср.Стоимость/Ср.Количество,2));
    В=?(К=Осталось,ОстВыручка,Окр(Выручка*К/Стр.Количество,2));
    УчетСервер.Проводка(Движения.Учет,Дата,ПланыСчетов.Управленческий.ПрибылиУбытки,ПланыСчетов.Управленческий.Товары,Товар,Склад,К,С);
    УчетСервер.Продажа(Движения.Продажи,Дата,Стр.Номенклатура,Товар,К,С,В,"БУ");
    О.Количество=О.Количество-К; Ср.Количество=Ср.Количество-К; Ср.Стоимость=Ср.Стоимость-С;
    Осталось=Осталось-К; ОстВыручка=ОстВыручка-В;
    Если Осталось=0 Тогда Прервать; КонецЕсли;
   КонецЦикла;
   Если Осталось>0 Тогда Отказ=Истина; Сообщить("Не хватает товара и аналогов: "+Строка(Стр.Номенклатура)); Возврат; КонецЕсли;
   УчетСервер.Проводка(Движения.Учет,Дата,ПланыСчетов.Управленческий.Покупатели,ПланыСчетов.Управленческий.ПрибылиУбытки,Стр.Номенклатура,Склад,0,Выручка);
  КонецЕсли;
 КонецЦикла;
КонецПроцедуры
