&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПерестроитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    ИзменитьМенеджераНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИзменитьМенеджераНаСервере()
    СохранитьПоляВОбъект(Объект);
    ПерестроитьПоля();
КонецПроцедуры

&НаСервере
Процедура ПерестроитьПоля()
    УдаляемыеРеквизиты = Новый Массив;
    Для Каждого С Из СоответствиеПолей Цикл
        УдаляемыеРеквизиты.Добавить(С.Имя);
        Поле = Элементы.Найти(С.Имя);
        Если Поле <> Неопределено Тогда Элементы.Удалить(Поле); КонецЕсли;
    КонецЦикла;
    СоответствиеПолей.Очистить();
    НовыеРеквизиты = Новый Массив;
    Если ЗначениеЗаполнено(Объект.Менеджер) Тогда
        Сведения = Объект.Менеджер.ДополнительныеСведения.Выгрузить();
        Для Каждого С Из Сведения Цикл
            Вид = С.ВидСведения;
            Если Не ЗначениеЗаполнено(Вид) Тогда Продолжить; КонецЕсли;
            Если НайтиВид(СоответствиеПолей, Вид) <> Неопределено Тогда Продолжить; КонецЕсли;
            ИмяПоля = "Сведение" + СтрЗаменить(Строка(Вид.УникальныйИдентификатор()), "-", "");
            НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяПоля, Вид.ТипЗначения, , Вид.Наименование));
            СтрПоля = СоответствиеПолей.Добавить(); СтрПоля.Имя = ИмяПоля; СтрПоля.ВидСведения = Вид;
        КонецЦикла;
    КонецЕсли;
    ИзменитьРеквизиты(НовыеРеквизиты, УдаляемыеРеквизиты);
    Для Каждого С Из СоответствиеПолей Цикл
        Поле = Элементы.Добавить(С.Имя, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
        Поле.Вид = ВидПоляФормы.ПолеВвода; Поле.ПутьКДанным = С.Имя; Поле.Заголовок = С.ВидСведения.Наименование;
        Сохраненное = НайтиВид(Объект.ДополнительныеСведения, С.ВидСведения);
        Если Сохраненное <> Неопределено Тогда
            Если С.ВидСведения.ТипЗначения.СодержитТип(ТипЗнч(Сохраненное.Значение)) Тогда ЭтотОбъект[С.Имя] = Сохраненное.Значение; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьПоляВОбъект(ОбъектПриемник)
    Для Каждого С Из СоответствиеПолей Цикл
        СтрЗначения = НайтиВид(ОбъектПриемник.ДополнительныеСведения, С.ВидСведения);
        Если СтрЗначения = Неопределено Тогда
            СтрЗначения = ОбъектПриемник.ДополнительныеСведения.Добавить(); СтрЗначения.ВидСведения = С.ВидСведения;
        КонецЕсли;
        СтрЗначения.Значение = ЭтотОбъект[С.Имя];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция НайтиВид(Коллекция, Вид)
    Для Каждого СтрокаКоллекции Из Коллекция Цикл
        Если СтрокаКоллекции.ВидСведения = Вид Тогда Возврат СтрокаКоллекции; КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьПоляВОбъект(ТекущийОбъект);
КонецПроцедуры
