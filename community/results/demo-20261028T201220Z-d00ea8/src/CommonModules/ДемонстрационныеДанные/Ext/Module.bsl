Функция Элемент(ИмяСправочника, Наименование) Экспорт
    Справочник = Справочники[ИмяСправочника];
    Ссылка = Справочник.НайтиПоНаименованию(Наименование, Истина);
    Если Не Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Объект = Справочник.СоздатьЭлемент(); Объект.Наименование = Наименование; Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Процедура СтрокаНакладной(Док, Товар, Количество, Цена, Свойство = Неопределено) Экспорт
    С = Док.СписокНоменклатуры.Добавить(); С.Номенклатура = Товар; С.Количество = Количество; С.Цена = Цена; С.Сумма = Окр(Количество * Цена, 2);
    Если Свойство <> Неопределено Тогда С.Свойство = Свойство; КонецЕсли;
КонецПроцедуры

Процедура Начисление(Док, Сотрудник, Подразделение, Вид, Начало, Конец) Экспорт
    С = Док.ОсновныеНачисления.Добавить(); С.Сотрудник = Сотрудник; С.Подразделение = Подразделение;
    С.ВидРасчета = Вид; С.ДатаНачала = Начало; С.ДатаОкончания = Конец;
КонецПроцедуры

Процедура Заполнить() Экспорт
    // Повторный вызов безопасен: завершенный комплект не создается второй раз.
    Проверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.РасходнаяНакладная ГДЕ Номер = &Номер И Проведен");
    Проверка.УстановитьПараметр("Номер", "ДЕМО00001");
    Если Не Проверка.Выполнить().Пустой() Тогда Возврат; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Цех = Элемент("Подразделения", "Демо: сборочный цех");
        Магазин = Элемент("Подразделения", "Демо: магазин");
        Склад = Элемент("Склады", "Демо: основной склад");
        Деталь = Элемент("Номенклатура", "Демо: материнская плата");
        Блок = Элемент("Номенклатура", "Демо: системный блок");
        Товар = Элемент("Номенклатура", "Демо: принтер");
        Аналог = Элемент("Номенклатура", "Демо: принтер аналог");
        Об = Товар.ПолучитьОбъект(); Об.Артикул = "100"; Об.Записать();
        Об = Аналог.ПолучитьОбъект(); Об.Артикул = "200"; Об.Записать();
        Свойство = Элемент("СвойстваНоменклатуры", "Демо: ASUS");
        Об = Свойство.ПолучитьОбъект(); Об.Номенклатура = Деталь; Об.Записать();
        Характеристика = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Производитель", Истина);
        Если Характеристика.Пустая() Тогда
            Об = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Об.Наименование = "Производитель"; Об.ТипЗначения = Новый ОписаниеТипов("Строка"); Об.Записать(); Характеристика = Об.Ссылка;
        КонецЕсли;
        Запись = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи(); Запись.Свойство = Свойство; Запись.Характеристика = Характеристика; Запись.Значение = "ASUS"; Запись.Записать();
        Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1); Запись.Подразделение = Цех; Запись.Метод = Перечисления.УчетнаяПолитика.Средняя; Запись.Записать();
        Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1); Запись.Подразделение = Магазин; Запись.Метод = Перечисления.УчетнаяПолитика.ФИФО; Запись.Записать();
        Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1); Запись.СистемныйБлок = Блок; Запись.Деталь = Деталь; Запись.Свойство = Свойство; Запись.Количество = 2; Запись.Записать();
        Запись = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Запись.Товар = Товар; Запись.Аналог = Аналог; Запись.Записать();
        Док = Документы.ПриходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2024,1,10,9,0,0); Док.Подразделение = Цех;
        СтрокаНакладной(Док, Деталь, 10, 1000, Свойство); Док.Записать(РежимЗаписиДокумента.Проведение);
        Док = Документы.ПриходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2024,1,11,9,0,0); Док.Склад = Склад;
        СтрокаНакладной(Док, Товар, 1, 3000); СтрокаНакладной(Док, Аналог, 4, 3200); Док.Записать(РежимЗаписиДокумента.Проведение);
        Док = Документы.Операция.СоздатьДокумент(); Док.Дата = Дата(2024,1,12,9,0,0);
        С = Док.Проводки.Добавить(); С.СчетДт = ПланыСчетов.Управленческий.Товары; С.СчетКт = ПланыСчетов.Управленческий.Поставщики;
        С.НоменклатураДт = Товар; С.СкладДт = Склад; С.КоличествоДт = 1; С.Сумма = 3500; Док.Записать(РежимЗаписиДокумента.Проведение);
        Док = Документы.Сборка.СоздатьДокумент(); Док.Дата = Дата(2024,1,15,10,0,0); Док.ПодразделениеИсточник = Цех; Док.ПодразделениеПолучатель = Магазин;
        С = Док.СистемныеБлоки.Добавить(); С.Номенклатура = Блок; С.Количество = 2;
        С = Док.ДополнительныеДетали.Добавить(); С.Номенклатура = Деталь; С.Свойство = Свойство; С.Количество = 1;
        Док.Записать(РежимЗаписиДокумента.Проведение);
        Док = Документы.РасходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2024,1,16,10,0,0); Док.Подразделение = Магазин;
        СтрокаНакладной(Док, Блок, 1, 5000); Док.Записать(РежимЗаписиДокумента.Проведение);
        Док = Документы.РасходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2024,1,17,10,0,0); Док.Склад = Склад;
        СтрокаНакладной(Док, Товар, 4, 5000); Док.Записать(РежимЗаписиДокумента.Проведение);
        Сотрудник = Элемент("ФизическиеЛица", "Демо: сотрудник"); Руководитель = Элемент("ФизическиеЛица", "Демо: руководитель");
        Об = Сотрудник.ПолучитьОбъект(); Об.ДатаНачалаСтажа = Дата(2020,1,1); Об.Записать();
        Об = Руководитель.ПолучитьОбъект(); Об.ДатаНачалаСтажа = Дата(2020,1,1); Об.Записать();
        Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1); Запись.Сотрудник = Сотрудник; Запись.Ставка = 100; Запись.Записать();
        Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1); Запись.Сотрудник = Руководитель; Запись.Ставка = 200; Запись.Записать();
        Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 0; Запись.Процент = 5; Запись.Записать();
        Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 1; Запись.Процент = 10; Запись.Записать();
        Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 3; Запись.Процент = 15; Запись.Записать();
        ДеньГрафика = Дата(2024,1,1);
        Пока ДеньГрафика <= Дата(2024,5,31) Цикл
            Запись = РегистрыСведений.ГрафикиРаботы.СоздатьМенеджерЗаписи(); Запись.Дата = ДеньГрафика; Запись.Подразделение = Цех;
            Запись.Значение = ?(ДеньНедели(ДеньГрафика) <= 5, 8, 0); Запись.Записать(); ДеньГрафика = ДеньГрафика + 86400;
        КонецЦикла;
        Для НомерМесяца = 1 По 4 Цикл
            Док = Документы.НачислениеЗарплаты.СоздатьДокумент(); Док.Дата = КонецМесяца(Дата(2024,НомерМесяца,1));
            Начисление(Док, Сотрудник, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, НачалоМесяца(Док.Дата), КонецМесяца(Док.Дата));
            Начисление(Док, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, НачалоМесяца(Док.Дата), КонецМесяца(Док.Дата));
            Начисление(Док, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Премия, НачалоМесяца(Док.Дата), КонецМесяца(Док.Дата));
            Док.Записать(РежимЗаписиДокумента.Проведение);
        КонецЦикла;
        Док = Документы.НачислениеЗарплаты.СоздатьДокумент(); Док.Дата = Дата(2024,5,1);
        Начисление(Док, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Командировка, Дата(2024,4,15), Дата(2024,4,19));
        Док.Записать(РежимЗаписиДокумента.Проведение);
        // Демонстрация динамических полей менеджера.
        Об = Руководитель.ПолучитьОбъект();
        Если Об.ДополнительныеСведения.Найти(Характеристика, "ВидСведения") = Неопределено Тогда Об.ДополнительныеСведения.Добавить().ВидСведения = Характеристика; КонецЕсли;
        Об.Записать(); Контрагент = Элемент("Контрагенты", "Демо: покупатель"); Об = Контрагент.ПолучитьОбъект(); Об.Менеджер = Руководитель; Об.Записать();
        Док = Документы.РасходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2024,1,18,10,0,0); Док.Номер = "ДЕМО00001"; Док.Склад = Склад;
        СтрокаНакладной(Док, Аналог, 1, 5000); Док.Записать(РежимЗаписиДокумента.Проведение);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
