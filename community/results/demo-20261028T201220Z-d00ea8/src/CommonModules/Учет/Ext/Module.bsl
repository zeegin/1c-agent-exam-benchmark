// Общая серверная логика проведения. Все читаемые остатки защищены блокировкой
// на время транзакции записи документа; повторное проведение заменяет движения.
Функция ЗапросТаблица(Текст, Параметры = Неопределено) Экспорт
    З = Новый Запрос(Текст);
    Если Параметры <> Неопределено Тогда
        Для Каждого П Из Параметры Цикл З.УстановитьПараметр(П.Ключ, П.Значение); КонецЦикла;
    КонецЕсли;
    Возврат З.Выполнить().Выгрузить();
КонецФункции

Процедура Заблокировать(Имя, Режим = Неопределено) Экспорт
    Б = Новый БлокировкаДанных;
    Э = Б.Добавить(Имя);
    Э.Режим = ?(Режим = Неопределено, РежимБлокировкиДанных.Исключительный, Режим);
    Б.Заблокировать();
КонецПроцедуры

Функция ПечатныйОтчет(Данные, ВидОтчета, Начало, Конец, ЗаголовокХарактеристики = "Производитель") Экспорт
    Док = Новый ТабличныйДокумент;
    Док.АвтоМасштаб = Истина; Док.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
    НаименованиеОтчета = ?(ВидОтчета = "ВедомостьОУ", "Ведомость", "Продажи");
    Заголовок = ?(ВидОтчета = "Премии", "Премии за " + Формат(Начало, "ДФ='MMMM yyyy'"), НаименованиеОтчета + " с " + Формат(Начало, "ДФ=dd.MM.yyyy") + " по " + Формат(Конец, "ДФ=dd.MM.yyyy"));
    Док.Область(1,1,1,6).Объединить(); Док.Область(1,1).Текст = Заголовок;
    Док.Область(1,1).Шрифт = Новый Шрифт(,14,Истина);
    Если ВидОтчета = "ВедомостьОУ" Тогда
        Колонки = СтрРазделить("Характеристика,Номенклатура,НачальныйОстаток,Приход,Расход,КонечныйОстаток", ",");
        Подписи = СтрРазделить("Производитель,Товар,Нач. ост.,Приход,Расход,Кон. ост.", ",");
        Подписи[0] = ЗаголовокХарактеристики;
    ИначеЕсли ВидОтчета = "ПродажиБУ" Тогда
        Колонки = СтрРазделить("Номенклатура,Продано,Количество,Себестоимость,Продажа,Прибыль", ",");
        Подписи = СтрРазделить("Номенклатура,Продано,Кол-во,Себест-сть,Продажа,Прибыль", ",");
    ИначеЕсли ВидОтчета = "Премии" Тогда
        Колонки = СтрРазделить("Сотрудник,Стаж,Процент,СуммаПремии", ",");
        Подписи = СтрРазделить("Сотрудник,Трудовой стаж (лет),% премии,Сумма премии", ",");
    Иначе
        Колонки = СтрРазделить("Номенклатура,Количество,Себестоимость,Продажа,Прибыль", ",");
        Подписи = СтрРазделить("Номенклатура,Кол-во,Себест-сть,Продажа,Прибыль", ",");
    КонецЕсли;
    Для Номер = 0 По Колонки.ВГраница() Цикл
        Док.Область(3,Номер+1).Текст = Подписи[Номер]; Док.Область(3,Номер+1).Шрифт = Новый Шрифт(,,Истина);
        Док.Область(3,Номер+1).ЦветФона = Новый Цвет(225,235,245);
        Док.Область(,Номер+1,,Номер+1).ШиринаКолонки = ?(Номер < 2, 28, 17);
    КонецЦикла;
    СтрокаОтчета = 4; Группа = Неопределено;
    Для Каждого С Из Данные Цикл
        Если ВидОтчета = "ВедомостьОУ" И Группа <> С.Характеристика Тогда
            Группа = С.Характеристика;
            Док.Область(СтрокаОтчета,1).Текст = Строка(Группа); Док.Область(СтрокаОтчета,1).Шрифт = Новый Шрифт(,,Истина); СтрокаОтчета = СтрокаОтчета + 1;
        ИначеЕсли ВидОтчета = "ПродажиБУ" И Группа <> С.Номенклатура Тогда
            Группа = С.Номенклатура;
            Итоги = Данные.Скопировать(Новый Структура("Номенклатура", Группа));
            Док.Область(СтрокаОтчета,1).Текст = Строка(Группа);
            Для Номер = 2 По Колонки.ВГраница() Цикл Док.Область(СтрокаОтчета,Номер+1).Текст = Формат(Итоги.Итог(Колонки[Номер]), "ЧДЦ=2"); КонецЦикла;
            Док.Область(СтрокаОтчета,1,СтрокаОтчета,6).Шрифт = Новый Шрифт(,,Истина); СтрокаОтчета = СтрокаОтчета + 1;
        КонецЕсли;
        Для Номер = 0 По Колонки.ВГраница() Цикл
            Если (ВидОтчета = "ВедомостьОУ" Или ВидОтчета = "ПродажиБУ") И Номер = 0 Тогда Продолжить; КонецЕсли;
            Значение = С[Колонки[Номер]];
            Док.Область(СтрокаОтчета,Номер+1).Текст = ?(ТипЗнч(Значение) = Тип("Число"), Формат(Значение,"ЧДЦ=2"), Строка(Значение));
        КонецЦикла;
        Если ВидОтчета = "ВедомостьОУ" Тогда
            Док.Область(СтрокаОтчета,3).Текст = Формат(С.НачальноеКоличество,"ЧДЦ=3") + Символы.ПС + Формат(С.НачальныйОстаток,"ЧДЦ=2");
            Док.Область(СтрокаОтчета,4).Текст = Формат(С.КоличествоПриход,"ЧДЦ=3") + Символы.ПС + Формат(С.Приход,"ЧДЦ=2");
            Док.Область(СтрокаОтчета,5).Текст = Формат(С.КоличествоРасход,"ЧДЦ=3") + Символы.ПС + Формат(С.Расход,"ЧДЦ=2");
            Док.Область(СтрокаОтчета,6).Текст = Формат(С.КонечноеКоличество,"ЧДЦ=3") + Символы.ПС + Формат(С.КонечныйОстаток,"ЧДЦ=2");
        КонецЕсли;
        СтрокаОтчета = СтрокаОтчета + 1;
    КонецЦикла;
    Док.Область(СтрокаОтчета,1).Текст = "ИТОГО:";
    Для Номер = 0 По Колонки.ВГраница() Цикл
        К = Данные.Колонки.Найти(Колонки[Номер]);
        Если К.ТипЗначения.СодержитТип(Тип("Число")) И Колонки[Номер] <> "Стаж" И Колонки[Номер] <> "Процент" Тогда
            Док.Область(СтрокаОтчета,Номер+1).Текст = Формат(Данные.Итог(Колонки[Номер]), "ЧДЦ=2");
        КонецЕсли;
    КонецЦикла;
    Если ВидОтчета = "ВедомостьОУ" Тогда
        Количества = СтрРазделить("НачальноеКоличество,КоличествоПриход,КоличествоРасход,КонечноеКоличество", ",");
        Суммы = СтрРазделить("НачальныйОстаток,Приход,Расход,КонечныйОстаток", ",");
        Для Номер = 0 По 3 Цикл
            Док.Область(СтрокаОтчета,Номер+3).Текст = Формат(Данные.Итог(Количества[Номер]), "ЧДЦ=3") + Символы.ПС + Формат(Данные.Итог(Суммы[Номер]), "ЧДЦ=2");
        КонецЦикла;
    КонецЕсли;
    ПерваяЧисловая = ?(ВидОтчета = "ПродажиОУ" Или ВидОтчета = "Премии", 2, 3);
    Док.Область(4,ПерваяЧисловая,СтрокаОтчета,Колонки.Количество()).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
    Док.Область(4,1,СтрокаОтчета,Колонки.Количество()).АвтоВысотаСтроки = Истина;
    Док.Область(СтрокаОтчета,1,СтрокаОтчета,Колонки.Количество()).Шрифт = Новый Шрифт(,,Истина);
    ЛинияТаблицы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
    Для НомерСтроки = 3 По СтрокаОтчета Цикл
        Для НомерКолонки = 1 По Колонки.Количество() Цикл
            Док.Область(НомерСтроки,НомерКолонки).Обвести(ЛинияТаблицы,ЛинияТаблицы,ЛинияТаблицы,ЛинияТаблицы);
        КонецЦикла;
    КонецЦикла;
    Возврат Док;
КонецФункции

Процедура НастроитьВидыРасчета() Экспорт
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    Для Каждого Вид Из СтрРазделить("Тариф,Премия", ",") Цикл
        Ссылка = ПланыВидовРасчета.ОсновныеНачисления[Вид];
        ОбъектВида = Ссылка.ПолучитьОбъект();
        Если ОбъектВида.ВытесняющиеВидыРасчета.Найти(Командировка, "ВидРасчета") = Неопределено Тогда
            ОбъектВида.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка;
            ОбъектВида.Записать();
        КонецЕсли;
    КонецЦикла;
    ОбъектВида = Премия.ПолучитьОбъект();
    Если ОбъектВида.БазовыеВидыРасчета.Найти(Тариф, "ВидРасчета") = Неопределено Тогда
        ОбъектВида.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф; ОбъектВида.Записать();
    КонецЕсли;
    ОбъектВида = Командировка.ПолучитьОбъект(); Изменен = Ложь;
    Для Каждого Вид Из СтрРазделить("Тариф,Премия,Командировка", ",") Цикл
        Ссылка = ПланыВидовРасчета.ОсновныеНачисления[Вид];
        Если ОбъектВида.БазовыеВидыРасчета.Найти(Ссылка, "ВидРасчета") = Неопределено Тогда
            ОбъектВида.БазовыеВидыРасчета.Добавить().ВидРасчета = Ссылка; Изменен = Истина;
        КонецЕсли;
    КонецЦикла;
    Если Изменен Тогда ОбъектВида.Записать(); КонецЕсли;
КонецПроцедуры

Процедура Начислить(Док) Экспорт
    Если Док.ОсновныеНачисления.Количество() = 0 Тогда ВызватьИсключение "Не указаны начисления"; КонецЕсли;
    НастроитьВидыРасчета();
    Заблокировать("РегистрРасчета.Начисления");
    ПодготовитьДвижения(Док, СтрРазделить("Начисления", ","));
    СтрокиНачислений = Док.ОсновныеНачисления.Выгрузить();
    СтрокиНачислений.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
    Для Каждого С Из СтрокиНачислений Цикл
        Если Не ЗначениеЗаполнено(С.Сотрудник) Или Не ЗначениеЗаполнено(С.Подразделение) Или Не ЗначениеЗаполнено(С.ВидРасчета) Тогда ВызватьИсключение "Не заполнены сотрудник, подразделение или вид расчета"; КонецЕсли;
        Если Не ЗначениеЗаполнено(С.ДатаНачала) Или С.ДатаОкончания < С.ДатаНачала Тогда ВызватьИсключение "Неверный период начисления"; КонецЕсли;
        Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(С.ДатаНачала) <> НачалоМесяца(С.ДатаОкончания) Тогда ВызватьИсключение "Тариф и премия вводятся в пределах одного месяца"; КонецЕсли;
        Начало = НачалоДня(С.ДатаНачала);
        Пока Начало <= С.ДатаОкончания Цикл
            Конец = Мин(КонецМесяца(Начало), КонецДня(С.ДатаОкончания));
            Д = Док.Движения.Начисления.Добавить();
            Д.ПериодРегистрации = НачалоМесяца(Начало);
            Если С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
                Д.ПериодРегистрации = Макс(НачалоМесяца(Начало), НачалоМесяца(Док.Дата));
            КонецЕсли;
            Д.ПериодДействияНачало = Начало; Д.ПериодДействияКонец = Конец;
            Д.Сотрудник = С.Сотрудник; Д.Подразделение = С.Подразделение; Д.ВидРасчета = С.ВидРасчета;
            Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), ?(С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, -3, -1));
            Д.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            Начало = КонецМесяца(Начало) + 1;
        КонецЦикла;
    КонецЦикла;
    // Специализированный механизм определяет именно интервалы сторнирования
    // прошлых периодов; их не приходится искать вручную по документам.
    Дополнение = Док.Движения.Начисления.ПолучитьДополнение();
    Для Каждого СтрокаДополнения Из Дополнение Цикл
        Д = Док.Движения.Начисления.Добавить();
        ЗаполнитьЗначенияСвойств(Д, СтрокаДополнения, "Сотрудник,Подразделение,ВидРасчета,БазовыйПериодНачало,БазовыйПериодКонец,НормаЧасов");
        Д.Сторно = Истина; Д.ПериодРегистрации = СтрокаДополнения.ПериодРегистрацииСторно;
        Д.ПериодДействияНачало = СтрокаДополнения.ПериодДействияНачалоСторно;
        Д.ПериодДействияКонец = СтрокаДополнения.ПериодДействияКонецСторно;
    КонецЦикла;
    Док.Движения.Начисления.Записать();
    ПересчитатьНачисления();
    // Не перезаписываем пересчитанный набор устаревшими данными объекта.
    Док.Движения.Начисления.Прочитать();
КонецПроцедуры

Процедура СохранитьРасчет(Данные, Наборы)
    Регистраторы = Данные.Скопировать(); Регистраторы.Свернуть("Регистратор");
    Для Каждого Р Из Регистраторы Цикл
        Кеш = Наборы.Получить(Р.Регистратор);
        Если Кеш = Неопределено Тогда
            Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
            Набор.Отбор.Регистратор.Установить(Р.Регистратор); Набор.Прочитать();
            СтрокиПоНомерам = Новый Соответствие;
            Для Каждого Запись Из Набор Цикл СтрокиПоНомерам.Вставить(Запись.НомерСтроки, Запись); КонецЦикла;
            Кеш = Новый Структура("Набор,Строки", Набор, СтрокиПоНомерам); Наборы.Вставить(Р.Регистратор, Кеш);
        КонецЕсли;
        Набор = Кеш.Набор;
        СтрокиРегистратора = Данные.НайтиСтроки(Новый Структура("Регистратор", Р.Регистратор));
        Для Каждого С Из СтрокиРегистратора Цикл
            Запись = Кеш.Строки.Получить(С.НомерСтроки);
            Если Запись <> Неопределено Тогда ЗаполнитьЗначенияСвойств(Запись, С, "Результат,Дни,Часы,Стаж,Процент,НормаЧасов"); КонецЕсли;
        КонецЦикла;
        Набор.Записать(, Истина);
    КонецЦикла;
КонецПроцедуры

Процедура ПересчитатьНачисления() Экспорт
    Заблокировать("РегистрСведений.ГрафикиРаботы", РежимБлокировкиДанных.Разделяемый);
    Заблокировать("РегистрСведений.ТарифныеСтавки", РежимБлокировкиДанных.Разделяемый);
    Заблокировать("РегистрСведений.ШкалаПремий", РежимБлокировкиДанных.Разделяемый);
    // Основная таблица нужна только для исходных параметров записей и записи
    // новых результатов. График и расчетная база читаются из виртуальных таблиц.
    Данные = ЗапросТаблица("ВЫБРАТЬ Н.*, Н.Сотрудник.ДатаНачалаСтажа КАК НачалоСтажа
    |ИЗ РегистрРасчета.Начисления КАК Н ГДЕ Н.Активность
    |УПОРЯДОЧИТЬ ПО Н.ПериодДействияНачало, Н.Регистратор, Н.НомерСтроки");
    Если Данные.Количество() = 0 Тогда Возврат; КонецЕсли;
    Данные.Индексы.Добавить("Регистратор,НомерСтроки");
    Наборы = Новый Соответствие;
    Регистраторы = Данные.Скопировать(); Регистраторы.Свернуть("Регистратор");
    Ссылки = Регистраторы.ВыгрузитьКолонку("Регистратор");
    Факт = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки,
    |ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК Часы,
    |ЕСТЬNULL(ДниФактическийПериодДействия, 0) КАК Дни,
    |ЕСТЬNULL(ЗначениеПериодРегистрации, 0) КАК Норма
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))",
    Новый Структура("Регистраторы", Ссылки));
    Факт.Индексы.Добавить("Регистратор,НомерСтроки");
    Сотрудники = Данные.ВыгрузитьКолонку("Сотрудник");
    Ставки = ЗапросТаблица("ВЫБРАТЬ Период, Сотрудник, Ставка ИЗ РегистрСведений.ТарифныеСтавки
    |ГДЕ Сотрудник В (&Сотрудники) УПОРЯДОЧИТЬ ПО Период УБЫВ", Новый Структура("Сотрудники", Сотрудники));
    Ставки.Индексы.Добавить("Сотрудник");
    Шкала = ЗапросТаблица("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж УБЫВ");
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    ПредыдущиеПоездки = Данные.Скопировать(Новый Структура("ВидРасчета", Командировка));
    ПредыдущиеПоездки.Индексы.Добавить("Регистратор,НомерСтроки");
    Для Каждого С Из Данные Цикл
        Если С.ВидРасчета <> Командировка Тогда С.Результат = 0; КонецЕсли;
        С.Дни = 0; С.Часы = 0; С.Стаж = 0; С.Процент = 0;
        СтрокиФакта = Факт.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", С.Регистратор, С.НомерСтроки));
        Если СтрокиФакта.Количество() > 0 И Не С.Сторно Тогда С.НормаЧасов = СтрокиФакта[0].Норма; КонецЕсли;
        Если С.ВидРасчета = Тариф И СтрокиФакта.Количество() > 0 Тогда
            С.Часы = СтрокиФакта[0].Часы * ?(С.Сторно, -1, 1); С.Дни = СтрокиФакта[0].Дни * ?(С.Сторно, -1, 1);
            СтавкиСотрудника = Ставки.НайтиСтроки(Новый Структура("Сотрудник", С.Сотрудник));
            Для Каждого Ставка Из СтавкиСотрудника Цикл
                Если Ставка.Сотрудник = С.Сотрудник И Ставка.Период <= НачалоМесяца(С.ПериодДействияНачало) Тогда
                    С.Результат = Окр(С.Часы * Ставка.Ставка, 2); Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    // Сначала записываем рассчитанный тариф, чтобы база премии была достоверна.
    СохранитьРасчет(Данные, Наборы);
    Измерения = СтрРазделить("Подразделение", ","); Разрезы = СтрРазделить("Сотрудник", ",");
    БазаПремий = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки,
    |СУММА(ЕСТЬNULL(РезультатБаза, 0)) КАК Результат
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные, &Базовые, &Разрезы, ВидРасчета = &Вид) КАК Б
    |ГДЕ Б.СотрудникРазрез <> Б.Сотрудник
    |СГРУППИРОВАТЬ ПО Регистратор, НомерСтроки",
    Новый Структура("Основные,Базовые,Разрезы,Вид", Измерения, Измерения, Разрезы, Премия));
    БазаПремий.Индексы.Добавить("Регистратор,НомерСтроки");
    Для Каждого С Из Данные Цикл
        Если С.ВидРасчета <> Премия Тогда Продолжить; КонецЕсли;
        Если ЗначениеЗаполнено(С.НачалоСтажа) Тогда
            ДатаОценкиСтажа = НачалоМесяца(С.ПериодДействияНачало);
            ПолныхМесяцев = (Год(ДатаОценкиСтажа) - Год(С.НачалоСтажа)) * 12 + Месяц(ДатаОценкиСтажа) - Месяц(С.НачалоСтажа);
            Если День(ДатаОценкиСтажа) < День(С.НачалоСтажа) Тогда ПолныхМесяцев = ПолныхМесяцев - 1; КонецЕсли;
            С.Стаж = Макс(0, ПолныхМесяцев / 12);
        КонецЕсли;
        Для Каждого Ш Из Шкала Цикл Если С.Стаж >= Ш.Стаж Тогда С.Процент = Ш.Процент; Прервать; КонецЕсли; КонецЦикла;
        Б = БазаПремий.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", С.Регистратор, С.НомерСтроки));
        Г = Факт.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", С.Регистратор, С.НомерСтроки));
        Если Б.Количество() > 0 И Г.Количество() > 0 И С.НормаЧасов > 0 Тогда
            С.Результат = Окр(Б[0].Результат * С.Процент / 100 * Г[0].Часы / С.НормаЧасов, 2) * ?(С.Сторно, -1, 1);
        КонецЕсли;
    КонецЦикла;
    СохранитьРасчет(Данные, Наборы);
    // Командировка использует все виды начислений по всем подразделениям
    // сотрудника. Ресурс Дни содержит именно отработанные дни тарифа.
    Измерения = СтрРазделить("Сотрудник", ","); ПустыеРазрезы = Новый Массив;
    БазаПоездок = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки,
    |ЕСТЬNULL(РезультатБаза, 0) КАК Результат, ЕСТЬNULL(ДниБаза, 0) КАК Дни
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные, &Базовые, &Разрезы, ВидРасчета = &Вид)",
    Новый Структура("Основные,Базовые,Разрезы,Вид", Измерения, Измерения, ПустыеРазрезы, Командировка));
    БазаПоездок.Индексы.Добавить("Регистратор,НомерСтроки");
    ИзмененияПоСотрудникам = Новый Соответствие;
    Для Каждого С Из Данные Цикл
        Если С.ВидРасчета <> Командировка Тогда Продолжить; КонецЕсли;
        Б = БазаПоездок.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", С.Регистратор, С.НомерСтроки));
        Г = Факт.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", С.Регистратор, С.НомерСтроки));
        ИзмененияПоМесяцам = ИзмененияПоСотрудникам.Получить(С.Сотрудник);
        Если ИзмененияПоМесяцам = Неопределено Тогда
            ИзмененияПоМесяцам = Новый Соответствие; ИзмененияПоСотрудникам.Вставить(С.Сотрудник, ИзмененияПоМесяцам);
        КонецЕсли;
        С.Результат = 0;
        Если Б.Количество() > 0 И Г.Количество() > 0 И Б[0].Дни > 0 Тогда
            База = Б[0].Результат;
            // Виртуальная таблица содержит уже записанные предыдущие поездки.
            // При ретроспективном изменении добавляем только разницу их нового
            // и прежнего результатов, рассчитанную в текущем проходе в памяти.
            Для Смещение = 1 По 3 Цикл
                Разница = ИзмененияПоМесяцам.Получить(ДобавитьМесяц(НачалоМесяца(С.ПериодДействияНачало), -Смещение));
                Если Разница <> Неопределено Тогда База = База + Разница; КонецЕсли;
            КонецЦикла;
            С.Результат = Окр(База / Б[0].Дни * Г[0].Дни, 2);
        КонецЕсли;
        Старые = ПредыдущиеПоездки.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", С.Регистратор, С.НомерСтроки));
        МесяцДействия = НачалоМесяца(С.ПериодДействияНачало);
        Разница = ИзмененияПоМесяцам.Получить(МесяцДействия);
        ИзмененияПоМесяцам.Вставить(МесяцДействия, ?(Разница = Неопределено, 0, Разница) + С.Результат - ?(Старые.Количество() = 0, 0, Старые[0].Результат));
    КонецЦикла;
    СохранитьРасчет(Данные, Наборы);
КонецПроцедуры

Функция СуммаСтроки(С) Экспорт
    Если С.Сумма <> 0 Тогда Возврат С.Сумма; КонецЕсли;
    Возврат Окр(С.Цена * С.Количество, 2);
КонецФункции

Процедура ПроверитьСтроку(С) Экспорт
    Если Не ЗначениеЗаполнено(С.Номенклатура) Или С.Количество <= 0 Тогда
        ВызватьИсключение "Укажите номенклатуру и положительное количество в строке " + С.НомерСтроки;
    КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьДвижения(Док, Имена) Экспорт
    Для Каждого Имя Из Имена Цикл
        Набор = Док.Движения[Имя];
        Набор.Записывать = Истина;
        Набор.Очистить();
        Набор.Записать();
    КонецЦикла;
КонецПроцедуры

Процедура Приход(Док) Экспорт
    Если Док.СписокНоменклатуры.Количество() = 0 Тогда ВызватьИсключение "Не указаны товары прихода"; КонецЕсли;
    ПодготовитьДвижения(Док, СтрРазделить("ОстаткиНоменклатуры,Управленческий", ","));
    Для Каждого С Из Док.СписокНоменклатуры Цикл
        ПроверитьСтроку(С);
        Сумма = СуммаСтроки(С);
        Если Сумма < 0 Тогда ВызватьИсключение "Отрицательная сумма прихода"; КонецЕсли;
        Подразделение = С.Подразделение;
        Если Не ЗначениеЗаполнено(Подразделение) Тогда Подразделение = Док.Подразделение; КонецЕсли;
        Если ЗначениеЗаполнено(Подразделение) Тогда
            Д = Док.Движения.ОстаткиНоменклатуры.Добавить();
            Д.ВидДвижения = ВидДвиженияНакопления.Приход;
            Д.Период = Док.Дата; Д.Подразделение = Подразделение;
            Д.Номенклатура = С.Номенклатура; Д.Свойство = С.Свойство;
            Д.Партия = Док.Ссылка; Д.Количество = С.Количество; Д.Стоимость = Сумма;
        КонецЕсли;
        Если ЗначениеЗаполнено(Док.Склад) Тогда
            Д = Док.Движения.Управленческий.Добавить(); Д.Период = Док.Дата;
            Д.СчетДт = ПланыСчетов.Управленческий.Товары;
            Д.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Д.НоменклатураДт = С.Номенклатура; Д.СкладДт = Док.Склад;
            Д.КоличествоДт = С.Количество; Д.Сумма = Сумма;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(Док.Склад) Тогда
            ВызватьИсключение "Не указаны подразделение или склад прихода";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ОстаткиОУ(Док, Подразделения, Товары) Экспорт
    Таблица = ЗапросТаблица("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    |КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Граница, Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |ГДЕ КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО Партия.Дата, Партия", Новый Структура("Граница,Подразделения,Товары", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая), Подразделения, Товары));
    Таблица.Индексы.Добавить("Подразделение,Номенклатура,Свойство");
    Возврат Таблица;
КонецФункции

Процедура ЗаблокироватьКлючи(Пространство, Таблица, Поля, Режим = Неопределено) Экспорт
    Если Таблица.Количество() = 0 Тогда Возврат; КонецЕсли;
    Б = Новый БлокировкаДанных;
    Э = Б.Добавить(Пространство); Э.Режим = ?(Режим = Неопределено, РежимБлокировкиДанных.Исключительный, Режим);
    Э.ИсточникДанных = Таблица;
    Для Каждого Поле Из СтрРазделить(Поля, ",") Цикл Э.ИспользоватьИзИсточникаДанных(Поле, Поле); КонецЦикла;
    Б.Заблокировать();
КонецПроцедуры

Функция МетодСписания(Подразделение, Дата) Экспорт
    Т = ЗапросТаблица("ВЫБРАТЬ Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение = &Подразделение)", Новый Структура("Дата,Подразделение", Дата, Подразделение));
    Если Т.Количество() = 0 Тогда Возврат Перечисления.УчетнаяПолитика.Средняя; КонецЕсли;
    Возврат Т[0].Метод;
КонецФункции

Функция СписатьОУ(Док, Остатки, Подразделение, Товар, Свойство, Количество, Метод) Экспорт
    Строки = Остатки.НайтиСтроки(Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство));
    Всего = 0; Стоимость = 0;
    Для Каждого С Из Строки Цикл Всего = Всего + С.Количество; Стоимость = Стоимость + С.Стоимость; КонецЦикла;
    Если Всего < Количество Тогда
        ВызватьИсключение "Недостаточно: " + Товар + ", свойство: " + Свойство + ", подразделение: " + Подразделение + ". Требуется " + Количество + ", остаток " + Всего;
    КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
        Обратные = Новый Массив;
        Номер = Строки.Количество() - 1;
        Пока Номер >= 0 Цикл Обратные.Добавить(Строки[Номер]); Номер = Номер - 1; КонецЦикла;
        Строки = Обратные;
    КонецЕсли;
    Осталось = Количество; Итого = 0;
    // Средняя стоимость распределяется по всем партиям пропорционально количеству.
    // Это сохраняет и партионный остаток, и возможность его полного закрытия.
    Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
        СписатьСтоимость = ?(Количество = Всего, Стоимость, Окр(Стоимость * Количество / Всего, 2));
        НакопленоКоличество = 0; НакопленоСтоимость = 0; СписаноКоличество = 0; СписаноСтоимость = 0;
        Для Каждого С Из Строки Цикл
            Если С.Количество = 0 Тогда Продолжить; КонецЕсли;
            НакопленоКоличество = НакопленоКоличество + С.Количество;
            НакопленоСтоимость = НакопленоСтоимость + С.Стоимость;
            К = Окр(Количество * НакопленоКоличество / Всего, 8) - СписаноКоличество;
            Ц = ?(Стоимость = 0, 0, Окр(СписатьСтоимость * НакопленоСтоимость / Стоимость, 2) - СписаноСтоимость);
            СписаноКоличество = СписаноКоличество + К; СписаноСтоимость = СписаноСтоимость + Ц;
            Д = Док.Движения.ОстаткиНоменклатуры.Добавить();
            ЗаполнитьЗначенияСвойств(Д, С, "Подразделение,Номенклатура,Свойство,Партия");
            Д.ВидДвижения = ВидДвиженияНакопления.Расход; Д.Период = Док.Дата; Д.Количество = К; Д.Стоимость = Ц;
            С.Количество = С.Количество - К; С.Стоимость = С.Стоимость - Ц; Итого = Итого + Ц;
        КонецЦикла;
    Иначе
        Для Каждого С Из Строки Цикл
            К = Мин(Осталось, С.Количество);
            Если К <= 0 Тогда Продолжить; КонецЕсли;
            Ц = ?(К = С.Количество, С.Стоимость, Окр(С.Стоимость * К / С.Количество, 2));
            Д = Док.Движения.ОстаткиНоменклатуры.Добавить();
            ЗаполнитьЗначенияСвойств(Д, С, "Подразделение,Номенклатура,Свойство,Партия");
            Д.ВидДвижения = ВидДвиженияНакопления.Расход; Д.Период = Док.Дата; Д.Количество = К; Д.Стоимость = Ц;
            С.Количество = С.Количество - К; С.Стоимость = С.Стоимость - Ц;
            Итого = Итого + Ц; Осталось = Осталось - К;
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Возврат Итого;
КонецФункции

Процедура Сборка(Док) Экспорт
    ПодготовитьДвижения(Док, СтрРазделить("ОстаткиНоменклатуры", ","));
    Если Не ЗначениеЗаполнено(Док.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(Док.ПодразделениеПолучатель) Тогда ВызватьИсключение "Укажите оба подразделения сборки"; КонецЕсли;
    Если Док.СистемныеБлоки.Количество() = 0 Тогда ВызватьИсключение "Не указана продукция сборки"; КонецЕсли;
    Блоки = Док.СистемныеБлоки.Выгрузить(); Блоки.Свернуть("Номенклатура", "Количество");
    Список = Блоки.ВыгрузитьКолонку("Номенклатура");
    КлючиСпецификаций = Блоки.Скопировать(); КлючиСпецификаций.Колонки.Найти("Номенклатура").Имя = "СистемныйБлок";
    ЗаблокироватьКлючи("РегистрСведений.Спецификации", КлючиСпецификаций, "СистемныйБлок", РежимБлокировкиДанных.Разделяемый);
    Спецификации = ЗапросТаблица("ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период
    |ПОМЕСТИТЬ Версии ИЗ РегистрСведений.Спецификации
    |ГДЕ Период <= &Дата И СистемныйБлок В (&Блоки) СГРУППИРОВАТЬ ПО СистемныйБлок;
    |ВЫБРАТЬ С.СистемныйБлок, С.Деталь, С.Свойство, С.Количество
    |ИЗ РегистрСведений.Спецификации КАК С ВНУТРЕННЕЕ СОЕДИНЕНИЕ Версии КАК Вер
    |ПО С.СистемныйБлок = Вер.СистемныйБлок И С.Период = Вер.Период", Новый Структура("Дата,Блоки", Док.Дата, Список));
    Спецификации.Индексы.Добавить("СистемныйБлок");
    Потребность = Спецификации.Скопировать();
    Потребность.Колонки.Найти("Деталь").Имя = "Номенклатура";
    Для Каждого С Из Док.ДополнительныеДетали Цикл
        Новая = Потребность.Добавить(); Новая.Номенклатура = С.Номенклатура; Новая.Свойство = С.Свойство;
    КонецЦикла;
    Потребность.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Потребность.ЗаполнитьЗначения(Док.ПодразделениеИсточник, "Подразделение");
    ЗаблокироватьКлючи("РегистрНакопления.ОстаткиНоменклатуры", Потребность, "Подразделение,Номенклатура,Свойство");
    Подразделения = Новый Массив; Подразделения.Добавить(Док.ПодразделениеИсточник);
    Остатки = ОстаткиОУ(Док, Подразделения, Потребность.ВыгрузитьКолонку("Номенклатура")); ВсегоБаза = 0;
    Блоки.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
    Для Каждого Б Из Блоки Цикл
        Если Б.Количество <= 0 Тогда ВызватьИсключение "Количество продукции должно быть положительным"; КонецЕсли;
        Строки = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Б.Номенклатура));
        Если Строки.Количество() = 0 Тогда ВызватьИсключение "Нет спецификации на дату сборки: " + Б.Номенклатура; КонецЕсли;
        Для Каждого С Из Строки Цикл
            Если С.Количество <= 0 Тогда ВызватьИсключение "Неверное количество в спецификации"; КонецЕсли;
            Б.Стоимость = Б.Стоимость + СписатьОУ(Док, Остатки, Док.ПодразделениеИсточник, С.Деталь, С.Свойство, С.Количество * Б.Количество, Перечисления.УчетнаяПолитика.Средняя);
        КонецЦикла;
        ВсегоБаза = ВсегоБаза + Б.Стоимость;
    КонецЦикла;
    ДопСтоимость = 0;
    Для Каждого С Из Док.ДополнительныеДетали Цикл
        ПроверитьСтроку(С);
        ДопСтоимость = ДопСтоимость + СписатьОУ(Док, Остатки, Док.ПодразделениеИсточник, С.Номенклатура, С.Свойство, С.Количество, Перечисления.УчетнаяПолитика.Средняя);
    КонецЦикла;
    Распределено = 0; Индекс = 0; ВсегоКоличество = Блоки.Итог("Количество");
    Для Каждого Б Из Блоки Цикл
        Индекс = Индекс + 1;
        Если Индекс = Блоки.Количество() Тогда Доп = ДопСтоимость - Распределено;
        Иначе Доп = Окр(ДопСтоимость * ?(ВсегоБаза = 0, Б.Количество / ВсегоКоличество, Б.Стоимость / ВсегоБаза), 2); КонецЕсли;
        Распределено = Распределено + Доп;
        Д = Док.Движения.ОстаткиНоменклатуры.Добавить();
        Д.ВидДвижения = ВидДвиженияНакопления.Приход; Д.Период = Док.Дата;
        Д.Подразделение = Док.ПодразделениеПолучатель; Д.Номенклатура = Б.Номенклатура;
        Д.Партия = Док.Ссылка; Д.Количество = Б.Количество; Д.Стоимость = Б.Стоимость + Доп;
    КонецЦикла;
КонецПроцедуры

Функция ГрафАналогов(Связи)
    Граф = Новый Соответствие;
    Для Каждого С Из Связи Цикл
        Если Не ЗначениеЗаполнено(С.Товар) Или Не ЗначениеЗаполнено(С.Аналог) Тогда Продолжить; КонецЕсли;
        Смежные = Граф.Получить(С.Товар);
        Если Смежные = Неопределено Тогда Смежные = Новый Массив; Граф.Вставить(С.Товар, Смежные); КонецЕсли;
        Смежные.Добавить(С.Аналог);
        Смежные = Граф.Получить(С.Аналог);
        Если Смежные = Неопределено Тогда Смежные = Новый Массив; Граф.Вставить(С.Аналог, Смежные); КонецЕсли;
        Смежные.Добавить(С.Товар);
    КонецЦикла;
    Возврат Граф;
КонецФункции

Функция ГруппаАналогов(Товар, Граф) Экспорт
    Список = Новый Массив; Список.Добавить(Товар); Номер = 0;
    Посещенные = Новый Соответствие; Посещенные.Вставить(Товар, Истина);
    Пока Номер < Список.Количество() Цикл
        Текущий = Список[Номер];
        Смежные = Граф.Получить(Текущий);
        Если Смежные <> Неопределено Тогда
            Для Каждого Сосед Из Смежные Цикл
                Если Посещенные.Получить(Сосед) = Неопределено Тогда
                    Посещенные.Вставить(Сосед, Истина); Список.Добавить(Сосед);
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Номер = Номер + 1;
    КонецЦикла;
    Возврат Список;
КонецФункции

Процедура Продажа(Док) Экспорт
    Если Док.СписокНоменклатуры.Количество() = 0 Тогда ВызватьИсключение "Не указаны товары продажи"; КонецЕсли;
    Если ЗначениеЗаполнено(Док.Склад) Тогда НастроитьСубконтоПродаж(); КонецЕсли;
    ПодготовитьДвижения(Док, СтрРазделить("ОстаткиНоменклатуры,Управленческий,ПродажиОУ", ","));
    Потребность = Док.СписокНоменклатуры.Выгрузить();
    Для Каждого С Из Потребность Цикл
        Если Не ЗначениеЗаполнено(С.Подразделение) Тогда С.Подразделение = Док.Подразделение; КонецЕсли;
    КонецЦикла;
    ЗаблокироватьКлючи("РегистрНакопления.ОстаткиНоменклатуры", Потребность, "Подразделение,Номенклатура,Свойство");
    Подразделения = Потребность.ВыгрузитьКолонку("Подразделение");
    ЗаблокироватьКлючи("РегистрСведений.УчетныеПолитики", Потребность, "Подразделение", РежимБлокировкиДанных.Разделяемый);
    Остатки = ОстаткиОУ(Док, Подразделения, Потребность.ВыгрузитьКолонку("Номенклатура"));
    Политики = ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))", Новый Структура("Дата,Подразделения", Док.Дата, Подразделения));
    Политики.Индексы.Добавить("Подразделение");
    Если ЗначениеЗаполнено(Док.Склад) Тогда
        Связи = ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
        Граф = ГрафАналогов(Связи); ГруппыАналогов = Новый Соответствие;
        ВсеТовары = Док.СписокНоменклатуры.Выгрузить(); ВсеТовары.Свернуть("Номенклатура");
        СписокТоваров = ВсеТовары.ВыгрузитьКолонку("Номенклатура");
        Для Каждого Т Из СписокТоваров Цикл
            Группа = ГруппыАналогов.Получить(Т);
            Если Группа = Неопределено Тогда
                Группа = ГруппаАналогов(Т, Граф);
                Для Каждого Участник Из Группа Цикл ГруппыАналогов.Вставить(Участник, Группа); КонецЦикла;
            КонецЕсли;
            Для Каждого Аналог Из Группа Цикл
                Если ВсеТовары.Найти(Аналог, "Номенклатура") = Неопределено Тогда ВсеТовары.Добавить().Номенклатура = Аналог; КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        СписокТоваров = ВсеТовары.ВыгрузитьКолонку("Номенклатура");
        ЗаблокироватьКлючи("РегистрБухгалтерии.Управленческий", ВсеТовары, "Номенклатура");
        ОстаткиБУ = ЗапросТаблица("ВЫБРАТЬ Номенклатура, Номенклатура.Артикул КАК Артикул, Склад,
        |КоличествоОстаток КАК Количество, СуммаОстаток КАК Сумма
        |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Граница, Счет = &Счет, , Номенклатура В (&Товары))
        |УПОРЯДОЧИТЬ ПО Артикул, Номенклатура", Новый Структура("Граница,Счет,Товары", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая), ПланыСчетов.Управленческий.Товары, СписокТоваров));
        ОстаткиБУ.Индексы.Добавить("Номенклатура,Склад");
        Средние = ОстаткиБУ.Скопировать(); Средние.Свернуть("Номенклатура", "Количество,Сумма");
        Средние.Индексы.Добавить("Номенклатура");
    КонецЕсли;
    Для Каждого С Из Док.СписокНоменклатуры Цикл
        ПроверитьСтроку(С); Выручка = СуммаСтроки(С);
        Если Выручка < 0 Тогда ВызватьИсключение "Сумма продажи не может быть отрицательной"; КонецЕсли;
        Подразделение = С.Подразделение;
        Если Не ЗначениеЗаполнено(Подразделение) Тогда Подразделение = Док.Подразделение; КонецЕсли;
        Если ЗначениеЗаполнено(Подразделение) Тогда
            Политика = Политики.Найти(Подразделение, "Подразделение");
            Метод = ?(Политика = Неопределено, Перечисления.УчетнаяПолитика.Средняя, Политика.Метод);
            Себестоимость = СписатьОУ(Док, Остатки, Подразделение, С.Номенклатура, С.Свойство, С.Количество, Метод);
            Д = Док.Движения.ПродажиОУ.Добавить(); Д.Период = Док.Дата; Д.Номенклатура = С.Номенклатура;
            Д.Количество = С.Количество; Д.Себестоимость = Себестоимость; Д.Выручка = Выручка;
        КонецЕсли;
        Если ЗначениеЗаполнено(Док.Склад) Тогда
            Группа = ГруппыАналогов.Получить(С.Номенклатура);
            Кандидаты = Новый Массив;
            Свои = ОстаткиБУ.НайтиСтроки(Новый Структура("Номенклатура,Склад", С.Номенклатура, Док.Склад));
            Для Каждого О Из Свои Цикл Кандидаты.Добавить(О); КонецЦикла;
            Для Каждого О Из ОстаткиБУ Цикл
                Если О.Склад = Док.Склад И О.Номенклатура <> С.Номенклатура И Группа.Найти(О.Номенклатура) <> Неопределено Тогда Кандидаты.Добавить(О); КонецЕсли;
            КонецЦикла;
            Осталось = С.Количество; РаспределенаВыручка = 0;
            Для Каждого О Из Кандидаты Цикл
                К = Мин(Осталось, О.Количество);
                Если К <= 0 Тогда Продолжить; КонецЕсли;
                Средний = Средние.Найти(О.Номенклатура, "Номенклатура");
                Если Средний.Количество <= 0 Тогда ВызватьИсключение "Нет количественного остатка для расчета себестоимости"; КонецЕсли;
                Стоимость = ?(К = Средний.Количество, Средний.Сумма, Окр(Средний.Сумма * К / Средний.Количество, 2));
                ЧастьВыручки = ?(К = Осталось, Выручка - РаспределенаВыручка, Окр(Выручка * К / С.Количество, 2));
                РаспределенаВыручка = РаспределенаВыручка + ЧастьВыручки;
                Д = Док.Движения.Управленческий.Добавить(); Д.Период = Док.Дата;
                Д.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Д.СчетКт = ПланыСчетов.Управленческий.Товары;
                Д.НоменклатураКт = О.Номенклатура; Д.СкладКт = Док.Склад; Д.КоличествоКт = К; Д.Сумма = Стоимость;
                Д.КоличествоДт = К;
                Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.ЗаказаннаяНоменклатура] = С.Номенклатура;
                Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.ПроданнаяНоменклатура] = О.Номенклатура;
                Д = Док.Движения.Управленческий.Добавить(); Д.Период = Док.Дата;
                Д.СчетДт = ПланыСчетов.Управленческий.Покупатели; Д.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки; Д.Сумма = ЧастьВыручки;
                Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.ЗаказаннаяНоменклатура] = С.Номенклатура;
                Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.ПроданнаяНоменклатура] = О.Номенклатура;
                О.Количество = О.Количество - К; Средний.Количество = Средний.Количество - К; Средний.Сумма = Средний.Сумма - Стоимость;
                Осталось = Осталось - К;
                Если Осталось = 0 Тогда Прервать; КонецЕсли;
            КонецЦикла;
            Если Осталось > 0 Тогда ВызватьИсключение "Недостаточно товара и всех его аналогов: " + С.Номенклатура + ", не хватает " + Осталось; КонецЕсли;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(Док.Склад) Тогда ВызватьИсключение "Не указаны подразделение или склад продажи"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Операция(Док) Экспорт
    Если Док.Проводки.Количество() = 0 Тогда ВызватьИсключение "Не указаны проводки операции"; КонецЕсли;
    НастроитьСубконтоПродаж();
    ПодготовитьДвижения(Док, СтрРазделить("Управленческий", ","));
    Для Каждого С Из Док.Проводки Цикл
        Если Не ЗначениеЗаполнено(С.СчетДт) Или Не ЗначениеЗаполнено(С.СчетКт) Тогда ВызватьИсключение "Не заданы счета проводки"; КонецЕсли;
        Д = Док.Движения.Управленческий.Добавить(); Д.Период = Док.Дата;
        ЗаполнитьЗначенияСвойств(Д, С, "СчетДт,СчетКт,НоменклатураДт,НоменклатураКт,СкладДт,СкладКт,КоличествоДт,КоличествоКт,Сумма");
        Если С.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки Или С.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки Тогда
            Заказано = С.ЗаказаннаяНоменклатура; Продано = С.ПроданнаяНоменклатура;
            Если Не ЗначениеЗаполнено(Продано) Тогда Продано = ?(С.СчетКт = ПланыСчетов.Управленческий.Товары, С.НоменклатураКт, С.НоменклатураДт); КонецЕсли;
            Если Не ЗначениеЗаполнено(Заказано) Тогда Заказано = Продано; КонецЕсли;
            Аналитика = ?(С.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки, Д.СубконтоДт, Д.СубконтоКт);
            Аналитика[ПланыВидовХарактеристик.ВидыСубконто.ЗаказаннаяНоменклатура] = Заказано;
            Аналитика[ПланыВидовХарактеристик.ВидыСубконто.ПроданнаяНоменклатура] = Продано;
            Если С.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки И С.СчетКт = ПланыСчетов.Управленческий.Товары Тогда Д.КоличествоДт = С.КоличествоКт; КонецЕсли;
            Если С.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки И С.СчетДт = ПланыСчетов.Управленческий.Товары Тогда Д.КоличествоКт = С.КоличествоДт; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура НастроитьСубконтоПродаж() Экспорт
    Счет = ПланыСчетов.Управленческий.ПрибылиУбытки;
    Виды = Счет.ВидыСубконто.Выгрузить();
    Заказано = ПланыВидовХарактеристик.ВидыСубконто.ЗаказаннаяНоменклатура;
    Продано = ПланыВидовХарактеристик.ВидыСубконто.ПроданнаяНоменклатура;
    Если Виды.Найти(Заказано, "ВидСубконто") <> Неопределено И Виды.Найти(Продано, "ВидСубконто") <> Неопределено Тогда Возврат; КонецЕсли;
    ОбъектСчета = Счет.ПолучитьОбъект();
    Для Каждого Имя Из СтрРазделить("ЗаказаннаяНоменклатура,ПроданнаяНоменклатура", ",") Цикл
        Вид = ПланыВидовХарактеристик.ВидыСубконто[Имя];
        СтрокаВида = ОбъектСчета.ВидыСубконто.Найти(Вид, "ВидСубконто");
        Если СтрокаВида = Неопределено Тогда СтрокаВида = ОбъектСчета.ВидыСубконто.Добавить(); СтрокаВида.ВидСубконто = Вид; КонецЕсли;
        СтрокаВида.ТолькоОбороты = Истина;
    КонецЦикла;
    ОбъектСчета.Записать();
КонецПроцедуры
