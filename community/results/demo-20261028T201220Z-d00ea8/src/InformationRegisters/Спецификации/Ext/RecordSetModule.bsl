Процедура ПередЗаписью(Отказ, Замещение)
    Если ЭтотОбъект.Количество() = 0 Тогда Возврат; КонецЕсли;
    НовыеВерсии = ЭтотОбъект.Выгрузить();
    Учет.ЗаблокироватьКлючи("РегистрСведений.Спецификации", НовыеВерсии, "СистемныйБлок");
    Блоки = НовыеВерсии.ВыгрузитьКолонку("СистемныйБлок");
    Минимум = Дата(3999,1,1); Максимум = Дата(1,1,1);
    Для Каждого С Из НовыеВерсии Цикл
        Если Не ЗначениеЗаполнено(С.СистемныйБлок) Или Не ЗначениеЗаполнено(С.Деталь) Или С.Количество <= 0 Тогда
            ВызватьИсключение "Укажите системный блок, деталь и положительное количество в спецификации";
        КонецЕсли;
        Минимум = Мин(Минимум, НачалоНедели(С.Период)); Максимум = Макс(Максимум, КонецНедели(С.Период));
    КонецЦикла;
    Существующие = Учет.ЗапросТаблица("ВЫБРАТЬ РАЗЛИЧНЫЕ СистемныйБлок, Период
    |ИЗ РегистрСведений.Спецификации ГДЕ СистемныйБлок В (&Блоки) И Период МЕЖДУ &Начало И &Конец",
    Новый Структура("Блоки,Начало,Конец", Блоки, Минимум, Максимум));
    Для Каждого С Из НовыеВерсии Цикл
        Для Каждого Версия Из Существующие Цикл
            Если Версия.СистемныйБлок = С.СистемныйБлок И Версия.Период <> НачалоДня(С.Период)
                И НачалоНедели(Версия.Период) = НачалоНедели(С.Период) Тогда
                ВызватьИсключение "Состав блока можно изменять не чаще одного раза за календарную неделю. Уже есть версия от " + Формат(Версия.Период, "ДФ=dd.MM.yyyy");
            КонецЕсли;
        КонецЦикла;
        Для Каждого Другая Из НовыеВерсии Цикл
            Если Другая.СистемныйБлок = С.СистемныйБлок И НачалоДня(Другая.Период) <> НачалоДня(С.Период)
                И НачалоНедели(Другая.Период) = НачалоНедели(С.Период) Тогда ВызватьИсключение "В наборе более одной версии блока за неделю"; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры
