Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение, ЧасовВДень = 8) Экспорт
    Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Укажите подразделение"; КонецЕсли;
    Если ДатаОкончания < ДатаНачала Или ЧасовВДень < 0 Тогда ВызватьИсключение "Проверьте период и количество часов"; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Ключи = Новый ТаблицаЗначений; Ключи.Колонки.Добавить("Подразделение"); Ключи.Добавить().Подразделение = Подразделение;
        Учет.ЗаблокироватьКлючи("РегистрСведений.ГрафикиРаботы", Ключи, "Подразделение");
        Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); Набор.Отбор.Подразделение.Установить(Подразделение); Набор.Прочитать();
        Номер = Набор.Количество() - 1;
        Пока Номер >= 0 Цикл
            Если Набор[Номер].Дата >= НачалоДня(ДатаНачала) И Набор[Номер].Дата <= КонецДня(ДатаОкончания) Тогда Набор.Удалить(Номер); КонецЕсли;
            Номер = Номер - 1;
        КонецЦикла;
        ДеньГрафика = НачалоДня(ДатаНачала);
        Пока ДеньГрафика <= КонецДня(ДатаОкончания) Цикл
            Запись = Набор.Добавить(); Запись.Подразделение = Подразделение; Запись.Дата = ДеньГрафика;
            Запись.Значение = ?(СтрНайти(ВыходныеДни, Строка(ДеньНедели(ДеньГрафика))) > 0, 0, ЧасовВДень);
            ДеньГрафика = ДеньГрафика + 86400;
        КонецЦикла;
        Набор.Записать(); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
