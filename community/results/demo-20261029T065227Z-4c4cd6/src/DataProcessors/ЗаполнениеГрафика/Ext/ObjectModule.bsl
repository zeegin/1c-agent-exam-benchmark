Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение) Экспорт
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Укажите подразделение."; КонецЕсли;
	Если ДатаОкончания < ДатаНачала Тогда ВызватьИсключение "Конец периода раньше начала."; КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ГрафикиРаботы");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Подразделение", Подразделение);
		Блокировка.Заблокировать();
		Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
		Набор.Отбор.Подразделение.Установить(Подразделение);
		Набор.Прочитать();
		Удаляемые = Новый Массив;
		Для Каждого Запись Из Набор Цикл
			Если Запись.Дата >= НачалоДня(ДатаНачала) И Запись.Дата <= КонецДня(ДатаОкончания) Тогда Удаляемые.Добавить(Запись); КонецЕсли;
		КонецЦикла;
		Для Каждого Запись Из Удаляемые Цикл Набор.Удалить(Запись); КонецЦикла;
		День = НачалоДня(ДатаНачала);
		Пока День <= ДатаОкончания Цикл
			Запись = Набор.Добавить();
			Запись.Дата = День; Запись.Подразделение = Подразделение;
			Запись.Дни = ?(СтрНайти(ВыходныеДни, Строка(ДеньНедели(День))) > 0, 0, 1);
			Запись.Значение = Запись.Дни * 8;
			День = День + 86400;
		КонецЦикла;
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры
