Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УчетСервер.НастроитьСчета();
	Движения.Хозрасчетный.Очистить();
	Движения.Хозрасчетный.Записывать = Истина;
	Т = Проводки.Выгрузить();
	Счета = Т.ВыгрузитьКолонку("СчетДт");
	Для Каждого Счет Из Т.ВыгрузитьКолонку("СчетКт") Цикл Счета.Добавить(Счет); КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Счет, НомерСтроки, ВидСубконто ИЗ ПланСчетов.Управленческий.ВидыСубконто ГДЕ Ссылка В (&Счета)");
	Запрос.УстановитьПараметр("Счета", Счета);
	Аналитика = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Проводки Цикл
		Если НЕ ЗначениеЗаполнено(Строка.СчетДт) ИЛИ НЕ ЗначениеЗаполнено(Строка.СчетКт) Тогда
			ВызватьИсключение "В проводке необходимо указать оба счета.";
		КонецЕсли;
		Д = Движения.Хозрасчетный.Добавить();
		Д.Период = Дата; Д.СчетДт = Строка.СчетДт; Д.СчетКт = Строка.СчетКт;
		Д.Сумма = Строка.Сумма; Д.КоличествоДт = Строка.КоличествоДт; Д.КоличествоКт = Строка.КоличествоКт;
		Для Каждого Сторона Из СтрРазделить("Дт;Кт", ";") Цикл
			Для Каждого Вид Из Аналитика.НайтиСтроки(Новый Структура("Счет", Строка["Счет" + Сторона])) Цикл
				Значение = Строка["Субконто" + Сторона + Строка(Вид.НомерСтроки)];
				Если НЕ ЗначениеЗаполнено(Значение) Тогда
					Если Вид.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
						Значение = Строка["Номенклатура" + Сторона];
					ИначеЕсли Вид.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Склады Тогда
						Значение = Строка["Склад" + Сторона];
					КонецЕсли;
				КонецЕсли;
				Д["Субконто" + Сторона][Вид.ВидСубконто] = Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
