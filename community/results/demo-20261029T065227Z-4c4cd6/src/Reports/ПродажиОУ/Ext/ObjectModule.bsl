Функция Сформировать(НачалоПериода, КонецПериода) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Номенклатура, КоличествоОборот КАК Количество,
	| СебестоимостьОборот КАК Себестоимость, ВыручкаОборот КАК Выручка,
	| ВыручкаОборот - СебестоимостьОборот КАК Прибыль
	|ИЗ РегистрНакопления.ПродажиОУ.Обороты(&Начало, &Конец, , )
	|УПОРЯДОЧИТЬ ПО Номенклатура");
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
