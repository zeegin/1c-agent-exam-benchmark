&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода = КонецМесяца(НачалоПериода);
	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("Результат", Новый ОписаниеТипов("ТабличныйДокумент")));
	ИзменитьРеквизиты(Добавляемые);
	Поле = Элементы.Добавить("ТабличныйРезультат", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	Поле.ПутьКДанным = "Результат";
	Поле.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда) Экспорт
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	Данные = РеквизитФормыВЗначение("Объект").Сформировать(НачалоПериода, КонецПериода);
	ЭтаФорма["Результат"] = УчетСервер.ПечатнаяФорма(Данные, "ПродажиОУ", НачалоПериода, КонецПериода);
КонецПроцедуры
