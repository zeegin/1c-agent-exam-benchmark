Функция Сформировать(НачалоПериода, КонецПериода) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Номенклатура, Продано, СУММА(Количество) КАК Количество,
	| СУММА(Себестоимость) КАК Себестоимость, СУММА(Выручка) КАК Выручка,
	| СУММА(Выручка - Себестоимость) КАК Прибыль
	|ИЗ (
	| ВЫБРАТЬ СубконтоДт1 КАК Номенклатура, СубконтоДт2 КАК Продано,
	| КоличествоОборотДт КАК Количество, СуммаОборот КАК Себестоимость, 0 КАК Выручка
	| ИЗ РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&Начало, &Конец, , СчетДт = &Прибыль, &ВидыПродаж, СчетКт = &Товары, , )
	| ОБЪЕДИНИТЬ ВСЕ
	| ВЫБРАТЬ СубконтоКт1, СубконтоКт2, 0, 0, СуммаОборот
	| ИЗ РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&Начало, &Конец, , СчетДт = &Покупатели, , СчетКт = &Прибыль, &ВидыПродаж, )
	|) КАК Данные
	|СГРУППИРОВАТЬ ПО Номенклатура, Продано
	|УПОРЯДОЧИТЬ ПО Номенклатура, Продано");
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Товары", ПланыСчетов.Управленческий.Товары);
	Запрос.УстановитьПараметр("Прибыль", ПланыСчетов.Управленческий.ПрибылиУбытки);
	Запрос.УстановитьПараметр("Покупатели", ПланыСчетов.Управленческий.Покупатели);
	ВидыПродаж = Новый Массив;
	ВидыПродаж.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЗаказанныйТовар);
	ВидыПродаж.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ПроданныйТовар);
	Запрос.УстановитьПараметр("ВидыПродаж", ВидыПродаж);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
