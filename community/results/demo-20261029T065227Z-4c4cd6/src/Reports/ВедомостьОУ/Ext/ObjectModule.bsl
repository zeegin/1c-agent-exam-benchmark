Функция Сформировать(НачалоПериода, КонецПериода, Подразделение) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Номенклатура, Свойство,
	| СУММА(КоличествоНачальныйОстаток) КАК НачальноеКоличество,
	| СУММА(КоличествоПриход) КАК ПриходКоличество,
	| СУММА(КоличествоРасход) КАК РасходКоличество,
	| СУММА(КоличествоКонечныйОстаток) КАК КонечноеКоличество,
	| СУММА(СтоимостьНачальныйОстаток) КАК НачальныйОстаток,
	| СУММА(СтоимостьПриход) КАК Приход,
	| СУММА(СтоимостьРасход) КАК Расход,
	| СУММА(СтоимостьКонечныйОстаток) КАК КонечныйОстаток
	|ИЗ РегистрНакопления.ОстаткиНоменклатуры.ОстаткиИОбороты(&Начало, &Конец, , , Подразделение = &Подразделение)
	|СГРУППИРОВАТЬ ПО Номенклатура, Свойство
	|УПОРЯДОЧИТЬ ПО Свойство, Номенклатура");
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Характеристики", Новый ОписаниеТипов("Строка"));
	Запрос.Текст = "ВЫБРАТЬ Свойство, Характеристика.Наименование КАК Вид, Значение ИЗ РегистрСведений.ЗначенияСвойств ГДЕ Свойство В (&Свойства)";
	Запрос.УстановитьПараметр("Свойства", Таблица.ВыгрузитьКолонку("Свойство"));
	Значения = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Таблица Цикл
		Описание = "";
		Для Каждого Свойство Из Значения.НайтиСтроки(Новый Структура("Свойство", Строка.Свойство)) Цикл
			Описание = Описание + ?(Описание = "", "", "; ") + Свойство.Вид + ": " + Строка(Свойство.Значение);
		КонецЦикла;
		Строка.Характеристики = ?(Описание = "", Строка(Строка.Свойство), Описание);
	КонецЦикла;
	Таблица.Сортировать("Характеристики,Номенклатура");
	Возврат Таблица;
КонецФункции
