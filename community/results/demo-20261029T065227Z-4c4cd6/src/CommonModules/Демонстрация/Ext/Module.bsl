	Запрос.УстановитьПараметр("Док", Док.Ссылка);
	С = Запрос.Выполнить().Выбрать(); С.Следующий(); Возврат С.Сумма;
КонецФункции

Процедура ОстатокБУДляПроверки(Результаты, Имя, Товар, Количество, Сумма)
