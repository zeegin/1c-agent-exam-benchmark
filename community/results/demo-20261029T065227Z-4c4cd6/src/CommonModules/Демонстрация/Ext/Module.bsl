
Функция Элемент(ИмяСправочника, Наименование)
	Менеджер = Справочники[ИмяСправочника];
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
	Объект = Менеджер.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Если ИмяСправочника = "Номенклатура" Тогда Объект.Артикул = Наименование; КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция ДокументДемо(Вид, Номер, ДатаДокумента)
	Ссылка = Документы[Вид].НайтиПоНомеру(Номер, ДатаДокумента);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Документы[Вид].СоздатьДокумент();
	КонецЕсли;
	Объект.Дата = ДатаДокумента;
	Объект.Номер = Номер;
	Возврат Объект;
КонецФункции

Процедура СтрокаТовара(Таблица, Товар, Количество, Цена, Свойство = Неопределено, Подразделение = Неопределено)
	С = Таблица.Добавить();
	С.Номенклатура = Товар; С.Количество = Количество; С.Цена = Цена; С.Сумма = Количество * Цена;
	Если Свойство <> Неопределено Тогда С.Свойство = Свойство; КонецЕсли;
	Если Подразделение <> Неопределено Тогда С.Подразделение = Подразделение; КонецЕсли;
КонецПроцедуры

Функция ВидСведений(Имя, ТипЗначения)
	Ссылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Вид = Ссылка.ПолучитьОбъект();
		Вид.ТипЗначения = ТипЗначения;
		Вид.Записать();
		Возврат Ссылка;
	КонецЕсли;
	Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
	Вид.Наименование = Имя; Вид.ТипЗначения = ТипЗначения;
	Вид.Записать();
	Возврат Вид.Ссылка;
КонецФункции

Процедура СтрокаНачисления(Док, Работник, Подразделение, Вид, Начало, Конец)
	С = Док.ОсновныеНачисления.Добавить();
	С.Сотрудник = Работник; С.Подразделение = Подразделение; С.ВидРасчета = Вид;
	С.ДатаНачала = Начало; С.ДатаОкончания = Конец; С.Регистрация = НачалоМесяца(Начало);
КонецПроцедуры

Процедура Заполнить() Экспорт
	Цех = Элемент("Подразделения", "Демо: основной цех");
	Продажи = Элемент("Подразделения", "Демо: отдел продаж");
	Склад = Элемент("Склады", "Демо: основной склад");
	Процессор = Элемент("Номенклатура", "Демо: процессор");
	Память = Элемент("Номенклатура", "Демо: память");
	Блок = Элемент("Номенклатура", "Демо: системный блок");
	Принтер = Элемент("Номенклатура", "Демо: принтер");
	Заказ = Элемент("Номенклатура", "Демо: заказанный принтер");
	Промежуточный = Элемент("Номенклатура", "Демо: аналог принтера");
	Свойство = Элемент("СвойстваНоменклатуры", "Демо: ASUS");
	О = Свойство.ПолучитьОбъект(); О.Номенклатура = Процессор; О.Записать();
	Производитель = ВидСведений("Производитель", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	З = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
	З.Свойство = Свойство; З.Характеристика = Производитель; З.Значение = "ASUS"; З.Записать();
	П = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
	П.Период = Дата(2024, 1, 1); П.Подразделение = Цех; П.Метод = Перечисления.УчетнаяПолитика.Средняя; П.Записать();
	П = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); П.Период = Дата(2024, 1, 1); П.Подразделение = Продажи; П.Метод = Перечисления.УчетнаяПолитика.ФИФО; П.Записать();
	С = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
	С.Период = Дата(2024, 1, 1); С.Блок = Блок; С.Деталь = Процессор; С.Свойство = Свойство; С.Количество = 2; С.Записать();
	С = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи(); С.Период = Дата(2024, 1, 1); С.Блок = Блок; С.Деталь = Память; С.Свойство = Справочники.СвойстваНоменклатуры.ПустаяСсылка(); С.Количество = 1; С.Записать();
	А = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();
	А.Товар = Заказ; А.Аналог = Промежуточный;  А.Записать();
	А = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();  А.Товар = Промежуточный; А.Аналог = Принтер; А.Записать();
	Приход = ДокументДемо("ПриходнаяНакладная", "ДЕМ000001", Дата(2024, 1, 2, 12, 0, 0));
	Приход.Подразделение = Цех; Приход.Склад = Склад; Приход.СписокНоменклатуры.Очистить();
	СтрокаТовара(Приход.СписокНоменклатуры, Процессор, 20, 1000, Свойство);
	СтрокаТовара(Приход.СписокНоменклатуры, Память, 20, 500);
	СтрокаТовара(Приход.СписокНоменклатуры, Принтер, 10, 3000);
	Приход.Записать(РежимЗаписиДокумента.Проведение);
	Сборка = ДокументДемо("Сборка", "ДЕМ000001", Дата(2024, 1, 3, 12, 0, 0));
	Сборка.ПодразделениеИсточник = Цех; Сборка.ПодразделениеПолучатель = Продажи;
	Сборка.Блоки.Очистить(); Сборка.ДополнительныеДетали.Очистить();
	Стр = Сборка.Блоки.Добавить(); Стр.Номенклатура = Блок; Стр.Количество = 2;
	Стр = Сборка.ДополнительныеДетали.Добавить(); Стр.Номенклатура = Память; Стр.Количество = 2;
	Сборка.Записать(РежимЗаписиДокумента.Проведение);
	Расход = ДокументДемо("РасходнаяНакладная", "ДЕМ000001", Дата(2024, 1, 4, 12, 0, 0));
	Расход.СписокНоменклатуры.Очистить();
	СтрокаТовара(Расход.СписокНоменклатуры, Блок, 1, 5000, , Продажи);
	СтрокаТовара(Расход.СписокНоменклатуры, Принтер, 2, 4000, , Цех);
	Расход.Записать(РежимЗаписиДокумента.Проведение);
	Расход = ДокументДемо("РасходнаяНакладная", "ДЕМ000002", Дата(2024, 1, 5, 12, 0, 0));
	Расход.Склад = Склад; Расход.СписокНоменклатуры.Очистить();
	СтрокаТовара(Расход.СписокНоменклатуры, Заказ, 2, 4000);
	Расход.Записать(РежимЗаписиДокумента.Проведение);
	Операция = ДокументДемо("Операция", "ДЕМ000001", Дата(2024, 1, 6, 12, 0, 0));
	Операция.Проводки.Очистить();
	Стр = Операция.Проводки.Добавить(); Стр.СчетДт = ПланыСчетов.Управленческий.Товары; Стр.СчетКт = ПланыСчетов.Управленческий.Поставщики;
	Стр.НоменклатураДт = Принтер; Стр.СкладДт = Склад; Стр.КоличествоДт = 1; Стр.Сумма = 3000;
	Операция.Записать(РежимЗаписиДокумента.Проведение);
	Работник = Элемент("ФизическиеЛица", "Демо: сотрудник");
	Руководитель = Элемент("ФизическиеЛица", "Демо: руководитель");
	О = Работник.ПолучитьОбъект(); О.НачалоСтажа = Дата(2020, 1, 1); О.Записать();
	О = Руководитель.ПолучитьОбъект(); О.НачалоСтажа = Дата(2018, 1, 1); О.ДополнительныеСведения.Очистить();
	ВалютаКредита = ВидСведений("Валюта кредита", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	СрокКредита = ВидСведений("Срок кредита, дни", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	Регион = ВидСведений("Регион", Новый ОписаниеТипов("СправочникСсылка.ЗначенияХарактеристик"));
	О.ДополнительныеСведения.Добавить().ВидСведений = ВалютаКредита;
	О.ДополнительныеСведения.Добавить().ВидСведений = СрокКредита;
	О.ДополнительныеСведения.Добавить().ВидСведений = Регион;
	О.Записать();
	Контрагент = Элемент("Контрагенты", "Демо: завод Сатурн");
	О = Контрагент.ПолучитьОбъект(); О.Менеджер = Руководитель; О.Сведения.Очистить();
	Стр = О.Сведения.Добавить(); Стр.ВидСведений = СрокКредита; Стр.Значение = 10;
	Стр = О.Сведения.Добавить(); Стр.ВидСведений = Регион; Стр.Значение = ДополнительноеЗначение(Регион, "Москва"); О.Записать();
	Ш = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
	Ш.Стаж = 0; Ш.Процент = 5; Ш.Записать(); Ш = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Ш.Стаж = 1; Ш.Процент = 10; Ш.Записать(); Ш = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Ш.Стаж = 3; Ш.Процент = 15; Ш.Записать();
	Ставка = РегистрыСведений.СведенияОСотрудниках.СоздатьМенеджерЗаписи();
	Ставка.Период = Дата(2024, 1, 1); Ставка.Подразделение = Цех;
	Ставка.Сотрудник = Работник; Ставка.Оклад = 100; Ставка.Записать();
	Ставка = РегистрыСведений.СведенияОСотрудниках.СоздатьМенеджерЗаписи(); Ставка.Период = Дата(2024, 1, 1); Ставка.Подразделение = Цех; Ставка.Сотрудник = Руководитель; Ставка.Оклад = 200; Ставка.Записать();
	График = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
	График.Отбор.Подразделение.Установить(Цех);
	День = Дата(2024, 1, 1);
	Пока День <= Дата(2024, 4, 30) Цикл
		Стр = График.Добавить(); Стр.Дата = День; Стр.Подразделение = Цех;
		Стр.Дни = ?(ДеньНедели(День) <= 5, 1, 0); Стр.Значение = Стр.Дни * 8;
		День = День + 86400;
	КонецЦикла;
	График.Записать();
	РасчетЗарплаты.НастроитьВидыРасчета();
	Зарплата = ДокументДемо("НачислениеЗарплаты", "ДЕМ000001", Дата(2024, 3, 31, 12, 0, 0));
	Зарплата.ОсновныеНачисления.Очистить();
	Для Месяц = 1 По 3 Цикл
		Начало = Дата(2024, Месяц, 1);
		СтрокаНачисления(Зарплата, Работник, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Начало, КонецМесяца(Начало));
		СтрокаНачисления(Зарплата, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Начало, КонецМесяца(Начало));
		Если Месяц > 1 Тогда СтрокаНачисления(Зарплата, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Премия, Начало, КонецМесяца(Начало)); КонецЕсли;
	КонецЦикла;
	Зарплата.Записать(РежимЗаписиДокумента.Проведение);
	Командировка = ДокументДемо("НачислениеЗарплаты", "ДЕМ000002", Дата(2024, 4, 30, 12, 0, 0));
	Командировка.ОсновныеНачисления.Очистить();
	СтрокаНачисления(Командировка, Работник, Цех, ПланыВидовРасчета.ОсновныеНачисления.Командировка, Дата(2024, 3, 28), Дата(2024, 4, 4));
	Командировка.ОсновныеНачисления[0].Регистрация = Дата(2024, 4, 1);
	Командировка.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура Сравнить(Результаты, Имя, Получено, Ожидается)
	Результаты.Добавить(Новый Структура("test,actual,expected,passed", Имя, Получено, Ожидается, Абсолютное(Получено - Ожидается) < 0.011));
КонецПроцедуры

Функция Абсолютное(Число)
	Возврат ?(Число < 0, -Число, Число);
КонецФункции

Функция Проверить() Экспорт
	Результаты = Новый Массив;
	Цех = Справочники.Подразделения.НайтиПоНаименованию("Демо: основной цех", Истина);
	Работник = Справочники.ФизическиеЛица.НайтиПоНаименованию("Демо: сотрудник", Истина);
	Блок = Справочники.Номенклатура.НайтиПоНаименованию("Демо: системный блок", Истина);
	Принтер = Справочники.Номенклатура.НайтиПоНаименованию("Демо: принтер", Истина);
	Ведомость = Отчеты.ВедомостьОУ.Создать().Сформировать(Дата(2024, 1, 1), Дата(2024, 1, 31), Цех);
	Сравнить(Результаты, "ОУ: приход количества", Ведомость.Итог("ПриходКоличество"), 50);
	Сравнить(Результаты, "ОУ: расход стоимости", Ведомость.Итог("Расход"), 12000);
	Сравнить(Результаты, "ОУ: остаток стоимости цеха", Ведомость.Итог("КонечныйОстаток"), 48000);
	ПродажиОУ = Отчеты.ПродажиОУ.Создать().Сформировать(Дата(2024, 1, 1), Дата(2024, 1, 31));
	Сравнить(Результаты, "ОУ: выручка", ПродажиОУ.Итог("Выручка"), 13000);
	Сравнить(Результаты, "ОУ: себестоимость продаж", ПродажиОУ.Итог("Себестоимость"), 9000);
	ПродажиБУ = Отчеты.ПродажиБУ.Создать().Сформировать(Дата(2024, 1, 1), Дата(2024, 1, 31));
	Сравнить(Результаты, "БУ: число строк отчета без пустой аналитики", ПродажиБУ.Количество(), 1);
	Если ПродажиБУ.Количество() > 0 Тогда
		Сравнить(Результаты, "БУ: фактически проданный товар строки", ?(ПродажиБУ[0].Продано = Принтер, 1, 0), 1);
		Сравнить(Результаты, "БУ: количество в строке товара", ПродажиБУ[0].Количество, 2);
		Сравнить(Результаты, "БУ: себестоимость в строке товара", ПродажиБУ[0].Себестоимость, 6000);
	КонецЕсли;
	Сравнить(Результаты, "БУ: количество продаж через цепочку аналогов", ПродажиБУ.Итог("Количество"), 2);
	Сравнить(Результаты, "БУ: себестоимость", ПродажиБУ.Итог("Себестоимость"), 6000);
	Сравнить(Результаты, "БУ: выручка", ПродажиБУ.Итог("Выручка"), 8000);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ СУММА(КоличествоОстаток) КАК Количество, СУММА(СуммаОстаток) КАК Сумма
	|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет = ЗНАЧЕНИЕ(ПланСчетов.Управленческий.Товары), &ВидыСубконто, Субконто1 = &Товар)");
	ВидыСубконто = Новый Массив; ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("Товар", Принтер);
	Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
	Сравнить(Результаты, "БУ: ручная операция в остатке количества", Выборка.Количество, 9);
	Сравнить(Результаты, "БУ: ручная операция в остатке стоимости", Выборка.Сумма, 27000);
	Премии = Отчеты.Премии.Создать().Сформировать(Дата(2024, 2, 1), Дата(2024, 2, 29));
	Сравнить(Результаты, "ЗП: премия без тарифа самого руководителя", Премии.Итог("СуммаПремии"), 2760);
	Запрос.Текст =
	"ВЫБРАТЬ НАЧАЛОПЕРИОДА(ПериодДействияНачало, МЕСЯЦ) КАК Месяц, ВидРасчета,
	| СУММА(Результат) КАК Сумма
	|ИЗ РегистрРасчета.Начисления ГДЕ Сотрудник = &Сотрудник
	|СГРУППИРОВАТЬ ПО НАЧАЛОПЕРИОДА(ПериодДействияНачало, МЕСЯЦ), ВидРасчета";
	Запрос.УстановитьПараметр("Сотрудник", Работник);
	Начисления = Запрос.Выполнить().Выгрузить();
	Для Каждого С Из Начисления Цикл
		Если С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
			Ожидается = ?(Месяц(С.Месяц) = 1, 18400, ?(Месяц(С.Месяц) = 2, 16800, 15200));
			Сравнить(Результаты, "ЗП: тариф за месяц " + Месяц(С.Месяц), С.Сумма, Ожидается);
		ИначеЕсли С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
			Сравнить(Результаты, "ЗП: командировка за месяц " + Месяц(С.Месяц), С.Сумма, ?(Месяц(С.Месяц) = 3, 1600, 3200));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ПродажиБУ;ПродажиОУ;Премии;ВедомостьОУ", ";") Цикл
		Данные = ?(Имя = "ПродажиБУ", ПродажиБУ, ?(Имя = "ПродажиОУ", ПродажиОУ, ?(Имя = "Премии", Премии, Ведомость)));
		Печать = УчетСервер.ПечатнаяФорма(Данные, Имя, Дата(2024, 1, 1), Дата(2024, 1, 31), Цех);
		Сравнить(Результаты, "Печатная форма " + Имя, ?(Печать.ВысотаТаблицы > 4, 1, 0), 1);
	КонецЦикла;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Результаты);
	Возврат Запись.Закрыть();
КонецФункции

