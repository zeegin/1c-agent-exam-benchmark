Функция ДополнительноеЗначение(Вид, Наименование)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ЗначенияХарактеристик ГДЕ Владелец = &Вид И Наименование = &Имя");
	Запрос.УстановитьПараметр("Вид", Вид); Запрос.УстановитьПараметр("Имя", Наименование);
	С = Запрос.Выполнить().Выбрать();
	Если С.Следующий() Тогда Возврат С.Ссылка; КонецЕсли;
	Значение = Справочники.ЗначенияХарактеристик.СоздатьЭлемент();
	Значение.Владелец = Вид; Значение.Наименование = Наименование; Значение.Записать();
	Возврат Значение.Ссылка;
КонецФункции

Функция ПроверитьСохранениеПолей() Экспорт
	Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Демо: завод Сатурн", Истина).ПолучитьОбъект();
	Срок = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Срок кредита, дни", Истина);
	Регион = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Регион", Истина);
	Валюта = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Валюта кредита", Истина);
	С = Контрагент.Сведения.Найти(Срок, "ВидСведений");
	Если С = Неопределено ИЛИ С.Значение <> 17 Тогда Возврат Ложь; КонецЕсли;
	С = Контрагент.Сведения.Найти(Регион, "ВидСведений");
	Если С = Неопределено ИЛИ С.Значение <> ДополнительноеЗначение(Регион, "Новосибирск") Тогда Возврат Ложь; КонецЕсли;
	С = Контрагент.Сведения.Найти(Валюта, "ВидСведений");
	Возврат С <> Неопределено И С.Значение = Справочники.Валюты.РоссийскийРубль;
КонецФункции

Функция ЭкспортироватьПримерыОтчетов() Экспорт
	Каталог = КаталогВременныхФайлов() + "ExamReports_" + Строка(Новый УникальныйИдентификатор()) + Символ(92);
	СоздатьКаталог(Каталог);
	Цех = Справочники.Подразделения.НайтиПоНаименованию("Демо: основной цех", Истина);
	Для Каждого Имя Из СтрРазделить("ПродажиБУ;ПродажиОУ;ВедомостьОУ;Премии", ";") Цикл
		Начало = ?(Имя = "Премии", Дата(2024, 2, 1), Дата(2024, 1, 1));
		Если Имя = "ВедомостьОУ" Тогда
			Данные = Отчеты[Имя].Создать().Сформировать(Начало, КонецМесяца(Начало), Цех);
		Иначе
			Данные = Отчеты[Имя].Создать().Сформировать(Начало, КонецМесяца(Начало));
		КонецЕсли;
		Печать = УчетСервер.ПечатнаяФорма(Данные, Имя, Начало, КонецМесяца(Начало), Цех);
		Печать.Записать(Каталог + Имя + ".pdf", ТипФайлаТабличногоДокумента.PDF);
		Печать.Записать(Каталог + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
	КонецЦикла;
	Возврат Каталог;
КонецФункции
