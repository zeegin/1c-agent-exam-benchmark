Функция СуммаРасчета(Работник, Вид, Месяц)
	Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Результат), 0) КАК Сумма ИЗ РегистрРасчета.Начисления ГДЕ Сотрудник = &Работник И ВидРасчета = &Вид И ПериодДействияНачало МЕЖДУ &Начало И &Конец");
	Запрос.УстановитьПараметр("Работник", Работник); Запрос.УстановитьПараметр("Вид", Вид);
	Запрос.УстановитьПараметр("Начало", НачалоМесяца(Месяц)); Запрос.УстановитьПараметр("Конец", КонецМесяца(Месяц));
	С = Запрос.Выполнить().Выбрать(); С.Следующий(); Возврат С.Сумма;
КонецФункции

Функция СуммаПродажиОУ(Док)
