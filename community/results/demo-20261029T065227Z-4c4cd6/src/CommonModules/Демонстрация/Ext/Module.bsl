Функция ПроверитьСборкуИОтказы() Экспорт
	Результаты = Новый Массив;
	НачатьТранзакцию();
	Попытка
		Источник = Элемент("Подразделения", "Тест: источник сборки"); Приемник = Элемент("Подразделения", "Тест: получатель сборки");
