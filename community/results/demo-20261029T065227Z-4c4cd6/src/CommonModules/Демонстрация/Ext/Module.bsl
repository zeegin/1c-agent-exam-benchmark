	Запрос.УстановитьПараметр("Товар", Товар); С = Запрос.Выполнить().Выбрать(); С.Следующий();
	Сравнить(Результаты, Имя + ": количество", С.Количество, Количество);
	Сравнить(Результаты, Имя + ": сумма", С.Сумма, Сумма);
