
Процедура НастроитьВидыРасчета() Экспорт
	План = ПланыВидовРасчета.ОсновныеНачисления;
	Тариф = План.Тариф.ПолучитьОбъект();
	Если Тариф.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
		Тариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = План.Командировка;
		Тариф.Записать();
	КонецЕсли;
	Оклад = План.Оклад.ПолучитьОбъект();
	Если Оклад.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
		Оклад.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = План.Командировка;
		Оклад.Записать();
	КонецЕсли;
	Премия = План.Премия.ПолучитьОбъект();
	Если Премия.БазовыеВидыРасчета.Количество() = 0 Тогда
		Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Тариф;
		Премия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = План.Командировка;
		Премия.Записать();
	КонецЕсли;
	Если Премия.БазовыеВидыРасчета.Найти(План.Оклад, "ВидРасчета") = Неопределено Тогда
		Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Оклад;
		Премия.Записать();
	КонецЕсли;
	Командировка = План.Командировка.ПолучитьОбъект();
	Если Командировка.БазовыеВидыРасчета.Количество() = 0 Тогда
		Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Тариф;
		Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Премия;
		Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Командировка;
		Командировка.Записать();
	КонецЕсли;
	Если Командировка.БазовыеВидыРасчета.Найти(План.Оклад, "ВидРасчета") = Неопределено Тогда
		Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Оклад;
		Командировка.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура Провести(Док) Экспорт
	НастроитьВидыРасчета();
	БлокироватьРасчеты();
	Изменения = ИзмененияРасчета(Док);
	Набор = Док.Движения.Начисления;
	Набор.Очистить();
	Набор.Записывать = Истина;
	Строки = Док.ОсновныеНачисления.Выгрузить();
	Строки.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания,Регистрация", "");
	Если Строки.Количество() = 0 Тогда ВызватьИсключение "Нет строк начислений."; КонецЕсли;
	Для Каждого Строка Из Строки Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Сотрудник) ИЛИ НЕ ЗначениеЗаполнено(Строка.Подразделение)
			ИЛИ НЕ ЗначениеЗаполнено(Строка.ВидРасчета) ИЛИ НЕ ЗначениеЗаполнено(Строка.ДатаНачала)
			ИЛИ Строка.ДатаОкончания < Строка.ДатаНачала Тогда
			ВызватьИсключение "Проверьте сотрудника, подразделение, вид расчета и даты начисления.";
		КонецЕсли;
		Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка
			И НачалоМесяца(Строка.ДатаНачала) <> НачалоМесяца(Строка.ДатаОкончания) Тогда
			ВызватьИсключение "Тариф и премия вводятся в пределах одного календарного месяца.";
		КонецЕсли;
		Начало = НачалоДня(Строка.ДатаНачала);
		Пока Начало <= Строка.ДатаОкончания Цикл
			Д = Набор.Добавить();
			Д.Сотрудник = Строка.Сотрудник;
			Д.Подразделение = Строка.Подразделение;
			Д.ВидРасчета = Строка.ВидРасчета;
			Д.ПериодДействияНачало = Начало;
			Д.ПериодДействияКонец = КонецДня(Мин(КонецМесяца(Начало), Строка.ДатаОкончания));
			Д.ПериодРегистрации = ?(ЗначениеЗаполнено(Строка.Регистрация), НачалоМесяца(Строка.Регистрация), Макс(НачалоМесяца(Док.Дата), НачалоМесяца(Начало)));
			Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
				Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
				Д.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
			ИначеЕсли Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
				Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Строка.ДатаНачала), -3);
				Д.БазовыйПериодКонец = НачалоМесяца(Строка.ДатаНачала) - 1;
			КонецЕсли;
			Начало = НачалоМесяца(ДобавитьМесяц(Начало, 1));
		КонецЦикла;
	КонецЦикла;
	Дополнение = Набор.ПолучитьДополнение();
	Для Каждого Строка Из Дополнение Цикл
		Д = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Д, Строка);
		Д.Сторно = Истина;
		Д.ПериодРегистрации = Строка.ПериодРегистрацииСторно;
		Д.ПериодДействияНачало = Строка.ПериодДействияНачалоСторно;
		Д.ПериодДействияКонец = Строка.ПериодДействияКонецСторно;
	КонецЦикла;
	// Явная запись необходима для получения фактического периода, графика и базы.
	Набор.Записать();
	Рассчитать(Изменения);
	Набор.Прочитать();
КонецПроцедуры

Процедура БлокироватьРасчеты() Экспорт
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция СтажВГодах(ДатаСтажа, НаДату) Экспорт
	Если НЕ ЗначениеЗаполнено(ДатаСтажа) ИЛИ ДатаСтажа > НаДату Тогда Возврат 0; КонецЕсли;
	Месяцев = (Год(НаДату) - Год(ДатаСтажа)) * 12 + Месяц(НаДату) - Месяц(ДатаСтажа);
	Если ДобавитьМесяц(ДатаСтажа, Месяцев) > НаДату Тогда Месяцев = Месяцев - 1; КонецЕсли;
	Возврат Месяцев / 12;
КонецФункции

Функция КлючЗаписи(Регистратор, НомерСтроки)
	Возврат Строка(Регистратор.УникальныйИдентификатор()) + ":" + Строка(НомерСтроки);
КонецФункции

Процедура ЗаписатьНаборы(Наборы, ТолькоЗапись = Истина)
	Для Каждого Пара Из Наборы Цикл
		Если ТолькоЗапись Тогда
			Пара.Значение.Записать(Истина, Истина);
		Иначе
			// Снимок сохраняет ключи и периоды: фактический период заново не перестраивается.
			Пара.Значение.Записать(Истина, Ложь, Ложь, Ложь);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура Рассчитать(Изменения) Экспорт
	// Повторный расчет результатов поддерживает ввод отклонений и размотку цепочки назад.
	// Таблица перерасчетов не создается. Снимок нужен для пакетной записи наборов без чтения в цикле.
	Область = ОбластьРасчета(Изменения);
	Если Область = Неопределено Тогда Возврат; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления ГДЕ Регистратор В (&Регистраторы) УПОРЯДОЧИТЬ ПО Регистратор, НомерСтроки");
	Запрос.УстановитьПараметр("Регистраторы", Область.Регистраторы);
	Запрос.УстановитьПараметр("НачалоПересчета", Область.Начало);
	Записи = Запрос.Выполнить().Выгрузить();
	Если Записи.Количество() = 0 Тогда Возврат; КонецЕсли;
	ЗащититьДанныеРасчета(Записи);
	Наборы = Новый Соответствие;
	Для Каждого Строка Из Записи Цикл
		Набор = Наборы.Получить(Строка.Регистратор);
		Если Набор = Неопределено Тогда
			Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(Строка.Регистратор);
			Наборы.Вставить(Строка.Регистратор, Набор);
		КонецЕсли;
		Д = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Д, Строка);
	КонецЦикла;
	Запрос.Текст =
	"ВЫБРАТЬ Регистратор, НомерСтроки,
	| ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК Часы,
	| ЕСТЬNULL(ДниФактическийПериодДействия, 0) КАК Дни,
	| ЕСТЬNULL(ДниПериодДействия, 0) КАК НормаДней
	|ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы) И ПериодДействияКонец >= &НачалоПересчета)";
	Графики = Запрос.Выполнить().Выгрузить();
	ДанныеГрафика = Новый Соответствие;
	Для Каждого Строка Из Графики Цикл ДанныеГрафика.Вставить(КлючЗаписи(Строка.Регистратор, Строка.НомерСтроки), Строка); КонецЦикла;
	Запрос.Текст =
	"ВЫБРАТЬ Р.Регистратор, Р.НомерСтроки, МАКСИМУМ(С.Период) КАК Период
	|ПОМЕСТИТЬ АктуальныеСтавки
	|ИЗ РегистрРасчета.Начисления КАК Р
	| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСотрудниках КАК С
	| ПО Р.Сотрудник = С.Сотрудник И Р.Подразделение = С.Подразделение
	| И С.Период <= НАЧАЛОПЕРИОДА(Р.ПериодДействияНачало, МЕСЯЦ)
	|ГДЕ Р.Регистратор В (&Регистраторы) И Р.ПериодДействияКонец >= &НачалоПересчета
	|СГРУППИРОВАТЬ ПО Р.Регистратор, Р.НомерСтроки;
	|ВЫБРАТЬ Р.Регистратор, Р.НомерСтроки, ЕСТЬNULL(С.Оклад, 0) КАК Ставка
	|ИЗ РегистрРасчета.Начисления КАК Р
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ АктуальныеСтавки КАК А ПО Р.Регистратор = А.Регистратор И Р.НомерСтроки = А.НомерСтроки
	| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСотрудниках КАК С
	| ПО Р.Сотрудник = С.Сотрудник И Р.Подразделение = С.Подразделение И А.Период = С.Период";
	СтавкиТаблица = Запрос.Выполнить().Выгрузить();
	Ставки = Новый Соответствие;
	Для Каждого Строка Из СтавкиТаблица Цикл Ставки.Вставить(КлючЗаписи(Строка.Регистратор, Строка.НомерСтроки), Строка.Ставка); КонецЦикла;
	Запрос.УстановитьПараметр("Работники", Записи.ВыгрузитьКолонку("Сотрудник"));
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Сотрудник, НачалоСтажа ИЗ Справочник.ФизическиеЛица ГДЕ Ссылка В (&Работники)";
	Сотрудники = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж";
	Шкала = Запрос.Выполнить().Выгрузить();
	Для Каждого Пара Из Наборы Цикл
		Для Каждого Д Из Пара.Значение Цикл
			Ключ = КлючЗаписи(Пара.Ключ, Пара.Значение.Индекс(Д) + 1);
			Если Область.Ключи.Получить(Ключ) = Неопределено Тогда Продолжить; КонецЕсли;
			График = ДанныеГрафика.Получить(Ключ);
			Д.Часы = 0; Д.Дни = 0;
			Если График <> Неопределено Тогда
				Д.Часы = График.Часы;
				Если НЕ Д.Сторно Тогда Д.НормаДней = График.НормаДней; КонецЕсли;
			КонецЕсли;
			Если Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф ИЛИ Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад Тогда
				Если НЕ Д.Сторно Тогда Д.Ставка = Ставки.Получить(Ключ); КонецЕсли;
				Д.Результат = Окр(Д.Ставка * Д.Часы, 2);
				Если График <> Неопределено Тогда Д.Дни = График.Дни; КонецЕсли;
				Если Д.Сторно Тогда Д.Результат = -Абс(Д.Результат); Д.Дни = -Абс(Д.Дни); Д.Часы = -Абс(Д.Часы); КонецЕсли;
			КонецЕсли;
			Работник = Сотрудники.Найти(Д.Сотрудник, "Сотрудник");
			Если Работник <> Неопределено Тогда Д.Стаж = СтажВГодах(Работник.НачалоСтажа, НачалоМесяца(Д.ПериодДействияНачало)); КонецЕсли;
			Д.Процент = 0;
			Для Каждого Порог Из Шкала Цикл
				Если Порог.Стаж <= Д.Стаж Тогда Д.Процент = Порог.Процент; КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ЗаписатьНаборы(Наборы, Ложь);
	Подразделения = Новый Массив; Подразделения.Добавить("Подразделение");
	Разрез = Новый Массив; Разрез.Добавить("Сотрудник");
	Запрос.УстановитьПараметр("Измерения", Подразделения);
	Запрос.УстановитьПараметр("Разрез", Разрез);
	Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.Премия);
	Запрос.Текст =
	"ВЫБРАТЬ Регистратор, НомерСтроки, СУММА(РезультатБаза) КАК База
	|ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрез, ВидРасчета = &Премия И Регистратор В (&Регистраторы) И ПериодДействияКонец >= &НачалоПересчета)
	|ГДЕ Сотрудник <> СотрудникРазрез
	|СГРУППИРОВАТЬ ПО Регистратор, НомерСтроки";
	БазаПремии = Запрос.Выполнить().Выгрузить();
	Для Каждого Пара Из Наборы Цикл
		Для Каждого Д Из Пара.Значение Цикл
			Если Д.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
			Если Область.Ключи.Получить(КлючЗаписи(Пара.Ключ, Пара.Значение.Индекс(Д) + 1)) = Неопределено Тогда Продолжить; КонецЕсли;
			СтрокиБазы = БазаПремии.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Пара.Ключ, Пара.Значение.Индекс(Д) + 1));
			База = ?(СтрокиБазы.Количество() = 0, 0, СтрокиБазы[0].База);
			График = ДанныеГрафика.Получить(КлючЗаписи(Пара.Ключ, Пара.Значение.Индекс(Д) + 1));
			Дни = ?(График = Неопределено, 0, График.Дни);
			Д.Результат = ?(Д.НормаДней = 0, 0, Окр(База * Д.Процент / 100 * Дни / Д.НормаДней, 2));
			Если Д.Сторно Тогда Д.Результат = -Абс(Д.Результат); КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ЗаписатьНаборы(Наборы);
	Измерения = Новый Массив; Измерения.Добавить("Сотрудник");
	Запрос.УстановитьПараметр("Измерения", Измерения);
	Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
	Запрос.Текст =
	"ВЫБРАТЬ Регистратор, НомерСтроки, СУММА(РезультатБаза) КАК База, СУММА(ДниБаза) КАК Дни
	|ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, , ВидРасчета = &Командировка И Регистратор В (&Регистраторы) И ПериодДействияКонец >= &НачалоПересчета И БазовыйПериодКонец = &КонецБазы)
	|СГРУППИРОВАТЬ ПО Регистратор, НомерСтроки";

	ПериодыБазы = Новый ТаблицаЗначений;
	ПериодыБазы.Колонки.Добавить("Конец", Новый ОписаниеТипов("Дата"));
	Для Каждого Пара Из Наборы Цикл
		Для Каждого Д Из Пара.Значение Цикл
			Если Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка
				И Область.Ключи.Получить(КлючЗаписи(Пара.Ключ, Пара.Значение.Индекс(Д) + 1)) <> Неопределено Тогда
				ПериодыБазы.Добавить().Конец = Д.БазовыйПериодКонец;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ПериодыБазы.Свернуть("Конец", "");
	ПериодыБазы.Сортировать("Конец");
	// Это этапы зависимых расчетов по различным базовым периодам, а не запрос по каждой строке.
	// Результаты предыдущего этапа должны быть записаны до получения следующей базы.
	Для Каждого Этап Из ПериодыБазы Цикл
		Запрос.УстановитьПараметр("КонецБазы", Этап.Конец);
		БазаКомандировки = Запрос.Выполнить().Выгрузить();
		ИзмененныеНаборы = Новый Соответствие;
		Для Каждого Пара Из Наборы Цикл
			Для Каждого Д Из Пара.Значение Цикл
				Если Д.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка
					ИЛИ Д.БазовыйПериодКонец <> Этап.Конец Тогда Продолжить; КонецЕсли;
				Ключ = КлючЗаписи(Пара.Ключ, Пара.Значение.Индекс(Д) + 1);
				Если Область.Ключи.Получить(Ключ) = Неопределено Тогда Продолжить; КонецЕсли;
				СтрокиБазы = БазаКомандировки.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Пара.Ключ, Пара.Значение.Индекс(Д) + 1));
				График = ДанныеГрафика.Получить(Ключ);
				Дни = ?(График = Неопределено, 0, График.Дни);
				Д.Результат = 0;
				Если СтрокиБазы.Количество() > 0 И СтрокиБазы[0].Дни <> 0 Тогда
					Д.Результат = Окр(СтрокиБазы[0].База / СтрокиБазы[0].Дни * Дни, 2);
				КонецЕсли;
				Если Д.Сторно Тогда Д.Результат = -Абс(Д.Результат); КонецЕсли;
				ИзмененныеНаборы.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
		КонецЦикла;
		ЗаписатьНаборы(ИзмененныеНаборы);
	КонецЦикла;
КонецПроцедуры

Функция Абс(Значение)
	Возврат ?(Значение < 0, -Значение, Значение);
КонецФункции

Функция ИзмененияРасчета(Док)
	Запрос = Новый Запрос("ВЫБРАТЬ Сотрудник, Подразделение, ПериодДействияНачало КАК ДатаНачала ИЗ РегистрРасчета.Начисления ГДЕ Регистратор = &Док");
	Запрос.УстановитьПараметр("Док", Док.Ссылка);
	Т = Запрос.Выполнить().Выгрузить();
	Для Каждого С Из Док.ОсновныеНачисления Цикл
		Новая = Т.Добавить(); Новая.Сотрудник = С.Сотрудник; Новая.Подразделение = С.Подразделение; Новая.ДатаНачала = С.ДатаНачала;
	КонецЦикла;
	Возврат Т;
КонецФункции

Функция ОбластьРасчета(Изменения)
	Если Изменения.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;
	Изменения.Сортировать("ДатаНачала");
	Начало = НачалоМесяца(Изменения[0].ДатаНачала);
	Работники = Изменения.ВыгрузитьКолонку("Сотрудник");
	Подразделения = Изменения.ВыгрузитьКолонку("Подразделение");
	Запрос = Новый Запрос("ВЫБРАТЬ Регистратор, НомерСтроки, Сотрудник, Подразделение ИЗ РегистрРасчета.Начисления ГДЕ ПериодДействияКонец >= &Начало");
	Запрос.УстановитьПараметр("Начало", Начало);
	Связи = Запрос.Выполнить().Выгрузить();
	Ключи = Новый Соответствие; Регистраторы = Новый Массив;
	Изменено = Истина;
	// Замыкание зависимости: база руководителя связывает подразделение,
	// а база командировки связывает все совместительства сотрудника.
	Пока Изменено Цикл
		Изменено = Ложь;
		Для Каждого С Из Связи Цикл
			Если Работники.Найти(С.Сотрудник) = Неопределено И Подразделения.Найти(С.Подразделение) = Неопределено Тогда Продолжить; КонецЕсли;
			Если Работники.Найти(С.Сотрудник) = Неопределено Тогда Работники.Добавить(С.Сотрудник); Изменено = Истина; КонецЕсли;
			Если Подразделения.Найти(С.Подразделение) = Неопределено Тогда Подразделения.Добавить(С.Подразделение); Изменено = Истина; КонецЕсли;
			Если Регистраторы.Найти(С.Регистратор) = Неопределено Тогда Регистраторы.Добавить(С.Регистратор); КонецЕсли;
			Ключи.Вставить(КлючЗаписи(С.Регистратор, С.НомерСтроки), Истина);
		КонецЦикла;
	КонецЦикла;
	Если Регистраторы.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;
	Возврат Новый Структура("Регистраторы,Ключи,Начало", Регистраторы, Ключи, Начало);
КонецФункции

Процедура СнятьПроведение(Док) Экспорт
	БлокироватьРасчеты();
	Изменения = ИзмененияРасчета(Док);
	Док.Движения.Начисления.Очистить();
	Док.Движения.Начисления.Записать();
	Рассчитать(Изменения);
КонецПроцедуры

Процедура ЗащититьДанныеРасчета(Записи)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.ГрафикиРаботы");
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент.ИсточникДанных = Записи;
	Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
	Элемент = Блокировка.Добавить("РегистрСведений.СведенияОСотрудниках");
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент.ИсточникДанных = Записи;
	Элемент.ИспользоватьИзИсточникаДанных("Сотрудник", "Сотрудник");
	Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
	Элемент = Блокировка.Добавить("РегистрСведений.ШкалаПремий");
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент = Блокировка.Добавить("Справочник.ФизическиеЛица");
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент.ИсточникДанных = Записи;
	Элемент.ИспользоватьИзИсточникаДанных("Ссылка", "Сотрудник");
	Блокировка.Заблокировать();
КонецПроцедуры
