// Общие алгоритмы проведения. Все ответственные чтения выполняются под управляемыми блокировками.
Функция СуммаСтроки(Строка) Экспорт
	Если Строка.Сумма = 0 Тогда
		Возврат Окр(Строка.Количество * Строка.Цена, 2);
	КонецЕсли;
	Возврат Строка.Сумма;
КонецФункции

Процедура ПроверитьСтроку(Строка) Экспорт
	Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) ИЛИ Строка.Количество <= 0 Тогда
		ВызватьИсключение "Укажите номенклатуру и положительное количество в строке " + Строка.НомерСтроки;
	КонецЕсли;
КонецПроцедуры

Функция Потребности() Экспорт
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Т.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Т.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
	Т.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Т.Колонки.Добавить("Блок", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Возврат Т;
КонецФункции

Функция ОстаткиОУ(Док, Потребность) Экспорт
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = Потребность;
	Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
	Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	Элемент.ИспользоватьИзИсточникаДанных("Свойство", "Свойство");
	Блокировка.Заблокировать();
	// Удаляем прежние движения до ответственного чтения, в том числе при изменении даты документа.
	Док.Движения.ОстаткиНоменклатуры.Записать();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
	| КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость,
	| Партия.Дата КАК ДатаПартии
	|ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,
	| Подразделение В (&Подразделения) И Номенклатура В (&Товары))");
	Запрос.УстановитьПараметр("Момент", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Товары", Потребность.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Подразделения", Потребность.ВыгрузитьКолонку("Подразделение"));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СписатьОУ(Док, Остатки, Подразделение, Товар, Свойство, Количество, Метод) Экспорт
	Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
	Партии = Остатки.НайтиСтроки(Отбор);
	Всего = 0;
	СтоимостьБазы = 0;
	Для Каждого Партия Из Партии Цикл
		Всего = Всего + Партия.Количество;
		СтоимостьБазы = СтоимостьБазы + Партия.Стоимость;
	КонецЦикла;
	Если Количество > Всего + 0.00001 Тогда
		ВызватьИсключение СтрШаблон("Недостаточно %1 (%2) в подразделении %3. Требуется %4, доступно %5.", Товар, Свойство, Подразделение, Количество, Всего);
	КонецЕсли;
	Если Количество <= 0 Тогда Возврат 0; КонецЕсли;
	Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
		Остатки.Сортировать("ДатаПартии Убыв, Партия Убыв");
	Иначе
		Остатки.Сортировать("ДатаПартии Возр, Партия Возр");
	КонецЕсли;
	Партии = Остатки.НайтиСтроки(Отбор);
	Осталось = Количество;
	Стоимость = 0;
	ОстатокБазы = Всего;
	КорректируемаяПартия = Неопределено;
	КорректируемоеДвижение = Неопределено;
	Для Каждого Партия Из Партии Цикл
		Если Осталось <= 0 Тогда Прервать; КонецЕсли;
		Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
		Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
			Списано = Мин(Партия.Количество, Осталось, Окр(Осталось * Партия.Количество / ОстатокБазы, 3));
			Если Партия.Количество = ОстатокБазы Тогда Списано = Осталось; КонецЕсли;
		Иначе
			Списано = Мин(Партия.Количество, Осталось);
		КонецЕсли;
		ОстатокБазы = ОстатокБазы - Партия.Количество;
		Если Списано = 0 Тогда Продолжить; КонецЕсли;
		Сумма = ?(Списано = Партия.Количество, Партия.Стоимость, Окр(Партия.Стоимость * Списано / Партия.Количество, 2));
		Движение = Док.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
		Движение.Период = Док.Дата;
		Движение.Подразделение = Подразделение;
		Движение.Номенклатура = Товар;
		Движение.Свойство = Свойство;
		Движение.Партия = Партия.Партия;
		Движение.Количество = Списано;
		Движение.Стоимость = Сумма;
		Партия.Количество = Партия.Количество - Списано;
		Партия.Стоимость = Партия.Стоимость - Сумма;
		Если Партия.Количество > 0 И Партия.Стоимость > 0 Тогда КорректируемаяПартия = Партия; КорректируемоеДвижение = Движение; КонецЕсли;
		Стоимость = Стоимость + Сумма;
		Осталось = Осталось - Списано;
	КонецЦикла;
	Если Метод = Перечисления.УчетнаяПолитика.Средняя И КорректируемаяПартия <> Неопределено Тогда
		Разница = Окр(СтоимостьБазы * Количество / Всего, 2) - Стоимость;
		КорректируемоеДвижение.Стоимость = КорректируемоеДвижение.Стоимость + Разница;
		КорректируемаяПартия.Стоимость = КорректируемаяПартия.Стоимость - Разница;
		Стоимость = Стоимость + Разница;
	КонецЕсли;
	Возврат Стоимость;
КонецФункции

Процедура ПриходОУ(Док, Подразделение, Товар, Свойство, Количество, Стоимость) Экспорт
	Движение = Док.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
	Движение.Период = Док.Дата;
	Движение.Подразделение = Подразделение;
	Движение.Номенклатура = Товар;
	Движение.Свойство = Свойство;
	Движение.Партия = Док.Ссылка;
	Движение.Количество = Количество;
	Движение.Стоимость = Стоимость;
КонецПроцедуры

Процедура Приход(Док) Экспорт
	НастроитьСчета();
	Док.Движения.ОстаткиНоменклатуры.Очистить();
	Док.Движения.Хозрасчетный.Очистить();
	Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Док.Движения.Хозрасчетный.Записывать = Истина;
	Для Каждого Строка Из Док.СписокНоменклатуры Цикл
		ПроверитьСтроку(Строка);
		Сумма = СуммаСтроки(Строка);
		Если Сумма < 0 Тогда ВызватьИсключение "Отрицательная сумма закупки."; КонецЕсли;
		Если ЗначениеЗаполнено(Док.Подразделение) Тогда
			ПриходОУ(Док, Док.Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Сумма);
		КонецЕсли;
		Если ЗначениеЗаполнено(Док.Склад) Тогда
			Д = Док.Движения.Хозрасчетный.Добавить();
			Д.Период = Док.Дата;
			Д.СчетДт = ПланыСчетов.Управленческий.Товары;
			Д.СчетКт = ПланыСчетов.Управленческий.Поставщики;
			Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.Номенклатура;
			Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Док.Склад;
			Д.КоличествоДт = Строка.Количество;
			Д.Сумма = Сумма;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПродажаОУ(Док) Экспорт
	Требования = Потребности();
	Для Каждого Строка Из Док.СписокНоменклатуры Цикл
		ПроверитьСтроку(Строка);
		Если НЕ ЗначениеЗаполнено(Строка.Подразделение) Тогда Продолжить; КонецЕсли;
		Новая = Требования.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Строка);
	КонецЦикла;
	Если Требования.Количество() = 0 Тогда Возврат; КонецЕсли;
	Остатки = ОстаткиОУ(Док, Требования);
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.УчетныеПолитики");
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент.ИсточникДанных = Требования;
	Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
	Блокировка.Заблокировать();
	Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))");
	Запрос.УстановитьПараметр("Дата", Док.Дата);
	Запрос.УстановитьПараметр("Подразделения", Требования.ВыгрузитьКолонку("Подразделение"));
	Политики = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Док.СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Подразделение) Тогда Продолжить; КонецЕсли;
		Политика = Политики.Найти(Строка.Подразделение, "Подразделение");
		Если Политика = Неопределено Тогда
			ВызватьИсключение "Не задана учетная политика подразделения " + Строка.Подразделение;
		КонецЕсли;
		Стоимость = СписатьОУ(Док, Остатки, Строка.Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Политика.Метод);
		Д = Док.Движения.ПродажиОУ.Добавить();
		Д.Период = Док.Дата;
		Д.Номенклатура = Строка.Номенклатура;
		Д.Количество = Строка.Количество;
		Д.Себестоимость = Стоимость;
		Д.Выручка = СуммаСтроки(Строка);
	КонецЦикла;
КонецПроцедуры

Процедура Сборка(Док) Экспорт
	Если НЕ ЗначениеЗаполнено(Док.ПодразделениеИсточник) ИЛИ НЕ ЗначениеЗаполнено(Док.ПодразделениеПолучатель) Тогда
		ВызватьИсключение "Укажите подразделения списания и поступления.";
	КонецЕсли;
	Док.Движения.ОстаткиНоменклатуры.Очистить();
	Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Блоки = Док.Блоки.Выгрузить();
	Если Блоки.Количество() = 0 Тогда ВызватьИсключение "Не указаны собираемые блоки."; КонецЕсли;
	Для Каждого Строка Из Док.Блоки Цикл ПроверитьСтроку(Строка); КонецЦикла;
	Блоки.Свернуть("Номенклатура", "Количество");
	Блоки.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.Спецификации");
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Элемент.ИсточникДанных = Блоки;
	Элемент.ИспользоватьИзИсточникаДанных("Блок", "Номенклатура");
	Блокировка.Заблокировать();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Блок, МАКСИМУМ(Период) КАК Период ПОМЕСТИТЬ Версии
	|ИЗ РегистрСведений.Спецификации
	|ГДЕ Блок В (&Блоки) И Период <= &Дата СГРУППИРОВАТЬ ПО Блок;
	|ВЫБРАТЬ С.Блок, С.Деталь КАК Номенклатура, С.Свойство, С.Количество
	|ИЗ РегистрСведений.Спецификации КАК С
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Версии КАК Версия ПО С.Блок = Версия.Блок И С.Период = Версия.Период");
	Запрос.УстановитьПараметр("Блоки", Блоки.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Дата", Док.Дата);
	Состав = Запрос.Выполнить().Выгрузить();
	Требования = Потребности();
	Для Каждого Блок Из Блоки Цикл
		Детали = Состав.НайтиСтроки(Новый Структура("Блок", Блок.Номенклатура));
		Если Детали.Количество() = 0 Тогда ВызватьИсключение "Нет спецификации блока " + Блок.Номенклатура; КонецЕсли;
		Для Каждого Деталь Из Детали Цикл
			Если Деталь.Количество <= 0 Тогда ВызватьИсключение "В спецификации количество должно быть положительным."; КонецЕсли;
			Новая = Требования.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, Деталь);
			Новая.Количество = Деталь.Количество * Блок.Количество;
			Новая.Подразделение = Док.ПодразделениеИсточник;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Строка Из Док.ДополнительныеДетали Цикл
		ПроверитьСтроку(Строка);
		Новая = Требования.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Строка);
		Новая.Подразделение = Док.ПодразделениеИсточник;
	КонецЦикла;
	Остатки = ОстаткиОУ(Док, Требования);
	Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
	ДопСтоимость = 0;
	Для Каждого Строка Из Требования Цикл
		Стоимость = СписатьОУ(Док, Остатки, Строка.Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Перечисления.УчетнаяПолитика.Средняя);
		Если ЗначениеЗаполнено(Строка.Блок) Тогда
			Блок = Блоки.Найти(Строка.Блок, "Номенклатура");
			Блок.Стоимость = Блок.Стоимость + Стоимость;
		Иначе
			ДопСтоимость = ДопСтоимость + Стоимость;
		КонецЕсли;
	КонецЦикла;
	ОсталосьБлоков = Блоки.Итог("Количество");
	Для Каждого Блок Из Блоки Цикл
		Доля = ?(Блок.Количество = ОсталосьБлоков, ДопСтоимость, Окр(ДопСтоимость * Блок.Количество / ОсталосьБлоков, 2));
		ДопСтоимость = ДопСтоимость - Доля;
		ОсталосьБлоков = ОсталосьБлоков - Блок.Количество;
		ПриходОУ(Док, Док.ПодразделениеПолучатель, Блок.Номенклатура, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), Блок.Количество, Блок.Стоимость + Доля);
	КонецЦикла;
КонецПроцедуры

// Граф аналогов читается одним запросом; транзитивное симметричное замыкание строится в памяти.
Функция КандидатыБУ(Док) Экспорт
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.Аналоги");
	Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
	Блокировка.Заблокировать();
	Запрос = Новый Запрос("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
	Связи = Запрос.Выполнить().Выгрузить();
	Товары = Новый Массив;
	Для Каждого Строка Из Док.СписокНоменклатуры Цикл
		Если Товары.Найти(Строка.Номенклатура) = Неопределено Тогда Товары.Добавить(Строка.Номенклатура); КонецЕсли;
	КонецЦикла;
	Продолжать = Истина;
	Пока Продолжать Цикл
		Продолжать = Ложь;
		Для Каждого Связь Из Связи Цикл
			Если Товары.Найти(Связь.Товар) <> Неопределено И Товары.Найти(Связь.Аналог) = Неопределено Тогда
				Товары.Добавить(Связь.Аналог); Продолжать = Истина;
			КонецЕсли;
			Если Товары.Найти(Связь.Аналог) <> Неопределено И Товары.Найти(Связь.Товар) = Неопределено Тогда
				Товары.Добавить(Связь.Товар); Продолжать = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Товары,Связи", Товары, Связи);
КонецФункции

Функция ГруппаАналогов(Товар, Связи)
	Группа = Новый Массив;
	Группа.Добавить(Товар);
	Продолжать = Истина;
	Пока Продолжать Цикл
		Продолжать = Ложь;
		Для Каждого Связь Из Связи Цикл
			Если Группа.Найти(Связь.Товар) <> Неопределено И Группа.Найти(Связь.Аналог) = Неопределено Тогда
				Группа.Добавить(Связь.Аналог); Продолжать = Истина;
			КонецЕсли;
			Если Группа.Найти(Связь.Аналог) <> Неопределено И Группа.Найти(Связь.Товар) = Неопределено Тогда
				Группа.Добавить(Связь.Товар); Продолжать = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Группа;
КонецФункции

Процедура ПродажаБУ(Док) Экспорт
	Если НЕ ЗначениеЗаполнено(Док.Склад) Тогда Возврат; КонецЕсли;
	НастроитьСчета();
	Граф = КандидатыБУ(Док);
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрБухгалтерии.Хозрасчетный");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	// Стоимость определяется по всем складам: склад сознательно не сужает эту блокировку.
	Элемент.УстановитьЗначение("Счет", ПланыСчетов.Управленческий.Товары);
	ТоварыБлокировки = Новый ТаблицаЗначений;
	ТоварыБлокировки.Колонки.Добавить("Номенклатура");
	Для Каждого ТоварБлокировки Из Граф.Товары Цикл ТоварыБлокировки.Добавить().Номенклатура = ТоварБлокировки; КонецЦикла;
	Элемент.ИсточникДанных = ТоварыБлокировки;
	Элемент.ИспользоватьИзИсточникаДанных("Субконто1", "Номенклатура");
	Блокировка.Заблокировать();
	Док.Движения.Хозрасчетный.Записать();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Субконто1 КАК Номенклатура, Субконто2 КАК Склад, КоличествоОстаток КАК Количество,
	| 0 КАК Стоимость
	|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, &ВидыСубконто, Субконто1 В (&Товары))");
	Запрос.УстановитьПараметр("Момент", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
	Запрос.УстановитьПараметр("Товары", Граф.Товары);
	ВидыСубконто = Новый Массив; ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
	ВидНоменклатуры = Новый Массив; ВидНоменклатуры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Остатки = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ Субконто1 КАК Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Стоимость ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, &ВидНоменклатуры, Субконто1 В (&Товары))";
	Итоги = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Номенклатура, Артикул ИЗ Справочник.Номенклатура ГДЕ Ссылка В (&Товары) УПОРЯДОЧИТЬ ПО Артикул, Ссылка";
	Порядок = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Док.СписокНоменклатуры Цикл
		ПроверитьСтроку(Строка);
		Группа = ГруппаАналогов(Строка.Номенклатура, Граф.Связи);
		Кандидаты = Новый Массив;
		Кандидаты.Добавить(Строка.Номенклатура);
		Для Каждого Товар Из Порядок Цикл
			Если Товар.Номенклатура <> Строка.Номенклатура И Группа.Найти(Товар.Номенклатура) <> Неопределено Тогда Кандидаты.Добавить(Товар.Номенклатура); КонецЕсли;
		КонецЦикла;
		Осталось = Строка.Количество;
		ОсталосьВыручки = СуммаСтроки(Строка);
		Для Каждого Товар Из Кандидаты Цикл
			Если Осталось <= 0 Тогда Прервать; КонецЕсли;
			Локальные = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Товар, Док.Склад));
			Если Локальные.Количество() = 0 Тогда Продолжить; КонецЕсли;
			Локальный = Локальные[0];
			Если Локальный.Количество <= 0 Тогда Продолжить; КонецЕсли;
			Всего = Итоги.Найти(Товар, "Номенклатура");
			Если Всего = Неопределено ИЛИ Всего.Количество <= 0 Тогда Продолжить; КонецЕсли;
			Количество = Мин(Осталось, Локальный.Количество);
			Стоимость = ?(Количество = Всего.Количество, Всего.Стоимость, Окр(Всего.Стоимость * Количество / Всего.Количество, 2));
			Выручка = ?(Количество = Осталось, ОсталосьВыручки, Окр(ОсталосьВыручки * Количество / Осталось, 2));
			Д = Док.Движения.Хозрасчетный.Добавить();
			Д.Период = Док.Дата;
			Д.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
			Д.СчетКт = ПланыСчетов.Управленческий.Товары;
			Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.ЗаказанныйТовар] = Строка.Номенклатура;
			Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.ПроданныйТовар] = Товар;
			Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Товар;
			Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Док.Склад;
			Д.КоличествоДт = Количество;
			Д.КоличествоКт = Количество;
			Д.Сумма = Стоимость;
			Д = Док.Движения.Хозрасчетный.Добавить();
			Д.Период = Док.Дата;
			Д.СчетДт = ПланыСчетов.Управленческий.Покупатели;
			Д.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
			Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.ЗаказанныйТовар] = Строка.Номенклатура;
			Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.ПроданныйТовар] = Товар;
			Д.Сумма = Выручка;
			Осталось = Осталось - Количество;
			ОсталосьВыручки = ОсталосьВыручки - Выручка;
			Локальный.Количество = Локальный.Количество - Количество;
			Всего.Количество = Всего.Количество - Количество;
			Всего.Стоимость = Всего.Стоимость - Стоимость;
		КонецЦикла;
		Если Осталось > 0 Тогда
			ВызватьИсключение СтрШаблон("На складе %1 недостаточно товара %2 и всех его аналогов. Не хватает %3.", Док.Склад, Строка.Номенклатура, Осталось);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура Продажа(Док) Экспорт
	Док.Движения.ОстаткиНоменклатуры.Очистить();
	Док.Движения.ПродажиОУ.Очистить();
	Док.Движения.Хозрасчетный.Очистить();
	Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Док.Движения.ПродажиОУ.Записывать = Истина;
	Док.Движения.Хозрасчетный.Записывать = Истина;
	// Один и тот же порядок ресурсов используется в обработчиках.
	ПродажаОУ(Док);
	ПродажаБУ(Док);
КонецПроцедуры

Функция ПечатнаяФорма(Данные, Вид, Начало, Конец, Подразделение = Неопределено) Экспорт
	Т = Новый ТабличныйДокумент;
	Т.АвтоМасштаб = Истина;
	Если Вид = "ВедомостьОУ" Тогда
		Заголовки = СтрРазделить("Характеристики;Товар;Нач. ост.;Приход;Расход;Кон. ост.", ";");
	ИначеЕсли Вид = "ПродажиБУ" Тогда
		Заголовки = СтрРазделить("Номенклатура;Продано;Кол-во;Себест-сть;Продажа;Прибыль", ";");
	ИначеЕсли Вид = "Премии" Тогда
		Заголовки = СтрРазделить("Сотрудник;Трудовой стаж, лет;% премии;Сумма премии", ";");
	Иначе
		Заголовки = СтрРазделить("Номенклатура;Кол-во;Себест-сть;Продажа;Прибыль", ";");
	КонецЕсли;
	Колонок = Заголовки.Количество();
	Т.Область(1, 1, 1, Колонок).Объединить();
	Т.Область(1, 1).Текст = ?(Вид = "ВедомостьОУ", "Ведомость по подразделению " + Строка(Подразделение), ?(Вид = "Премии", "Премии", "Продажи"));
	Т.Область(1, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);
	Т.Область(2, 1, 2, Колонок).Объединить();
	Т.Область(2, 1).Текст = ?(Вид = "Премии", "Месяц: " + Формат(Начало, "ДФ='MMMM yyyy'"), "За период с " + Формат(Начало, "ДФ=dd.MM.yyyy") + " по " + Формат(Конец, "ДФ=dd.MM.yyyy"));
	Для Индекс = 0 По Колонок - 1 Цикл
		Т.Область(4, Индекс + 1).Текст = Заголовки[Индекс];
		Т.Область(4, Индекс + 1).Шрифт = Новый Шрифт("Arial", 10, Истина);
		Т.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = ?(Индекс = 0 И Вид = "ПродажиБУ", 40, ?(Индекс < 2, 30, 18));
	КонецЦикла;
	Номер = 5;
	ПредыдущаяГруппа = Неопределено;
	Для Каждого С Из Данные Цикл
		Если Вид = "ВедомостьОУ" Тогда
			Если ПредыдущаяГруппа <> С.Характеристики Тогда
				Т.Область(Номер, 1).Текст = С.Характеристики;
				Т.Область(Номер, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);
				ПредыдущаяГруппа = С.Характеристики;
				Номер = Номер + 1;
			КонецЕсли;
			Т.Область(Номер, 2).Текст = Строка(С.Номенклатура);
			Т.Область(Номер, 3).Текст = Формат(С.НачальноеКоличество, "ЧГ=0");
			Т.Область(Номер, 4).Текст = Формат(С.ПриходКоличество, "ЧГ=0");
			Т.Область(Номер, 5).Текст = Формат(С.РасходКоличество, "ЧГ=0");
			Т.Область(Номер, 6).Текст = Формат(С.КонечноеКоличество, "ЧГ=0");
			Номер = Номер + 1;
			Т.Область(Номер, 3).Текст = Формат(С.НачальныйОстаток, "ЧДЦ=2");
			Т.Область(Номер, 4).Текст = Формат(С.Приход, "ЧДЦ=2");
			Т.Область(Номер, 5).Текст = Формат(С.Расход, "ЧДЦ=2");
			Т.Область(Номер, 6).Текст = Формат(С.КонечныйОстаток, "ЧДЦ=2");
		ИначеЕсли Вид = "Премии" Тогда
			Т.Область(Номер, 1).Текст = Строка(С.Сотрудник);
			Т.Область(Номер, 2).Текст = Формат(С.Стаж, "ЧДЦ=2");
			Т.Область(Номер, 3).Текст = Формат(С.Процент, "ЧДЦ=2");
			Т.Область(Номер, 4).Текст = Формат(С.СуммаПремии, "ЧДЦ=2");
		Иначе
			Смещение = ?(Вид = "ПродажиБУ", 1, 0);
			Если Вид = "ПродажиБУ" Тогда
				Если ПредыдущаяГруппа <> С.Номенклатура Тогда
					Группа = Данные.Скопировать(Новый Структура("Номенклатура", С.Номенклатура));
					Т.Область(Номер, 1).Текст = Строка(С.Номенклатура);
					Т.Область(Номер, 3).СодержитЗначение = Истина;
					Т.Область(Номер, 3).Значение = Группа.Итог("Количество");
					Т.Область(Номер, 4).Текст = Формат(Группа.Итог("Себестоимость"), "ЧДЦ=2");
					Т.Область(Номер, 5).Текст = Формат(Группа.Итог("Выручка"), "ЧДЦ=2");
					Т.Область(Номер, 6).Текст = Формат(Группа.Итог("Прибыль"), "ЧДЦ=2");
					Т.Область(Номер, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);
					ПредыдущаяГруппа = С.Номенклатура;
					Номер = Номер + 1;
				КонецЕсли;
				Т.Область(Номер, 2).Текст = Строка(С.Продано);
			Иначе
				Т.Область(Номер, 1).Текст = Строка(С.Номенклатура);
			КонецЕсли;
			Т.Область(Номер, 2 + Смещение).СодержитЗначение = Истина;
			Т.Область(Номер, 2 + Смещение).Значение = С.Количество;
			Т.Область(Номер, 3 + Смещение).Текст = Формат(С.Себестоимость, "ЧДЦ=2");
			Т.Область(Номер, 4 + Смещение).Текст = Формат(С.Выручка, "ЧДЦ=2");
			Т.Область(Номер, 5 + Смещение).Текст = Формат(С.Прибыль, "ЧДЦ=2");
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;
	Если Вид <> "ВедомостьОУ" Тогда Т.Область(Номер + 1, 1).Текст = "ИТОГО:"; КонецЕсли;
	Если Вид = "Премии" Тогда
		Т.Область(Номер + 1, 4).Текст = Формат(Данные.Итог("СуммаПремии"), "ЧДЦ=2");
	ИначеЕсли Вид <> "ВедомостьОУ" Тогда
		Смещение = ?(Вид = "ПродажиБУ", 1, 0);
		Т.Область(Номер + 1, 2 + Смещение).СодержитЗначение = Истина;
		Т.Область(Номер + 1, 2 + Смещение).Значение = Данные.Итог("Количество");
		Т.Область(Номер + 1, 3 + Смещение).Текст = Формат(Данные.Итог("Себестоимость"), "ЧДЦ=2");
		Т.Область(Номер + 1, 4 + Смещение).Текст = Формат(Данные.Итог("Выручка"), "ЧДЦ=2");
		Т.Область(Номер + 1, 5 + Смещение).Текст = Формат(Данные.Итог("Прибыль"), "ЧДЦ=2");
	КонецЕсли;
	Т.Область(1, 1, Т.ВысотаТаблицы, Колонок).ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	Возврат Т;
КонецФункции

Процедура НастроитьСчета() Экспорт
	Счет = ПланыСчетов.Управленческий.Товары.ПолучитьОбъект();
	Если НЕ Счет.Количественный ИЛИ Счет.ВидыСубконто.Количество() <> 2 Тогда
		Счет.Количественный = Истина; Счет.ВидыСубконто.Очистить();
		Субконто = Счет.ВидыСубконто.Добавить();
		Субконто.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
		Субконто.ТолькоОбороты = Ложь; Субконто.Суммовой = Истина; Субконто.КоличественныйСубконто = Истина;
		Субконто = Счет.ВидыСубконто.Добавить();
		Субконто.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Склады;
		Субконто.ТолькоОбороты = Ложь; Субконто.Суммовой = Ложь; Субконто.КоличественныйСубконто = Истина;
		Счет.Записать();
	КонецЕсли;
	Счет = ПланыСчетов.Управленческий.ПрибылиУбытки.ПолучитьОбъект();
	Если НЕ Счет.Количественный ИЛИ Счет.ВидыСубконто.Количество() <> 2 Тогда
		Счет.Количественный = Истина;
		Счет.ВидыСубконто.Очистить();
		Субконто = Счет.ВидыСубконто.Добавить();
		Субконто.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЗаказанныйТовар;
		Субконто.ТолькоОбороты = Истина; Субконто.Суммовой = Истина; Субконто.КоличественныйСубконто = Истина;
		Субконто = Счет.ВидыСубконто.Добавить();
		Субконто.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ПроданныйТовар;
		Субконто.ТолькоОбороты = Истина; Субконто.Суммовой = Истина; Субконто.КоличественныйСубконто = Истина;
		Счет.Записать();
	КонецЕсли;
КонецПроцедуры
