&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПерестроитьПоля();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ПерестроитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт
	СменитьМенеджераНаСервере();
КонецПроцедуры

&НаСервере
Процедура СменитьМенеджераНаСервере()
	СохранитьЗначенияПолей();
	ПерестроитьПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьЗначенияПолей()
	Для Каждого Поле Из СписокПолей Цикл
		Найденные = Объект.Сведения.НайтиСтроки(Новый Структура("ВидСведений", Поле.ВидСведений));
		Если Найденные.Количество() = 0 Тогда
			СтрокаСведений = Объект.Сведения.Добавить();
			СтрокаСведений.ВидСведений = Поле.ВидСведений;
		Иначе
			СтрокаСведений = Найденные[0];
		КонецЕсли;
		СтрокаСведений.Значение = ЭтаФорма[Поле.Имя];
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПерестроитьПоля()
	Удаляемые = Новый Массив;
	Для Каждого Поле Из СписокПолей Цикл
		Элемент = Элементы.Найти(Поле.Имя);
		Если Элемент <> Неопределено Тогда Элементы.Удалить(Элемент); КонецЕсли;
		Удаляемые.Добавить(Поле.Имя);
	КонецЦикла;
	СписокПолей.Очистить();
	Если Удаляемые.Количество() > 0 Тогда ИзменитьРеквизиты(Новый Массив, Удаляемые); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ВидСведений ПОМЕСТИТЬ ВидыСведений
	|ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения
	|ГДЕ Ссылка = &Менеджер;
	|ВЫБРАТЬ ВидСведений, ВидСведений.Наименование КАК Заголовок, ВидСведений.ТипЗначения КАК ТипЗначения
	|ИЗ ВидыСведений");
	Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
	Виды = Запрос.Выполнить().Выгрузить();
	Добавляемые = Новый Массив;
	Для Каждого Вид Из Виды Цикл
		Имя = "ДопПоле" + СтрЗаменить(Строка(Вид.ВидСведений.УникальныйИдентификатор()), "-", "");
		Добавляемые.Добавить(Новый РеквизитФормы(Имя, Вид.ТипЗначения, , Вид.Заголовок));
		Поле = СписокПолей.Добавить();
		Поле.Имя = Имя;
		Поле.ВидСведений = Вид.ВидСведений;
	КонецЦикла;
	Если Добавляемые.Количество() > 0 Тогда ИзменитьРеквизиты(Добавляемые); КонецЕсли;
	Для Каждого Вид Из Виды Цикл
		Имя = "ДопПоле" + СтрЗаменить(Строка(Вид.ВидСведений.УникальныйИдентификатор()), "-", "");
		Элемент = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = Имя;
		Элемент.Заголовок = Вид.Заголовок;
		Если Вид.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияХарактеристик")) Тогда
			НастройкиВыбораПоля = Новый Массив;
			НастройкиВыбораПоля.Добавить(Новый ПараметрВыбора("Отбор.Владелец", Вид.ВидСведений));
			Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(НастройкиВыбораПоля);
		КонецЕсли;
		Элемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПолеПриИзменении");
		Найденные = Объект.Сведения.НайтиСтроки(Новый Структура("ВидСведений", Вид.ВидСведений));
		Если Найденные.Количество() > 0 Тогда ЭтаФорма[Имя] = Найденные[0].Значение; КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПолеПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	СохранитьЗначенияПолей();
	ТекущийОбъект.Сведения.Очистить();
	Для Каждого СтрокаСведений Из Объект.Сведения Цикл
		ЗаполнитьЗначенияСвойств(ТекущийОбъект.Сведения.Добавить(), СтрокаСведений);
	КонецЦикла;
КонецПроцедуры
